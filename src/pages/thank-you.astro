---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thank you | Decisive Finance"
  description="We received your request. Check your inbox for next steps."
  noindex={true}
>
  <section class="hero">
    <div class="hero-inner">
      <span class="eyebrow">Confirmation</span>
      <h1>Got it. Check your inbox.</h1>
      <p class="hero-subhead">
        We&rsquo;ll be in touch. In the meantime, the field notes are the shortest path to understanding how we work.
      </p>
      <div class="hero-cta-row">
        <a href="/perspectives" class="btn btn-primary">Read the field notes</a>
        <a href="/" class="btn btn-secondary">Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
