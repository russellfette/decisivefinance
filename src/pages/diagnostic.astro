---
import BaseLayout from '../layouts/BaseLayout.astro';

const CALENDLY = 'https://calendly.com/russell-decisive/30min';

const title = 'The Decision Diagnostic: 14 days, guaranteed | Decisive Finance';
const description =
  "Revenue's up. Profit isn't. In 14 days we name what your money is actually doing, in dollars. Guaranteed 3x the fee in owner-accepted value, or free.";

const finds = [
  {
    heading: 'Which products, customers, and jobs actually make money',
    body: 'Full allocation, not the aggregate P&L. The account everyone protects is often the one the rest of the business is quietly funding, and the number ends the debate.',
  },
  {
    heading: 'Where the recoverable value sits',
    body: 'Recoverable cash, recoverable margin, and avoided cost, each in dollars, each with a named path to capture it. Not a hunch. A number you can act on.',
  },
  {
    heading: 'What to do first',
    body: 'The readout ends with the first three moves, ranked by dollars and speed. You leave with the read whether or not we ever work together again.',
  },
];

const bands = [
  ['$5M to $8M revenue', '$10,000'],
  ['$8M to $25M revenue', '$15,000'],
  ['$25M to $50M revenue', '$20,000'],
];
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="hero-inner">
      <span class="eyebrow">The Decision Diagnostic &middot; Find &middot; 14 days</span>
      <h1>
        <span class="h1-line">Your books tell you what happened.</span>
        <span class="h1-line h1-line-accent">They can&rsquo;t tell you what to do next.</span>
      </h1>
      <p class="hero-subhead">
        Revenue&rsquo;s up. Profit isn&rsquo;t. And your numbers can&rsquo;t tell you why. In 14 days, we name what your money is actually doing, in dollars, guaranteed: <span class="dollar">at least 3x the fee in owner-accepted value identified, or you pay nothing.</span>
      </p>
      <div class="hero-cta-row">
        <a href={CALENDLY} class="btn btn-primary">Book the Diagnostic fit call</a>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Why this keeps happening</span>
        <h2>The numbers were never built to decide from.</h2>
        <p class="lede">
          The decisions weren&rsquo;t wrong. You made them on the only numbers you had, and those numbers were never built to decide from. Your accounting answers one question, what happened. It closes the month, files the taxes, satisfies the bank. Nobody producing it is paid to answer the question you actually have: which of these things makes money, and what should I do next?
        </p>
        <div class="delay-callout">
          We don&rsquo;t audit the past. We make the next call defensible.
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">What you get</span>
        <h2>What does the Diagnostic name, in dollars?</h2>
        <p class="lede">
          We normalize your numbers and run the Six Trap Diagnostic&trade;: the six structural patterns that trap value inside past decisions. Then the readout puts dollars on what it finds.
        </p>
        <ol class="engine-list">
          {finds.map((f) => (
            <li class="engine-item">
              <div>
                <p><strong>{f.heading}.</strong></p>
                <p style="margin-top: 8px; color: var(--muted);">{f.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Pricing and guarantee</span>
        <h2>Fixed before we begin.</h2>
        <div class="tier-meta" style="max-width: 560px;">
          {bands.map((band) => (
            <div class="tier-row">
              <span>{band[0]}</span>
              <span>{band[1]}</span>
            </div>
          ))}
        </div>
        <p class="lede" style="margin-top: 28px;">
          The Diagnostic identifies at least 3x its fee in owner-accepted value (recoverable cash, recoverable margin, or avoided cost) inside 14 days, validated by you in writing, or you pay nothing. Typical results run 5x to 10x.
        </p>
        <p>
          A 90-Day Decision Resolution signed within 7 days of the readout credits the Diagnostic fee in full. <a href="/guarantee">The guarantee mechanics, in full &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">The filter</span>
        <h2>Who the Diagnostic is not for.</h2>
        <p class="lede">
          Under $5M in revenue, the guarantee math does not hold and we refer out. If you are happy deciding on instinct, or shopping for bookkeeping, we are the wrong call. And if a sale, a PE approach, or a succession is on the table, start with the <a href="/scan">Sellable-Numbers Scan</a> instead: the same engine, run through a buyer&rsquo;s eyes.
        </p>
      </div>
    </div>
  </section>

  <section class="close-section">
    <div class="container">
      <div class="container-narrow">
        <h2>Decide from the numbers. Prove it in the cash.</h2>
        <p class="lede" style="color: rgba(255,255,255,0.8);">One 30-minute fit call. If it fits, the 14 days start.</p>
        <a href={CALENDLY} class="btn btn-primary">Book the Diagnostic fit call</a>
      </div>
    </div>
  </section>
</BaseLayout>
