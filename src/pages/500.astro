---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Something went wrong | Decisive Finance"
  description="Server error. Try again, or head back to the writing."
  noindex={true}
>
  <section class="hero">
    <div class="hero-inner">
      <span class="eyebrow">500</span>
      <h1>Something went wrong on our end.</h1>
      <p class="hero-subhead">
        Server error. Try the page again, or head back to the field notes while we look at it.
      </p>
      <div class="hero-cta-row">
        <a href="/blog" class="btn btn-primary">Back to the blog</a>
        <a href="/" class="btn btn-secondary">Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
