---
// Tool 2: Where the revenue went. Build brief OA/build-brief-owner-money-tools-2026-11-23.md, section 5.
// Copy: Approved dec_mwtsnrrx_96cc17eb unless marked Canon. Structure: dec_mwtsk9cv_7eb5dbf5.
import BaseLayout from '../layouts/BaseLayout.astro';
import Disclaimer from '../components/money-tools/Disclaimer.astro';
import ToolCTA from '../components/money-tools/ToolCTA.astro';
import PrintHead from '../components/money-tools/PrintHead.astro';
import PrintFoot from '../components/money-tools/PrintFoot.astro';
import core from '../scripts/money-tools-core.js?raw';
import '../styles/money-tools.css';

const title = 'Where the revenue went | Decisive Finance';
const ogTitle = 'Where the revenue went: follow the cash to what’s left';
const description = 'Revenue grew and your cash didn’t? Type two years from your P&L and see where every extra dollar went. Runs in your browser; nothing is stored.';
const H1 = 'Where did this year’s extra revenue go?';

type Row = { key: string; label: string; help: string; any?: boolean };
const rowsTop: Row[] = [
  { key: 'rev', label: 'Revenue', help: 'Total sales for the year (or month).' },
  { key: 'cogs', label: 'Cost of goods sold', help: 'Materials, direct labor, freight, subcontractors: what it took to deliver.' },
  { key: 'opex', label: 'Operating expenses', help: 'Everything else to run the business, excluding interest, depreciation and owner draws.' },
  { key: 'int', label: 'Interest paid', help: 'Interest on loans and the line of credit.' },
];
const rowsBottom: Row[] = [
  { key: 'prin', label: 'Loan principal repaid', help: 'The part of loan payments that pays down the balance. It never shows on the P&amp;L, but it leaves the bank.' },
  { key: 'grow', label: 'Cash tied up in growth', help: 'How much receivables plus inventory grew, less how much payables grew. Negative if they shrank.', any: true },
  { key: 'inv', label: 'Equipment and other investments', help: 'Trucks, machines, software builds, buildouts.' },
  { key: 'took', label: 'What you took out (optional)', help: 'Draws, distributions and owner pay above a market salary.' },
];
const cols = [
  { n: 1, name: 'Last year' },
  { n: 2, name: 'This year' },
];
---

<BaseLayout title={title} ogTitle={ogTitle} description={description}>
  <header class="hero mt-hero">
    <div class="hero-inner">
      <span class="eyebrow">Where the revenue went</span>
      <h1><span class="h1-line">{H1}</span></h1>
      <p class="hero-subhead">Revenue grew. Follow the cash to see where it went.</p>
      <p class="mt-subnote">Type last year and this year from your P&amp;L and balance sheet. It runs in your browser; nothing is sent or stored.</p>
    </div>
  </header>

  <section class="mt-section">
    <div class="mt-wrap">
      <div class="mt-tool" data-tool>
        <form class="mt-inputs" id="rw-form" autocomplete="off" novalidate>
          <div class="mt-toggle" role="radiogroup" aria-label="Annual or monthly">
            <input type="radio" name="rw-mode" id="rw-mode-a" value="annual" checked /><label for="rw-mode-a">Annual</label>
            <input type="radio" name="rw-mode" id="rw-mode-m" value="monthly" /><label for="rw-mode-m">Monthly</label>
          </div>
          <div class="mt-actions">
            <button type="button" class="mt-linkbtn" data-example>Show an example</button>
            <button type="button" class="btn btn-ghost" data-clear>Clear</button>
            <button type="button" class="btn btn-secondary" data-show-walk>Show the walk</button>
          </div>
          <p class="mt-banner" data-example-banner hidden>Example figures. Not a valuation of any company and not anyone&rsquo;s numbers.</p>

          <table class="mt-grid2">
            <thead>
              <tr>
                <td></td>
                {cols.map((c) => <th scope="col" id={`rw-col-${c.n}`} data-colname={c.n}>{c.name}</th>)}
              </tr>
            </thead>
            <tbody>
              {rowsTop.map((r) => (
                <tr>
                  <th scope="row">
                    <span class="mt-label" id={`rw-row-${r.key}`}>{r.label}</span>
                    <p class="mt-help" id={`rw-help-${r.key}`} set:html={r.help} />
                  </th>
                  {cols.map((c) => (
                    <td>
                      <span class="sr-only mt-coltag" aria-hidden="true" data-colname={c.n}>{c.name}</span>
                      <input type="text" inputmode="decimal" autocomplete="off" spellcheck="false"
                        id={`rw-${r.key}-${c.n}`} data-kind={r.any ? 'money-any' : 'money'}
                        aria-labelledby={`rw-row-${r.key} rw-col-${c.n}`} aria-describedby={`rw-help-${r.key}`}
                        data-print-label={`${r.label}, ${c.name.toLowerCase()}`} data-col={c.n} data-rowlabel={r.label} />
                    </td>
                  ))}
                </tr>
              ))}
              <tr>
                <th scope="row">
                  <label class="mt-label" for="rw-rate">Tax set-aside rate (optional)</label>
                  <p class="mt-help" id="rw-help-rate">A rate your CPA gives you, applied to profit before tax. Leave blank to see everything before tax.</p>
                </th>
                <td colspan="2">
                  <input type="text" inputmode="decimal" autocomplete="off" spellcheck="false" id="rw-rate" data-kind="rate" aria-describedby="rw-help-rate rw-rate-note" />
                  <p class="mt-fnote" id="rw-rate-note" hidden></p>
                </td>
              </tr>
              {rowsBottom.map((r) => (
                <tr>
                  <th scope="row">
                    <span class="mt-label" id={`rw-row-${r.key}`}>{r.label}</span>
                    <p class="mt-help" id={`rw-help-${r.key}`} set:html={r.help} />
                  </th>
                  {cols.map((c) => (
                    <td>
                      <span class="sr-only mt-coltag" aria-hidden="true" data-colname={c.n}>{c.name}</span>
                      <input type="text" inputmode="decimal" autocomplete="off" spellcheck="false"
                        id={`rw-${r.key}-${c.n}`} data-kind={r.any ? 'money-any' : 'money'}
                        aria-labelledby={`rw-row-${r.key} rw-col-${c.n}`} aria-describedby={`rw-help-${r.key}`}
                        data-print-label={`${r.label}, ${c.name.toLowerCase()}`} data-col={c.n} data-rowlabel={r.label} />
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </form>

        <div class="mt-out">
          <PrintHead head={H1} />
          <dl class="mt-print-inputs mt-print-only" data-print-inputs></dl>
          <Disclaimer variant="operating" />
          <div class="mt-result" id="rw-result" data-result tabindex="-1" role="region" aria-label="Where the revenue went">
            <div aria-live="polite">
              <p class="mt-empty" data-empty>Type revenue to see where it went.</p>
            </div>
            <div class="mt-result-body" data-body hidden>
              <div aria-live="polite">
                <p class="mt-lead" data-lead></p>
                <p class="mt-lead-sub" data-lead-sub hidden></p>
                <p class="mt-interp" data-interp hidden></p>
              </div>
              <table class="mt-walk mt-stack" data-years-table>
                <caption class="sr-only" data-years-caption></caption>
                <thead data-years-head></thead>
                <tbody data-years></tbody>
              </table>
              <div data-sentences></div>
              <table class="mt-walk" data-bridge-table hidden>
                <caption data-bridge-caption></caption>
                <tbody data-bridge></tbody>
              </table>
              <div class="mt-chart" data-chart aria-hidden="true"></div>
              <p class="mt-next">Most of the gap between revenue and cash sits in which customers and products actually make money. <a href="/margin-check">Check your top 10 customers</a></p>
            </div>
          </div>
          <PrintFoot />
        </div>

        <button type="button" class="mt-summary" data-summary aria-expanded="false" aria-controls="rw-result" hidden><span data-summary-text></span></button>
      </div>

      <div class="mt-noprint">
        <ToolCTA variant="operating" />
      </div>
    </div>
  </section>

  <section class="mt-close"><p>Decide from the numbers. Prove it in the cash.</p></section>
</BaseLayout>

<script is:inline set:html={core}></script>
<script is:inline>
(function () {
  var MT = window.MT;
  var tool = document.querySelector('[data-tool]');
  var form = document.getElementById('rw-form');
  var $ = function (id) { return document.getElementById(id); };
  var q = function (sel) { return tool.querySelector(sel); };
  var SEG = [
    { k: 'cogs', label: 'Cost of goods sold', fill: '#182228' },
    { k: 'opex', label: 'Operating expenses', fill: '#34444c' },
    { k: 'int', label: 'Interest', fill: '#506169' },
    { k: 'tx', label: 'Tax set-aside', fill: '#6d7d85' },
    { k: 'prin', label: 'Principal repaid', fill: '#8c9aa0' },
    { k: 'grow', label: 'Cash tied up in growth', fill: '#aab5ba' },
    { k: 'inv', label: 'Investments', fill: '#c7cfd3' },
    { k: 'L', label: 'Left for you', fill: '#a8431a' }
  ];

  function names() {
    var monthly = $('rw-mode-m').checked;
    return monthly
      ? { col: ['Last month', 'This month'], now: 'this month' }
      : { col: ['Last year', 'This year'], now: 'this year' };
  }

  function applyNames(n) {
    tool.querySelectorAll('[data-colname]').forEach(function (e) { e.textContent = n.col[Number(e.getAttribute('data-colname')) - 1]; });
    form.querySelectorAll('input[data-col]').forEach(function (i) {
      i.setAttribute('data-print-label', i.getAttribute('data-rowlabel') + ', ' + n.col[Number(i.getAttribute('data-col')) - 1].toLowerCase());
    });
  }

  function column(n, r, hasRate) {
    var m = function (k, any) { return MT.parseMoney($('rw-' + k + '-' + n), !!any); };
    var R = m('rev');
    if (!R.entered || R.value <= 0) return null;
    var c = { R: R.value, cogs: m('cogs').value, opex: m('opex').value, int: m('int').value, prin: m('prin').value, grow: m('grow', true).value, inv: m('inv').value };
    var took = m('took');
    c.GP = c.R - c.cogs;
    c.OP = c.GP - c.opex;
    c.PBT = c.OP - c.int;
    c.tx = r * Math.max(c.PBT, 0);
    c.PAT = c.PBT - c.tx;
    c.L = c.PAT - c.prin - c.grow - c.inv;
    c.tookEntered = took.entered;
    c.took = took.value;
    c.B = took.entered ? c.L - took.value : null;
    c.loss = hasRate && c.PBT < 0;
    return c;
  }

  function c1(v) { var t = v.toFixed(1); return t.charAt(0) === '-' ? '\u2212' + t.slice(1) : t; }
  function cents(x, R) { return c1(100 * x / R) + '\u00a2'; }

  function cell(tr, value, R, opts) {
    opts = opts || {};
    var td = MT.el('td');
    td.appendChild(document.createTextNode(opts.signed ? MT.signed(value) : MT.money(value)));
    if (R) td.appendChild(MT.el('span', 'mt-cents', cents(value, R)));
    td.setAttribute('data-value', String(MT.round(value)));
    if (opts.col) td.setAttribute('data-col', opts.col);
    if (opts.col && LABELS[opts.col]) td.setAttribute('data-label', LABELS[opts.col]);
    tr.appendChild(td);
  }

  var LABELS = {};
  function recompute() {
    var n = names();
    LABELS = { '1': n.col[0], '2': n.col[1], 'd': 'Change' };
    applyNames(n);
    var rate = MT.parseRange($('rw-rate'), 60);
    MT.note('rw-rate-note', rate.clamped ? 'Use 0 to 60.' : '');
    var hasRate = rate.entered;
    var r = hasRate ? rate.value / 100 : 0;
    MT.printInputs(form, q('[data-print-inputs]'));

    var c2 = column(2, r, hasRate);
    var c1 = c2 ? column(1, r, hasRate) : null;
    var empty = q('[data-empty]'), body = q('[data-body]');
    if (!c2) { empty.hidden = false; body.hidden = true; MT.setSummary(tool, ''); return; }
    empty.hidden = true; body.hidden = false;
    var both = !!c1;
    var bt = hasRate ? '' : ', before tax';

    // Lead
    var lead = q('[data-lead]');
    lead.innerHTML = '';
    lead.appendChild(document.createTextNode('Left for you ' + n.now + bt + ': '));
    lead.appendChild(MT.el('span', 'mt-num', MT.money(c2.L)));
    lead.setAttribute('data-l2', String(MT.round(c2.L)));
    MT.setSummary(tool, 'Left for you ' + n.now + bt + ': ' + MT.money(c2.L));
    var sub = q('[data-lead-sub]');
    if (both) { sub.textContent = n.col[0] + ': ' + MT.money(c1.L); sub.hidden = false; lead.setAttribute('data-l1', String(MT.round(c1.L))); }
    else { sub.hidden = true; lead.removeAttribute('data-l1'); }

    // Interpretation
    var interp = q('[data-interp]');
    var dR = both ? c2.R - c1.R : 0, dL = both ? c2.L - c1.L : 0;
    if (both) {
      if (dR > 0 && dL < 0) interp.textContent = 'Revenue rose ' + MT.abs(dR) + '. What’s left for you fell ' + MT.abs(dL) + '.';
      else if (dR > 0) interp.textContent = 'Revenue rose ' + MT.abs(dR) + '. What’s left for you rose ' + MT.abs(dL) + '.';
      else interp.textContent = 'Revenue fell ' + MT.abs(dR) + '. What’s left for you moved ' + MT.signed(dL) + '.';
      interp.hidden = false;
    } else interp.hidden = true;

    // Side-by-side table
    var head = q('[data-years-head]');
    head.innerHTML = '';
    var htr = MT.el('tr');
    htr.appendChild(Object.assign(MT.el('th', null, 'Line'), { scope: 'col' }));
    if (both) htr.appendChild(Object.assign(MT.el('th', 'num', n.col[0]), { scope: 'col' }));
    htr.appendChild(Object.assign(MT.el('th', 'num', n.col[1]), { scope: 'col' }));
    if (both) htr.appendChild(Object.assign(MT.el('th', 'num', 'Change'), { scope: 'col' }));
    head.appendChild(htr);
    q('[data-years-caption]').textContent = 'Where the revenue went, ' + (both ? n.col[0].toLowerCase() + ' and ' : '') + n.col[1].toLowerCase();

    var tb = q('[data-years]');
    tb.innerHTML = '';
    var lines = [
      ['R', 'Revenue'], ['cogs', 'Cost of goods sold'], ['opex', 'Operating expenses'], ['int', 'Interest'],
      ['PBT', 'Profit before tax', 'mt-total'], ['tx', 'Tax set-aside at your rate'], ['prin', 'Principal repaid'],
      ['grow', 'Cash tied up in growth'], ['inv', 'Investments'], ['L', 'Left for you' + bt, 'mt-total']
    ];
    lines.forEach(function (ln) {
      if (ln[0] === 'tx' && !hasRate) return;
      var tr = MT.el('tr', ln[2] || '');
      tr.setAttribute('data-row', ln[0]);
      var th = MT.el('th', null, ln[1]); th.scope = 'row'; tr.appendChild(th);
      var growSigned = ln[0] === 'grow';
      if (both) cell(tr, growSigned && c1.grow < 0 ? -c1.grow : c1[ln[0]], c1.R, { col: '1', signed: growSigned && c1.grow < 0 });
      cell(tr, growSigned && c2.grow < 0 ? -c2.grow : c2[ln[0]], c2.R, { col: '2', signed: growSigned && c2.grow < 0 });
      if (both) cell(tr, c2[ln[0]] - c1[ln[0]], null, { col: 'd', signed: true });
      tb.appendChild(tr);
    });
    var tookAny = c2.tookEntered || (both && c1.tookEntered);
    if (tookAny) {
      [['took', 'What you took out'], ['B', 'Change in the bank']].forEach(function (ln) {
        var tr = MT.el('tr'); tr.setAttribute('data-row', ln[0]);
        var th = MT.el('th', null, ln[1]); th.scope = 'row'; tr.appendChild(th);
        var put = function (c, col) {
          if (c.tookEntered) cell(tr, c[ln[0]], null, { col: col, signed: ln[0] === 'B' });
          else { var td = MT.el('td', null, ''); td.setAttribute('data-col', col); td.setAttribute('data-label', LABELS[col]); tr.appendChild(td); }
        };
        if (both) put(c1, '1');
        put(c2, '2');
        if (both) {
          if (c1.tookEntered && c2.tookEntered) cell(tr, c2[ln[0]] - c1[ln[0]], null, { col: 'd', signed: true });
          else tr.appendChild(MT.el('td', null, ''));
        }
        tb.appendChild(tr);
      });
    }

    // Sentences
    var sw = q('[data-sentences]');
    sw.innerHTML = '';
    var say = function (t, key) { var p = MT.el('p', 'mt-sentence', t); p.setAttribute('data-sentence', key); sw.appendChild(p); };
    var released = [];
    if (both && c1.grow < 0) released.push(c1.grow);
    if (c2.grow < 0) released.push(c2.grow);
    released.forEach(function (g) { say('Cash released from receivables and inventory: ' + MT.signed(-g) + '.', 'released'); });
    if ((both && c1.loss) || c2.loss) say('No tax set-aside on a loss.', 'loss');
    if (c2.tookEntered && c2.B < 0) say('You took out ' + MT.money(c2.took) + ' and the business left you ' + MT.money(c2.L) + '. The difference, ' + MT.abs(c2.B) + ', came from the bank balance or borrowing.', 'bank');
    if (c2.L < 0) say('Nothing was left for you: the business needed ' + MT.abs(c2.L) + ' more than it produced.', 'nothing');

    // Bridge
    var bt2 = q('[data-bridge-table]'), bb = q('[data-bridge]');
    bb.innerHTML = '';
    bt2.hidden = true;
    if (both && dR > 0) {
      var items = [
        ['cogs', 'Cost of goods sold'], ['opex', 'Operating expenses'], ['int', 'Interest'], ['tx', 'Tax set-aside'],
        ['prin', 'Principal repaid'], ['grow', 'Cash tied up in growth'], ['inv', 'Investments']
      ].map(function (it) { return { k: it[0], label: it[1], d: c2[it[0]] - c1[it[0]] }; });
      var sum = items.reduce(function (s, it) { return s + it.d; }, 0) + dL;
      if (Math.abs(sum - dR) >= 0.5) {
        console.log('Bridge does not tie: sum ' + sum + ' vs change in revenue ' + dR);
      } else {
        items = items.filter(function (it) { return !(it.k === 'tx' && !hasRate); });
        items.sort(function (a, b) { return Math.abs(b.d) - Math.abs(a.d); });
        items.push({ k: 'L', label: 'Left for you' + bt, d: dL });
        items.forEach(function (it) {
          var tr = MT.el('tr', it.k === 'L' ? 'mt-total' : '');
          tr.setAttribute('data-row', it.k);
          var th = MT.el('th', null, it.label); th.scope = 'row'; tr.appendChild(th);
          cell(tr, it.d, null, { signed: true });
          bb.appendChild(tr);
        });
        q('[data-bridge-caption]').textContent = 'Where the extra ' + MT.abs(dR) + ' went';
        bt2.setAttribute('data-sum', String(MT.round(sum)));
        bt2.hidden = false;
      }
    }

    chart(both ? [[n.col[0], c1], [n.col[1], c2]] : [[n.col[1], c2]]);
  }

  function chart(cols) {
    var box = q('[data-chart]');
    var W = 680, H = 380, top = 24, bot = 332, colW = 96;
    var NS = 'http://www.w3.org/2000/svg';
    var mk = function (t, a, txt) { var e = document.createElementNS(NS, t); Object.keys(a).forEach(function (k) { e.setAttribute(k, a[k]); }); if (txt != null) e.textContent = txt; return e; };
    var data = cols.map(function (cc) {
      var c = cc[1];
      var pos = [], neg = [];
      SEG.forEach(function (s) {
        var v = 100 * c[s.k] / c.R;
        if (Math.abs(v) < 0.05) return;
        (v > 0 ? pos : neg).push({ s: s, v: v });
      });
      var T = pos.reduce(function (a, p) { return a + p.v; }, 0);
      return { name: cc[0], pos: pos, neg: neg, T: T };
    });
    var maxT = Math.max(100, Math.max.apply(null, data.map(function (d) { return d.T; })));
    var y = function (v) { return bot - (bot - top) * v / maxT; };
    var svg = mk('svg', { viewBox: '0 0 ' + W + ' ' + H, focusable: 'false' });
    data.forEach(function (d, i) {
      var x = 40 + i * (W / data.length);
      var acc = 0, labels = [];
      d.pos.forEach(function (p) {
        var y0 = y(acc), y1 = y(acc + p.v);
        svg.appendChild(mk('rect', { x: x, y: y1, width: colW, height: Math.max(0.5, y0 - y1), fill: p.s.fill }));
        labels.push({ yc: (y0 + y1) / 2, text: p.s.label + '  ' + c1(p.v) + '\u00a2', orange: p.s.k === 'L' });
        acc += p.v;
      });
      var acc2 = 100;
      d.neg.forEach(function (p) {
        var y0 = y(acc2), y1 = y(acc2 - p.v);
        svg.appendChild(mk('rect', { x: x + 3, y: y1 + 1.5, width: colW - 6, height: Math.max(0.5, y0 - y1 - 3), fill: 'none', stroke: p.s.k === 'L' ? '#a8431a' : '#5a6a72', 'stroke-width': 3, 'stroke-dasharray': '6 4' }));
        var lbl = p.s.k === 'grow' ? 'Cash released from receivables and inventory' : p.s.label;
        labels.push({ yc: (y0 + y1) / 2, text: lbl + '  ' + c1(p.v) + '\u00a2', orange: p.s.k === 'L' });
        acc2 -= p.v;
      });
      if (d.T > 100.05) {
        svg.appendChild(mk('line', { x1: x - 8, x2: x + colW + 8, y1: y(100), y2: y(100), stroke: '#182228', 'stroke-width': 2 }));
        svg.appendChild(mk('text', { x: x - 10, y: y(100) + 4, 'text-anchor': 'end', 'font-size': 12, fill: '#182228' }, '100¢'));
      }
      labels.sort(function (a, b) { return a.yc - b.yc; });
      var gap = 15, prev = -Infinity;
      labels.forEach(function (l) { l.y = Math.max(l.yc, prev + gap); prev = l.y; });
      var over = labels.length ? labels[labels.length - 1].y - (bot + 2) : 0;
      if (over > 0) labels.forEach(function (l) { l.y -= over; });
      labels.forEach(function (l) {
        var lx = x + colW + 10;
        svg.appendChild(mk('line', { x1: x + colW, x2: lx - 2, y1: l.yc, y2: l.y - 4, stroke: '#8c9aa0', 'stroke-width': 1 }));
        svg.appendChild(mk('text', { x: lx, y: l.y, 'font-size': 12.5, fill: l.orange ? '#a8431a' : '#182228', 'font-weight': l.orange ? 700 : 400 }, l.text));
      });
      svg.appendChild(mk('text', { x: x + colW / 2, y: H - 22, 'text-anchor': 'middle', 'font-size': 14, 'font-weight': 700, fill: '#182228' }, d.name));
    });
    box.innerHTML = '';
    box.appendChild(svg);
  }

  form.addEventListener('change', function (e) { if (e.target && e.target.name === 'rw-mode') recompute(); });
  MT.wire({
    tool: tool,
    form: form,
    recompute: recompute,
    example: {
      'rw-mode-a': true,
      'rw-rev-1': '$10,000,000', 'rw-rev-2': '$12,000,000',
      'rw-cogs-1': '$6,200,000', 'rw-cogs-2': '$7,680,000',
      'rw-opex-1': '$2,700,000', 'rw-opex-2': '$3,050,000',
      'rw-int-1': '$120,000', 'rw-int-2': '$160,000',
      'rw-rate': '25',
      'rw-prin-1': '$300,000', 'rw-prin-2': '$400,000',
