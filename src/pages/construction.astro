---
import BaseLayout from '../layouts/BaseLayout.astro';

// Awareness stage: problem-aware (owner feels thin margin, hasn't named the back-office mechanism)
const title = 'Finance for construction companies | Decisive';
const description =
  'Most contractors lose 5 to 10 points of margin between the bid and the bank. We find where it goes in 14 days, then install the back office that stops it.';

const CALENDLY = 'https://calendly.com/russell-decisive/30min';

const leaks = [
  {
    name: 'Job costs without a job',
    body: 'Sub invoices and material receipts that never land on the job that spent them. You find out what a job actually made 60 days after closeout, if ever.',
  },
  {
    name: 'Bids priced on hope',
    body: 'Estimated-to-actual variance that never gets measured, so the same miss gets bid the same way next quarter.',
  },
  {
    name: 'Invoice-when-short',
    body: 'Billing that follows the bank balance instead of the draw schedule. Collections from memory. Cash that arrives late because nobody asked on time.',
  },
  {
    name: 'Terms nobody priced',
    body: 'The commercial account taking a 20 percent discount on 60-day terms. The work that consistently loses money but keeps getting bid because nobody ran the number.',
  },
  {
    name: 'Supplements and change orders that leak',
    body: 'Work performed, never captured, never billed. On insurance and remodel work this alone can be points of margin.',
  },
  {
    name: 'Interest doing the bleeding',
    body: 'Credit cards, short-term notes, and back taxes paid in whatever order the calls come in, instead of highest cost first.',
  },
];

const installSteps = [
  [
    'The diagnostic, 14 days.',
    'We pull your numbers and name the leaks: job costing, pricing, terms, supplements, debt. You get the findings either way, in dollars, with the fixes ranked by payback.',
  ],
  [
    'The install.',
    'Back office first, margin discipline on top. Job-cost tracking, AP control, clean books, and a margin review with teeth.',
  ],
  [
    'The rhythm.',
    'A weekly financial review with you, a monthly profitability review on every job. Most owners see the picture change inside the first quarter.',
  ],
];

const proof = [
  {
    tag: '$7M insurance reconstruction, growing fast',
    headline: 'The cost gap went from invisible to managed.',
    outcome: 'A 10 to 15 point cost gap, worth $700K to $1M a year, found and put under monthly management',
    body: 'Cost of goods was running 60 to 65 percent against a 50 percent target. At $7M, every point is roughly $70,000 a year. We installed job-cost discipline, controlled payables, corrected commissions, and a monthly profitability review with a named owner.',
  },
  {
    tag: 'Restoration and mitigation company',
    headline: 'From instinct to numbers on the table.',
    outcome: 'Net income $200,000 ahead of the prior year, year to date, with a record $346,000 month',
    body: 'Marketing spend was not reconciled to jobs, commercial terms were quietly strangling cash, and the reconstruction division had no margin targets. We installed a monthly business review, audited 90 days of lead-gen spend, set 50 percent gross margin targets with supplement tracking, and flagged the terms that needed repricing.',
  },
  {
    tag: '$2M design-build remodeler',
    headline: 'From no breathing room to an exit plan.',
    outcome: 'Seven points of targeted margin, roughly $140,000 a year, and a path from $350K toward $1M in owner earnings',
    body: 'Profitable on paper, no cushion underneath: high-interest debt, books that needed two years of rebuilding, billing that followed the bank balance. We rebuilt the books, installed a weekly review, ordered the debt by interest cost, and ran pricing toward a 30 percent gross margin from 23.',
  },
];
---

<BaseLayout title={title} description={description}>
  <header class="hero">
    <div class="hero-inner">
      <span class="eyebrow">For owner-led construction companies</span>
      <h1>
        <span class="h1-line">Your crews earn the margin.</span>
        <span class="h1-line">Your back office leaks it.</span>
        <span class="h1-line h1-line-accent">5 to 10 points, every year.</span>
      </h1>
      <p class="hero-subhead">
        The leak isn't on the job site. It's in job costs that land nowhere, invoices that follow the
        bank balance, supplements nobody tracked, and terms nobody priced.
        <span class="dollar">We find where the margin goes in 14 days,</span> then install the back
        office that stops it.
      </p>
      <div class="hero-cta-row">
        <a class="btn btn-primary" href={CALENDLY}>Book the diagnostic</a>
      </div>
    </div>
  </header>

  <section class="traps">
    <div class="container">
      <div class="section-eyebrow">The problem</div>
      <h2>Where the margin goes</h2>
      <p class="lede" style="color: rgba(255,255,255,0.88);">
        It doesn't leave in one place. It leaves a point at a time, in places the P&amp;L doesn't show.
      </p>
      <div class="trap-grid">
        {leaks.map((p, i) => (
          <div class="trap-card">
            <div class="trap-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="trap-name" style="font-size: 19px;">{p.name}</div>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
      <div class="traps-footer">
        If three or more of those landed, the problem isn't how you run jobs. It's that your operation
        outgrew your back office, and the financial picture is 60 days behind the truth.
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-eyebrow">The work</div>
      <h2>What we install</h2>
      <p class="lede">Two offerings. They work alone. They work better in order.</p>
      <div class="fit-grid">
        <div class="fit-col">
          <h4>The back office, automated</h4>
          <ul>
            <li>Every sub invoice and material receipt carries a job number and lands on the job that spent it, within days, not months</li>
            <li>AP standardized through one platform, with payment timing managed deliberately so operations stay liquid</li>
            <li>Books closed fast and kept clean. Payroll, commissions, and bonus runs standardized and correct</li>
            <li>A weekly financial rhythm with the owner. You're never more than seven days from an accurate picture</li>
          </ul>
        </div>
        <div class="fit-col">
          <h4>The margin, recovered</h4>
          <ul>
            <li>A live margin target on every job, checked before the job starts, mid-project, and at post-mortem</li>
            <li>Bid-by-bid pricing review against what jobs actually cost, not what they were supposed to cost</li>
            <li>Kill the categories of work that consistently lose money. Reprice or walk the terms that strangle cash</li>
            <li>A debt strategy ordered by interest cost, so free cash flow goes where it does the most damage</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="container">
      <div class="section-eyebrow">The proof</div>
      <h2>What it looks like in the field</h2>
      <p class="lede">Three owner-led contractors. Same playbook. Names withheld; details available in conversation.</p>
      <div class="proof-grid">
        {proof.map((c) => (
          <div class="proof-card">
            <span class="proof-tag">{c.tag}</span>
            <div class="proof-outcome">{c.outcome}</div>
            <p class="resolution">{c.body}</p>
            <div class="takeaway">{c.headline}</div>
          </div>
        ))}
      </div>
      <p style="font-size: 14px; color: var(--muted); margin-top: 26px;">
        Results reflect specific client engagements and the work installed within them. Your numbers depend on your business.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-eyebrow">Running EOS&reg;?</div>
      <h2>The financial rhythm slots into it</h2>
      <div class="category-pull" style="font-style: normal;">
        Scorecard numbers that are actually current. L10-ready financials. Rocks with a dollar figure
        attached. No new framework to adopt; we fill in the financial layer your operating system
        assumes you already have. <a href="/eos/">See how the rhythm pairs with EOS &rarr;</a>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="container">
      <div class="section-eyebrow">How it starts</div>
      <h2>Diagnostic first. Install second. Rhythm always.</h2>
      <div class="engine-list">
        {installSteps.map((s) => (
          <div class="engine-item">
            <p><strong>{s[0]}</strong> {s[1]}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-eyebrow">Fit check</div>
      <h2>Who this is not for</h2>
      <div class="notfor">
        <p>
          If your books close in five days, every job carries a live cost report, and your gross margin
          lands within a point of your bids, you don't need us. That's the system working. This is for
          owners whose operation outgrew their back office: the business runs, the work is good, and the
          financial picture is 60 days behind the truth.
        </p>
      </div>
    </div>
  </section>

  <section class="cohort">
    <div class="container">
      <div class="cohort-eyebrow">The diagnostic</div>
      <h2>14 days. We name where your margin goes.</h2>
      <p class="lede" style="color: rgba(255,255,255,0.92); max-width: 760px;">
        Findings in dollars, ranked by payback, whether or not we go further. Bring your last P&amp;L,
        or just bring questions. If we can't find it, we'll tell you that too.
      </p>
      <a class="btn btn-secondary" href={CALENDLY}>Book the diagnostic</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfor {
    max-width: 760px;
  }
  .notfor p {
    font-size: 17px;
    line-height: 1.65;
    color: var(--muted);
  }
</style>
