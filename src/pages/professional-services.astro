---
import BaseLayout from '../layouts/BaseLayout.astro';

const CALENDLY = 'https://calendly.com/russell-decisive/30min';

const title = 'Finance for professional services firms | Decisive';
const description =
  'The billings are visible. The profit behind them is not. $380,000 of working capital recovered and close cut from 22 days to 3 at a $30M firm, in 90 days.';

const traps = [
  {
    name: 'Certainty Illusion',
    body: 'Polished monthly reports can feel like proof when they are really theater. The story behind realization, utilization, and WIP quietly stopped being true, and nobody is paid to notice.',
  },
  {
    name: 'Status Quo',
    body: 'A billing and close cadence nobody has revisited traps cash for weeks at a time. If the close takes three weeks, every decision that month is made on stale numbers.',
  },
  {
    name: 'Loss Aversion',
    body: 'The anchor client you are most afraid to reprice or lose is often the one capping your margin, and the one most tied to a single partner. The math never gets run because the answer feels dangerous.',
  },
];
---

<BaseLayout title={title} description={description}>
  <header class="hero">
    <div class="hero-inner">
      <span class="eyebrow">For professional services firms</span>
      <h1>
        <span class="h1-line">The billings are visible.</span>
        <span class="h1-line h1-line-accent">The profit behind them is not.</span>
      </h1>
      <p class="hero-subhead">
        Realization leakage, unbilled WIP, and a slow close hide which clients and partners actually make money. <span class="dollar">We price the answer in dollars.</span> Guaranteed 3x your Diagnostic fee in recoverable value, in 14 days.
      </p>
      <div class="hero-cta-row">
        <a class="btn btn-primary" href={CALENDLY}>Book a fit call</a>
        <a class="btn btn-secondary" href="/how-it-works">See the 14-day Diagnostic</a>
      </div>
      <p class="hero-microcopy">30 minutes with Russ. No pitch. You leave knowing where to look first.</p>
    </div>
  </header>

  <section>
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Where the profit hides in a firm</span>
        <h2>The billings are visible. What actually earns is not.</h2>
        <p class="lede">
          Realization leakage, utilization truth, unbilled WIP, client and partner profitability, and the speed of the close: the numbers that decide which work deserves the firm's hours. Most firms bill on all of it and decide on none of it.
        </p>
        <div class="category-pull">
          Your books tell you what happened. They can't tell you what to do next.
        </div>
        <p>
          The decisions weren't wrong. You made them on the only numbers you had, and those numbers were never built to decide from. Everyone who touches your books is paid to serve something else: the filing, the close, the report. Nobody is paid to make the next call defensible, and that is the job we do.
        </p>
        <div class="delay-callout">
          We don't audit the past. We make the next call defensible.
        </div>
      </div>
    </div>
  </section>

  <section class="traps">
    <div class="container">
      <div class="section-eyebrow">Where the value is trapped</div>
      <h2>Three traps behind a firm's clean reports.</h2>
      <p class="lede" style="color: rgba(255,255,255,0.88);">
        The Six Trap Diagnostic&trade; reads your numbers through the decisions that produced them. Three of the six do the most damage in a firm. The patterns are structural, not failures of the owner.
      </p>
      <div class="trap-grid">
        {traps.map((t, i) => (
          <div class="trap-card">
            <div class="trap-num">Trap {String(i + 1).padStart(2, '0')}</div>
            <div class="trap-name">{t.name}</div>
            <p>{t.body}</p>
          </div>
        ))}
      </div>
      <div class="traps-footer">
        We name the stack, price each one in dollars, and turn the read into a plan. We don't audit the past. We make the next call defensible.
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Proof</span>
        <h2>A firm that ran on data, and still wasn't getting the truth from it.</h2>
      </div>
      <div class="worked">
        <span class="label">Professional services, $30M revenue</span>
        <h4>A clean close is not a fast one, and neither tells you where the cash is stuck.</h4>
        <p>
          Cash was trapped in a billing and close cadence nobody had revisited, and clean-looking reports masked the leak. We rebuilt the rhythm, pulled the working capital forward, and put margin on a weekly line of sight.
        </p>
        <div class="calc">
          <div><span class="k">Working capital recovered</span><span class="v accent">$380,000</span></div>
          <div><span class="k">Close time</span><span class="v">22 to 3 days</span></div>
          <div><span class="k">Margin improvement</span><span class="v">~$50,000 / mo</span></div>
        </div>
      </div>
      <p style="font-size: 14px; color: var(--muted); margin-top: 22px;">
        Anonymized by segment and revenue band until attribution is confirmed.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Tiers and pricing</span>
        <h2>Find. Install. Run.</h2>
        <p class="lede">
          Most owners start with the 14-day Decision Diagnostic and move into the 90-Day Resolution. Pricing is banded by revenue, and the floor is $5M.
        </p>
        <p class="promise-line">
          The Diagnostic promise: at least 3x the fee in owner-accepted value identified by Day 14, or you pay nothing.
        </p>
        <div class="hero-cta-row" style="margin-top: 8px;">
          <a class="btn btn-secondary" href="/#tiers">See tiers and pricing</a>
          <a class="btn btn-secondary" href="/guarantee">Read the guarantee</a>
        </div>
      </div>
    </div>
  </section>

  <section class="close-section">
    <div class="container">
      <span class="section-eyebrow">Book a fit call</span>
      <h2>Decide from the numbers. Prove it in the cash.</h2>
      <p class="lede">
        In 14 days you know what the firm's money is actually doing, in dollars: the traps that are running, the recoverable value, and the first three moves, whether or not we ever work together again. It starts with one 30-minute call.
      </p>
      <div class="hero-cta-row">
        <a class="btn btn-primary" href={CALENDLY}>Book a fit call</a>
        <a class="btn btn-secondary" href="/how-it-works">See the 14-day Diagnostic</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-microcopy { font-size: 15px; color: rgba(255, 255, 255, 0.7); margin: 10px 0 0; }
  .promise-line { font-family: Inter, sans-serif; font-weight: 600; color: var(--ink); margin-top: 8px; }
</style>
