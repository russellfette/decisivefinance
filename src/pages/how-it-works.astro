---
import BaseLayout from '../layouts/BaseLayout.astro';

const CALENDLY = 'https://calendly.com/russell-decisive/30min';

const title = 'How it works · Find. Install. Run. | Decisive Finance';
const description =
  'Find: a 14-day Diagnostic that names what your current capital is doing. Install: a 90-day Resolution that installs the rhythm and proves it in market. Run: a Partnership that runs the rhythm on retainer.';

const tiers = [
  {
    color: 'find',
    stamp: 'Find · Tier 1',
    name: 'The Decision Diagnostic',
    promise: 'Names what your current capital is doing, in 14 days.',
    rows: [
      { label: 'Price', value: '<strong>$7,500</strong> under $3M ARR · <strong>$10,000</strong> from $3M to $8M ARR' },
      { label: 'CEO time', value: '3 hours total' },
      { label: 'Artifacts', value: '5 named deliverables' },
      { label: 'Guarantee', value: '<strong>3x fee</strong> in trapped value with CEO-accepted recovery plans, a defined strategic finding, or 100% refund.' },
    ],
  },
  {
    color: 'install',
    stamp: 'Install · Tier 2',
    name: 'The 90-Day Decision Resolution',
    promise: 'Installs the rhythm that defends every next call, and proves it in market across 90 days.',
    rows: [
      { label: 'Price', value: '<strong>$22,500 to $30,000</strong> total · Founding Cohort <strong>$18,000</strong> flat' },
      { label: 'CEO time', value: '15 to 18 hours total' },
      { label: 'Artifacts', value: '10 new (15 cumulative)' },
      { label: 'Guarantee', value: '<strong>Rhythm installed in market</strong> by Day 90 or full refund. Five decisions defended with math, two live in market with the data to score them, scenario forecast running.' },
    ],
  },
  {
    color: 'run',
    stamp: 'Run · Tier 3',
    name: 'The Decision Partnership',
    promise: 'Runs the rhythm on retainer.',
    rows: [
      { label: 'Price', value: '<strong>$7,500 / month</strong> base + <strong>5%</strong> on Realized Value' },
      { label: 'CEO time', value: '2 to 3 hrs / month + 4 to 6 / quarter' },
      { label: 'Artifacts', value: '4 recurring + on-demand modeling' },
      { label: 'Term', value: '6-month minimum from Tier 2 close, then month-to-month with 30-day notice.' },
    ],
  },
];

const loopSteps = [
  { name: 'Decision', desc: 'A hire, a product launch, a vendor sign, a pricing set, a channel spend commit.', intervention: false },
  { name: 'Commitment', desc: 'The recurring P&L line or revenue-side commitment that decision creates.', intervention: false },
  { name: 'Drift', desc: 'Assumptions change. The decision stays. Context moves; capital does not.', intervention: false },
  { name: 'Trap', desc: 'One of six cognitive biases keeps the original decision running by default.', intervention: false },
  { name: 'Diagnose', desc: 'The Six Trap Diagnostic surfaces the gap on math, not instinct. Our work begins.', intervention: true },
  { name: 'Revisit', desc: 'Three-Path Model, Pricing Architecture Revisit, or Growth Experiment Register produces a new decision tested in market.', intervention: true },
];

const traps = [
  {
    n: '01', name: 'Sunk Cost',
    headline: 'The money already spent feels like it is voting.',
    line: 'It is not.',
    evidence: [
      { tag: 'Cost', body: 'Negative-margin product lines still receiving headcount.' },
      { tag: 'Pricing', body: 'Legacy tiers preserved because "we built the model around them."' },
      { tag: 'Growth', body: 'Channels funded on what they produced 12 to 18 months ago.' },
    ],
    fixLabel: 'Unlock move · Marginal analysis framing',
    fix: 'Reframe "what we have invested" to "what the next dollar buys us." Delivered as an explicit pre-mortem on the Keep path inside the Three-Path Model.',
  },
  {
    n: '02', name: 'Status Quo',
    headline: 'Doing nothing feels neutral.',
    line: 'It is never neutral.',
    evidence: [
      { tag: 'Cost', body: 'Over 40% of recurring costs auto-renewing without re-approval.' },
      { tag: 'Pricing', body: 'List prices set at launch, untouched through input-cost shifts.' },
      { tag: 'Growth', body: "Last year's channel split, still running, no reallocation mechanism." },
    ],
    fixLabel: 'Unlock move · Default flip',
    fix: 'Monthly review on every commitment over $5K via the Forward Capital Register. Decisions move from "running by default" to "running by active decision."',
  },
  {
    n: '03', name: 'Mental Accounting',
    headline: 'The right total can hide the wrong allocation.',
    line: 'A healthy P&L can carry an unhealthy mix.',
    evidence: [
      { tag: 'Cost', body: 'No unit economics by product. Cross-subsidies invisible.' },
      { tag: 'Pricing', body: 'Self-serve anchor used in enterprise. One segment funding another.' },
      { tag: 'Growth', body: 'Marketing as one line. No channel-level CM. No segment-level CAC.' },
    ],
    fixLabel: 'Unlock move · Isolation',
    fix: 'Product Line P&Ls with full cost allocation. Segment-level contribution margin. Channel-level CAC. The cross-subsidy map is the artifact that breaks this trap.',
  },
  {
    n: '04', name: 'Anchoring',
    headline: 'The first number set becomes the orbit.',
    line: 'Every later number gets pulled toward it.',
    evidence: [
      { tag: 'Cost', body: 'Burn anchored to post-raise plan, not current economics.' },
      { tag: 'Pricing', body: 'Enterprise pricing anchored to self-serve ARPU. Valuation anchored to last round.' },
      { tag: 'Growth', body: 'CAC targets anchored to pre-market-turn benchmarks.' },
    ],
    fixLabel: 'Unlock move · First-principles rebuild',
    fix: 'Quarterly model rebuild from current economics. Pricing Architecture Revisit re-grounds pricing from current win-rate and willingness-to-pay data, not the launch anchor.',
  },
  {
    n: '05', name: 'Loss Aversion',
    headline: 'The pain of admitting a loss is roughly twice the value of recovering the capital.',
    line: "Kahneman's coefficient. It applies to founders too.",
    evidence: [
      { tag: 'Pattern', body: 'Economically clear cut, six-plus months overdue.' },
      { tag: 'Voice', body: '"We can’t let them go." "We built this."' },
      { tag: 'Effect', body: 'Capital stays committed past the point the math supports.' },
    ],
    fixLabel: 'Unlock move · Three-Path explicit',
    fix: 'Keep / Kill / Restructure on identical metrics. The CEO stops comparing "keep" to "loss" and starts comparing "keep" to "choose."',
  },
  {
    n: '06', name: 'Certainty Illusion',
    headline: 'Polished reporting can feel like evidence when it is theater.',
    line: 'Confidence intervals do not survive a real downside case.',
    evidence: [
      { tag: 'Pattern', body: 'Runway as a single number. No downside case.' },
      { tag: 'Plan', body: 'Growth plan asserted with no active experiments testing key assumptions.' },
      { tag: 'History', body: 'Planning fallacy visible in prior forecast accuracy.' },
    ],
    fixLabel: 'Unlock move · Scenario + experiment + rolling check',
    fix: 'Three-scenario forecast plus Growth Experiment Register plus weekly actuals-vs-prediction. Uncertainty named. Assumptions listed. Experiments testing the most uncertain ones.',
  },
];

const timeline = [
  { day: 'Day 0', title: 'Engagement letter signed.', body: 'Kickoff agenda, data request list, 14-day calendar.' },
  { day: 'Day 3', title: 'Kickoff complete.', body: 'Data room set up. Week 1 interviews scheduled. Six Trap Interview booked.' },
  { day: 'Day 7', title: 'Decision Register draft.', body: 'Decision Register v1 (draft) for CEO review.' },
  { day: 'Day 14', title: 'Diagnostic delivered.', body: 'Five artifacts. 60-minute readout. Tier 1 guarantee triggered. Resolution decision made.' },
  { day: 'Day 21', title: 'Resolution kickoff.', body: 'Pricing Architecture Revisit scope confirmed. Growth Experiment Register draft reviewed. Founding Cohort eligibility determined.' },
  { day: 'Day 30', title: 'Unit Economics live.', body: 'Monthly refresh cycle installed. Product Line P&Ls drafted.' },
  { day: 'Day 45', title: 'Mid-Resolution.', body: 'Forward Capital Register delivered. Pricing hypotheses confirmed with CEO.' },
  { day: 'Day 60', title: 'Engine firing.', body: 'Pricing changes live with measurement. Two-plus growth experiments running. Three-Path Models on top 5 to 10 decisions. Scenario Forecast delivered.' },
  { day: 'Day 75', title: 'Board package drafted.', body: 'Bridge / Pivot / Raise model if applicable. Experiment scoring in market.' },
  { day: 'Day 90', title: 'Rhythm installed.', body: 'All 15 artifacts delivered. Decision Playbook handed off. Day-90 test evaluated. Partnership transition or clean exit.' },
  { day: 'Day 150', title: 'Realization check.', body: '30-minute call. Review execution progress on in-market experiments and pricing changes. No additional fee.' },
];

const catalog = [
  {
    color: 'find',
    tier: 'Find · Tier 1',
    count: '5 artifacts · 14 days',
    name: 'The Decision Diagnostic',
    promise: 'Names what your current capital is doing.',
    items: [
      { n: '01', name: 'Decision Register v1', desc: 'Every commitment over $5K/mo, every active pricing decision, every growth-spend channel, traced to its originating decision.' },
      { n: '02', name: 'Trapped Value Report', desc: 'Trapped value, in dollars, with recovery plans. The Tier 1 guarantee is measured against this artifact.' },
      { n: '03', name: 'Runway Truth Card', desc: 'Base, upside, downside runway with driver decomposition and named trigger points. Two pages.' },
      { n: '04', name: 'Six Trap Scorecard', desc: 'Per trap: LIVE / LATENT / NOT PRESENT across cost, pricing, growth, with specific evidence.' },
      { n: '05', name: 'Prioritized Action Register', desc: 'Top 5 forward calls to defend first, ranked by impact, sequenced by effort.' },
    ],
  },
  {
    color: 'install',
    tier: 'Install · Tier 2',
    count: '10 new · 76 days',
    name: 'The 90-Day Decision Resolution',
    promise: 'Installs the rhythm that defends every next call.',
    items: [
      { n: '06', name: 'Unit Economics Dashboard', desc: 'Live: CAC, LTV, payback, gross margin, contribution margin, by segment, cohort, channel.' },
      { n: '07', name: 'Product Line P&Ls', desc: 'Contribution margin by product line with full cost allocation and a cross-subsidy flow diagram.' },
      { n: '08', name: 'Forward Capital Register', desc: 'Every commitment over $5K/mo with explicit decision status, owner, and review cadence.' },
      { n: '09', name: 'Three-Path Models (5 to 10)', desc: 'Keep / Kill / Restructure on identical metrics, plus the trap stack and the unlock move.' },
      { n: '9a', name: 'Pricing Architecture Revisit', desc: 'Segment-by-segment audit, repricing hypotheses, list-to-realized leakage, in-market test plan.' },
      { n: '9b', name: 'Growth Experiment Register', desc: 'Named experiments inside the existing GTM envelope, with go and no-go triggers. Two live by Day 90.' },
      { n: '10', name: 'Scenario Forecast', desc: '18-month base / upside / downside with sensitivity to 3 to 5 key drivers. Breaks Certainty Illusion.' },
      { n: '11', name: 'Board Decision Package', desc: 'Board-ready deck: current state, decisions revisited, experiments running, forward plan, asks.' },
      { n: '12', name: 'Bridge / Pivot / Raise Model', desc: 'Capital plan for the most likely next funding event. Three financing paths with implications.' },
      { n: '13', name: 'Final Readout + Decision Playbook', desc: '90-day capstone, decision playbook, scheduled Day 150 realization check.' },
    ],
  },
  {
    color: 'run',
    tier: 'Run · Tier 3',
    count: '4 recurring · ongoing',
    name: 'The Decision Partnership',
    promise: 'Runs the rhythm on retainer.',
    items: [
      { n: '14', name: 'Monthly Decision Dashboard', desc: 'Rolling view: registers, Scorecard, Scenario Forecast, open decisions, active experiments. Decision and Experiment of the Month.' },
      { n: '15', name: 'Decision Journal', desc: 'Every major decision logged at the time it is made. Reviewed quarterly against actuals.' },
      { n: '16', name: 'Quarterly Strategic Review + Realized Value Cert', desc: 'Full model rebuild. Trap Scorecard refresh. Forecast reset. Realized Value certified per Appendix E.' },
      { n: '17', name: 'Validated Learning Log', desc: 'Hypothesis, test, outcome, decision. Every experiment, repricing, Three-Path produces entries.' },
    ],
  },
];

const roles = [
  { role: 'Portfolio CFO', mandate: 'Report what happened last quarter to the investors.', overlap: 'None. We brief them on what changed. They roll it into investor reporting.', why: 'Reporting captures what happened. Decision-First Finance defends what changes next. Different jobs.' },
  { role: 'Growth-stage fractional CFO', mandate: 'Stand up the finance function of a scaling company. Systems, forecasts, hires.', overlap: 'Limited. The standard scaling playbook does not touch the decision stack that caused the stall.', why: 'Stalled companies do not need more systems. They need trapped decisions resolved on math.' },
  { role: 'Turnaround firm', mandate: 'Triage, litigation, wind-down. Capital already gone.', overlap: 'None. We work pre-triage. By the time turnaround is right, most of the value has been lost.', why: 'Decisive Finance is the stop before the turnaround. It is how most of those matters do not have to happen.' },
  { role: 'Board members', mandate: 'Pattern-match from outside the business. Set direction. Govern.', overlap: 'Partial. We produce the artifact set the board needs to govern with confidence.', why: 'Boards cannot model every material decision with three paths. They can hold the CEO accountable to the ones we did.' },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How Decisive Finance names current capital, installs the decision rhythm, and runs it on retainer',
  description:
    'Find: a 14-day Diagnostic that names what your current capital is doing. Install: a 90-day Resolution that installs the rhythm that defends every next call and proves it in market. Run: an optional Partnership that runs the rhythm on retainer.',
  totalTime: 'P104D',
  step: loopSteps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.name,
    text: s.desc,
  })),
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  </Fragment>

  <!-- HERO -->
  <section class="hiw-hero">
    <div class="hiw-inner">
      <span class="eyebrow">How it works</span>
      <h1 class="hiw-h1">Find. <span class="hiw-accent">Install.</span> Run.</h1>
      <p class="hiw-lede">
        Three engagements, one architecture. <strong>Find</strong> names what your current capital is doing in 14 days. <strong>Install</strong> installs the rhythm that defends every next call, and proves it in market across 90 days. <strong>Run</strong> runs the rhythm on retainer. Most engagements start at Find, move into Install if Find earns it, and adopt Run only after Install is operating.
      </p>
      <div class="hero-cta-row">
        <a href={CALENDLY} class="btn btn-primary">Book a conversation</a>
        <a href="#tiers" class="btn btn-secondary">See the three tiers</a>
      </div>
      <div class="hiw-strip">
        <div><span class="hiw-num">14</span><span class="hiw-num-label">days to the Diagnostic readout</span></div>
        <div><span class="hiw-num">90</span><span class="hiw-num-label">days to the rhythm installed in market</span></div>
        <div><span class="hiw-num">6</span><span class="hiw-num-label">structural traps in the diagnostic</span></div>
        <div><span class="hiw-num">19</span><span class="hiw-num-label">deliverables, every one named and scoped</span></div>
      </div>
    </div>
  </section>

  <!-- THREE TIERS -->
  <section class="alt" id="tiers">
    <div class="container">
      <span class="section-eyebrow">The architecture</span>
      <h2>Three tiers. Three distinct promises.</h2>
      <p class="lede">
        Each tier is a stand-alone engagement with its own guarantee and deliverable spec. Tier 1 stops on its own merits. Tier 2 starts only if Tier 1 earns it. Tier 3 starts only after Tier 2 has installed what it is paid to operate.
      </p>
      <div class="hiw-triad">
        {tiers.map((t) => (
          <div class={`hiw-tier hiw-tier-${t.color}`}>
            <div class="hiw-tier-stamp">{t.stamp}</div>
            <div class="hiw-tier-name">{t.name}</div>
            <h3 class="hiw-tier-promise">{t.promise}</h3>
            <div class="hiw-tier-meta">
              {t.rows.map((r) => (
                <div class="hiw-tier-row">
                  <div class="hiw-tier-label">{r.label}</div>
                  <div class="hiw-tier-value" set:html={r.value} />
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DECISION LOOP -->
  <section>
    <div class="container">
      <span class="section-eyebrow">The canonical visual</span>
      <h2>Every business runs this loop. Most never close it.</h2>
      <p class="lede">
        The Decision Loop is the model behind everything we do. Six nodes, three rhythm rings. Decisions are committed (1, 2). Context drifts and the decision stays (3). A trap keeps it running (4). The Diagnostic surfaces it (5). The decision is revisited and tested in market (6). The loop closes.
      </p>
      <div class="hiw-loop-grid">
        <div class="hiw-loop-visual" aria-label="The Decision Loop, six nodes with three rhythm rings: weekly, monthly, quarterly">
          <svg viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg" role="img">
            <circle cx="250" cy="250" r="220" fill="none" stroke="#dde4e7" stroke-width="1" stroke-dasharray="3,5"/>
            <circle cx="250" cy="250" r="195" fill="none" stroke="#dde4e7" stroke-width="1" stroke-dasharray="3,5"/>
            <circle cx="250" cy="250" r="160" fill="none" stroke="#E5E1DA" stroke-width="2"/>
            <text x="250" y="22" text-anchor="middle" font-family="Inter" font-size="10" font-weight="600" fill="#214C52" letter-spacing="2" opacity="0.5">WEEKLY</text>
            <text x="250" y="46" text-anchor="middle" font-family="Inter" font-size="10" font-weight="600" fill="#214C52" letter-spacing="2" opacity="0.5">MONTHLY</text>
            <text x="250" y="64" text-anchor="middle" font-family="Inter" font-size="10" font-weight="600" fill="#214C52" letter-spacing="2" opacity="0.5">QUARTERLY</text>
            <g transform="translate(250, 90)"><circle r="32" fill="#182228"/><text y="-2" text-anchor="middle" font-family="Inter" font-size="9" font-weight="700" fill="#E3632B" letter-spacing="1">01</text><text y="10" text-anchor="middle" font-family="Inter" font-size="11" font-weight="700" fill="#FFFFFF">DECISION</text></g>
            <g transform="translate(389, 170)"><circle r="32" fill="#182228"/><text y="-2" text-anchor="middle" font-family="Inter" font-size="9" font-weight="700" fill="#E3632B" letter-spacing="1">02</text><text y="10" text-anchor="middle" font-family="Inter" font-size="9" font-weight="700" fill="#FFFFFF">COMMITMENT</text></g>
            <g transform="translate(389, 330)"><circle r="32" fill="#182228"/><text y="-2" text-anchor="middle" font-family="Inter" font-size="9" font-weight="700" fill="#E3632B" letter-spacing="1">03</text><text y="10" text-anchor="middle" font-family="Inter" font-size="11" font-weight="700" fill="#FFFFFF">DRIFT</text></g>
            <g transform="translate(250, 410)"><circle r="32" fill="#182228"/><text y="-2" text-anchor="middle" font-family="Inter" font-size="9" font-weight="700" fill="#E3632B" letter-spacing="1">04</text><text y="10" text-anchor="middle" font-family="Inter" font-size="11" font-weight="700" fill="#FFFFFF">TRAP</text></g>
            <g transform="translate(111, 330)"><circle r="32" fill="#E3632B"/><text y="-2" text-anchor="middle" font-family="Inter" font-size="9" font-weight="700" fill="#FFFFFF" letter-spacing="1">05</text><text y="10" text-anchor="middle" font-family="Inter" font-size="11" font-weight="700" fill="#FFFFFF">DIAGNOSE</text></g>
            <g transform="translate(111, 170)"><circle r="32" fill="#E3632B"/><text y="-2" text-anchor="middle" font-family="Inter" font-size="9" font-weight="700" fill="#FFFFFF" letter-spacing="1">06</text><text y="10" text-anchor="middle" font-family="Inter" font-size="11" font-weight="700" fill="#FFFFFF">REVISIT</text></g>
            <defs><marker id="arr-ink" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#182228"/></marker><marker id="arr-orange" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#E3632B"/></marker></defs>
            <path d="M 290,110 A 160,160 0 0 1 380,200" fill="none" stroke="#182228" stroke-width="2" marker-end="url(#arr-ink)"/>
            <path d="M 410,200 A 160,160 0 0 1 410,300" fill="none" stroke="#182228" stroke-width="2" marker-end="url(#arr-ink)"/>
            <path d="M 380,360 A 160,160 0 0 1 290,400" fill="none" stroke="#182228" stroke-width="2" marker-end="url(#arr-ink)"/>
            <path d="M 210,400 A 160,160 0 0 1 130,360" fill="none" stroke="#E3632B" stroke-width="3" marker-end="url(#arr-orange)"/>
            <path d="M 90,300 A 160,160 0 0 1 90,200" fill="none" stroke="#E3632B" stroke-width="3" marker-end="url(#arr-orange)"/>
            <path d="M 130,140 A 160,160 0 0 1 210,110" fill="none" stroke="#182228" stroke-width="2" marker-end="url(#arr-ink)"/>
          </svg>
        </div>
        <ol class="hiw-loop-list">
          {loopSteps.map((s, i) => (
            <li class={s.intervention ? 'intervention' : ''}>
              <div class="hiw-loop-num">{String(i + 1).padStart(2, '0')}</div>
              <div>
                <h4>{s.name}</h4>
                <p>{s.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="hiw-loop-caption">
        <strong>Reporting is a byproduct of the loop, not its product.</strong> The books still close. The statements still produce. They exist to feed the loop, not the other way around.
      </div>
    </div>
  </section>

  <!-- SIX TRAPS -->
  <section class="hiw-dark" id="traps">
    <div class="container">
      <span class="section-eyebrow">The proprietary IP</span>
      <h2 class="hiw-h2-light">Six structural patterns. Not founder failures.</h2>
      <p class="lede hiw-lede-light">
        The traps are cognitive patterns no founder alone, however sharp or diligent, can counteract while operating the business they created. The Diagnostic surfaces them so the next-dollar conversation happens on math rather than instinct. Most stalled companies are running three or four simultaneously.
      </p>
      <div class="hiw-traps-grid">
        {traps.map((t) => (
          <div class="hiw-trap">
            <div class="hiw-trap-index">Trap {t.n} · {t.name}</div>
            <h3>{t.headline}</h3>
            <p class="hiw-trap-line">{t.line}</p>
            <div class="hiw-trap-evidence">
              <div class="hiw-trap-ev-label">Where it shows up</div>
              <ul>
                {t.evidence.map((e) => (
                  <li><span class="hiw-tag">{e.tag}</span>{e.body}</li>
                ))}
              </ul>
            </div>
            <div class="hiw-trap-fix">
              <div class="hiw-trap-fix-label">{t.fixLabel}</div>
              <p>{t.fix}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THREE-PATH -->
  <section class="alt">
    <div class="container">
      <span class="section-eyebrow">The decision-level instrument</span>
      <h2>Every material decision modeled three ways.</h2>
      <p class="lede">
        A single recommendation is a point of view. Three modeled paths is a decision framework. Each Three-Path carries its own trap stack, an unlock move in dollars, a named owner, and a review date. Five to ten produced per Resolution.
      </p>
      <div class="hiw-path-grid">
        <div class="hiw-path">
          <div class="hiw-path-tag">Keep</div>
          <p>The current path, priced honestly. Full cost structure, opportunity cost, and the trap holding it in place. If the Keep column does not hurt to look at, the decision is not actually trapped.</p>
        </div>
        <div class="hiw-path featured">
          <div class="hiw-path-tag">Restructure</div>
          <p>The same problem re-sequenced. New pricing, new allocation, new scope, new ownership. Where most material decisions land, because most stalled decisions are directionally correct and structurally wrong.</p>
        </div>
        <div class="hiw-path">
          <div class="hiw-path-tag">Kill</div>
          <p>Full exit. Dollars returned. Opportunity cost recovered. Narrative cost named. Kill is on the page whether or not it is the answer, because a decision that cannot be killed has not actually been modeled.</p>
        </div>
      </div>
      <p class="lede" style="margin-top:32px;font-size:16px;color:var(--muted);">
        The Three-Path Register is the operating artifact. Five to ten Three-Paths is what a Resolution engagement produces in 90 days. Every entry includes the Six Trap stack (the two or three traps keeping the current path running) and the unlock move.
      </p>
    </div>
  </section>

  <!-- 104-DAY TIMELINE -->
  <section>
    <div class="container">
      <span class="section-eyebrow">The calendar</span>
      <h2>Diagnostic to rhythm installed.</h2>
      <p class="lede">
        One continuous arc. Tier 1 is Days 0 to 14. Tier 2 is Days 15 to 90. Tier 3 begins only after Tier 2 has installed what it is paid to operate. Day 150 is a 30-minute realization check, no fee.
      </p>
      <ol class="hiw-timeline">
        {timeline.map((m) => (
          <li>
            <div class="hiw-tl-day">{m.day}</div>
            <div class="hiw-tl-body"><strong>{m.title}</strong> {m.body}</div>
          </li>
        ))}
      </ol>
    </div>
  </section>

