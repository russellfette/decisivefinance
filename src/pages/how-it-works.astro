---
import BaseLayout from '../layouts/BaseLayout.astro';

const CALENDLY = 'https://calendly.com/russell-decisive/30min';

const title = 'How it works | Decisive Finance';
const description =
  'The Decisive Finance method, in detail. The Decision Loop, the Six Trap Diagnostic, three tiers with banded pricing, the Financial Rhythms cadence, and what stays out of scope. Glass box.';

const traps = [
  { name: 'Sunk Cost', body: 'The money already spent feels like it is voting. It is not. The next dollar is the only one that matters.' },
  { name: 'Status Quo', body: 'Doing nothing feels neutral. It is never neutral. Every week of unchanged spend is an active call.' },
  { name: 'Mental Accounting', body: 'The right total can hide the wrong allocation. A clean aggregate can mask a customer-funded cost sitting in the wrong bucket.' },
  { name: 'Anchoring', body: 'The first number set becomes the number the conversation orbits. The price you launched with is rarely the price today\'s market will hold.' },
  { name: 'Loss Aversion', body: 'The pain of admitting a commitment is not paying off is roughly twice the pleasure of recovering the cash. Most operating companies run under that coefficient for years without naming it.' },
  { name: 'Certainty Illusion', body: 'Polished reporting can feel like evidence when it is actually theater. Defending numbers with a story that quietly stopped being true is the most expensive habit a company carries.' },
];

const loopNodes = [
  { name: 'Decision', body: 'A hire, a product launch, a vendor sign, a pricing set, a channel spend commit. Made once, in a context.' },
  { name: 'Cost or commitment', body: 'The recurring P&L line or revenue-side commitment that decision created. Now living in the business.' },
  { name: 'Drift', body: 'The context that justified the decision changes. The decision stays. Compounding spend deploys against a context that no longer exists.' },
  { name: 'Trap', body: 'One of six cognitive biases keeps the decision running. Sunk cost. Status quo. Mental accounting. Anchoring. Loss aversion. Certainty illusion.' },
  { name: 'Diagnose', body: 'The Six Trap Diagnostic surfaces the gap. Decision Register. Recoverable Value Report. Six Trap Scorecard.' },
  { name: 'Defend', body: 'A Three-Path Model, a Pricing Architecture Revisit, or a Growth Experiment Register produces a new decision tested in market.' },
];

const tiers = [
  {
    label: 'Tier 1, Find',
    name: 'The Sellable-Numbers Scan',
    duration: '14 days',
    price: '$10,000 ($5M to $8M) / $15,000 ($8M to $25M) / $20,000 ($25M to $50M)',
    promise: 'Shows you your company the way a buyer will, in 14 days, on both sides of the equation.',
    body: 'The Decision Diagnostic engine, re-aimed for the exit. We normalize your numbers and run the Six Trap Diagnostic through the valuation lens, then hand you the dollarized findings: what diligence would knock off your number (buyer discounts, add-back and owner-dependence flags) and where the value expansion lives (pricing, mix, margin, concentration). A sale price is a multiple times earnings, and the Scan reads both numbers.',
    deliverables: 'Named artifacts. Three hours of owner time. Day 14 readout with the re-price read, the worth read, and the first three moves.',
    guarantee: 'At least 3x the Scan fee in owner-accepted value identified by Day 14, or you pay nothing. A strategic finding of equivalent materiality confirmed in writing also satisfies it. A Resolution signed within 7 days of the Day 14 readout credits the Scan fee 100%; past Day 21 the Scan fee is sunk.',
  },
  {
    label: 'Tier 2, Install',
    name: 'The 90-Day Decision Resolution',
    duration: '90 days',
    price: '$30,000 ($5M to $8M) / $45,000 ($8M to $25M) / $60,000 ($25M to $50M)',
    promise: 'Makes the numbers believable and decision-grade, and proves it in market across 90 days.',
    body: 'A 90-day engagement that installs the decision rhythm and the Financial Rhythms cadence. Material calls are defended with math, taken live (pricing moves, a product line restructured, a cost cut), and scored against what actually happened. The close tightens, the add-backs and owner-dependence flags get resolved, and the trailing-twelve clock starts running on numbers a buyer can trust.',
    deliverables: 'Named artifacts across three phases (Find It, Model It, Run It). Approximately 15 to 18 hours of owner time across the 90 days.',
    guarantee: 'The rhythm installed and in market by Day 90, with at least two live decisions measured against outcomes, or full refund. The owner keeps every artifact produced.',
  },
  {
    label: 'Tier 3, Run',
    name: 'The Exit-Value Partnership',
    duration: '12 to 24 months, monthly retainer',
    price: '$7,500 ($5M to $8M) / $10,000 ($8M to $25M) / $12,500 ($25M to $50M) per month, plus 5% on confirmed Realized Value validated quarterly. Fees tied to value created, never to the deal.',
    promise: 'Builds the value and the trend a buyer will pay for, across the 12 to 24 months before market.',
    body: 'Ongoing operation of the decision rhythm built in the Resolution, plus a quarterly re-valuation against the engagement baseline so the owner watches the number move. Weekly decision cadence. Monthly deep dive. Quarterly model rebuild. Pricing and growth experiments running inside a defined envelope. The promise: a more valuable company, and the numbers to prove it. The cadence is Financial Rhythms™.',
    deliverables: 'Recurring artifacts plus on-demand modeling inside a specified monthly envelope. Two to three hours per month of owner time, plus four to six per quarter for the Strategic Review.',
    guarantee: 'Realized Value validated quarterly against the engagement-letter methodology, not opinion. No fee is ever calculated from the transaction or contingent on a closing. We are the one advisor in the deal who is not paid on the deal.',
  },
];

const artifactsT1 = [
  { num: '01', name: 'Decision Register v1', body: 'Every recurring cost over $5,000 per month, every active pricing decision, every growth-spend channel, every product-line commitment, traced back to the originating decision. PDF plus live spreadsheet.' },
  { num: '02', name: 'Recoverable Value Report', body: 'The artifact the Tier 1 guarantee is measured against. Per opportunity: dollar amount annualized, source decision, trap category, effort to recover, recovery plan narrative, evidence, recommended move.' },
  { num: '03', name: 'Cash Flow Truth Card', body: '2-page PDF. Base, upside, and downside cash position. Driver decomposition. The three variables most likely to move the number. Trigger points.' },
  { num: '04', name: 'Six Trap Scorecard', body: 'For each of the six traps: LIVE, LATENT, or NOT PRESENT, across cost, pricing, and growth. With evidence and value at stake. One-page card plus four-page backing detail.' },
  { num: '05', name: 'Prioritized Action Register', body: 'Top five next calls to defend first, ranked by impact and sequenced by effort. At least one pricing move and one growth-motion move if either is live in the Scorecard.' },
];

const artifactsT2 = [
  { num: '06', name: 'Contribution Margin Dashboard', body: 'Live contribution margin by product line, customer segment, and channel. Cost allocation visible. Auto-refreshes on monthly close.' },
  { num: '07', name: 'Product Line P&Ls', body: 'Contribution margin by product line with full cost allocation. Plus the cross-subsidy flow diagram nobody had.' },
  { num: '08', name: 'Forward Capital Register', body: 'Decision Register extended. Every cost above $5,000 per month, every active pricing tier, every growth channel commitment carries an explicit decision status, an owner, and a standing review cadence.' },
  { num: '09', name: 'Three-Path Models', body: 'Five to ten per engagement. For each trapped decision: Keep, Kill, Restructure modeled on identical metrics, with the trap stack and the recommended move.' },
  { num: '10', name: 'Pricing Architecture Revisit', body: 'Segment-by-segment pricing audit. Repricing hypotheses. List-to-realized leakage analysis. Discount discipline map. In-market test plan with measurement.' },
  { num: '11', name: 'Growth Experiment Register', body: 'Three named experiments inside the existing go-to-market envelope. At least two live in market by Day 90. Each with hypothesis, target metric, budget, sample size, go and no-go triggers.' },
  { num: '12', name: 'Scenario Forecast', body: 'Rolling base, upside, and downside model with sensitivity to three to five key drivers. Trigger points. Weekly actuals-vs-prediction reconciliation structure.' },
  { num: '13', name: 'Owner Decision Package', body: 'Fully populated summary deck. Current state, decisions defended, experiments running, forward plan, asks. Reusable template delivered separately.' },
  { num: '14', name: 'Capital and Structure Model', body: 'Financial model for the most likely near-term capital event (debt refinance, product-line exit, ownership change). Three paths with documented implications.' },
  { num: '15', name: 'Final Readout and Decision Playbook', body: '90-day capstone plus forward playbook. The owner can run the loop without us.' },
];

const artifactsT3 = [
  { num: '16', name: 'Monthly Decision Dashboard', body: 'Rolling view of all registers, the Scorecard, the Scenario Forecast, open decisions, active experiments. Decision of the Month. Experiment of the Month.' },
  { num: '17', name: 'Decision Journal', body: 'Log of every major decision at the time it is made. Rationale, confidence, expected outcome. Reviewed quarterly against actuals.' },
  { num: '18', name: 'Quarterly Strategic Review', body: 'Full model rebuild from current economics. Trap Scorecard refresh. Forecast reset. Pricing architecture revisit. Realized Value certification.' },
  { num: '19', name: 'Validated Learning Log', body: 'Hypothesis, test, outcome, decision. Every experiment, every repricing, every Three-Path recommendation generates entries.' },
];

const timeline = [
  { day: 'Day 0', body: 'Engagement letter signed. Kickoff agenda, data request list, 14-day calendar.' },
  { day: 'Day 3', body: 'Kickoff complete. Data room set up. Six Trap Interview booked.' },
  { day: 'Day 7', body: 'Decision Register draft ready for owner review.' },
  { day: 'Day 14', body: 'Scan package delivered. Named artifacts. 60-minute readout with the re-price read and the worth read. Tier 1 guarantee triggered. Resolution decision made.' },
  { day: 'Day 21', body: 'Resolution kickoff. Pricing Architecture Revisit scope confirmed. Growth Experiment Register draft reviewed.' },
  { day: 'Day 30', body: 'Contribution Margin Dashboard live. Monthly refresh cycle installed. Product Line P&Ls in draft.' },
  { day: 'Day 45', body: 'Mid-Resolution milestone. Forward Capital Register delivered. Pricing hypotheses confirmed.' },
  { day: 'Day 60', body: 'Rhythm running. Pricing changes live with measurement. Two growth experiments in market. Three-Path Models on top decisions.' },
  { day: 'Day 75', body: 'Owner Decision Package drafted. Capital and Structure Model if applicable.' },
  { day: 'Day 90', body: 'Final Readout. Artifacts delivered. Decision Playbook handed off. Day 90 rhythm-installed test evaluated.' },
  { day: 'Day 150', body: 'Realization check. 30-minute standing call to score in-market experiments and pricing changes. No additional fee.' },
];

const outOfScope = [
  'Ad-hoc modeling of unrelated transactions (acquisition offers, side investments, secondary sales).',
  'Bookkeeping cleanup beyond what the artifacts require. If the general ledger cannot produce Artifact 1, we quote cleanup as a separate fixed-fee phase.',
  'Board-meeting facilitation. The Owner Decision Package is a deliverable; running the meeting is not.',
  'HR or legal consulting on specific reduction-in-force cases. Three-Path on a headcount decision is in scope; severance math, employment counsel, and manager coaching are out.',
  'Capital introductions or transaction advisory. The Capital and Structure Model is in scope; making introductions or sitting in negotiations is not.',
  'Interim controller or FP&A hiring.',
  'Pricing architecture for net-new products or net-new channels. Net-new design is a change order with its own scope and fee.',
  'Growth experiments in channels the company is not already operating in.',
];
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="hero-inner">
      <span class="eyebrow">Method &middot; Glass box</span>
      <h1>How Decisive Finance works.</h1>
      <p class="hero-subhead">
        The Decision Loop, the Six Trap Diagnostic, three tiers with banded pricing, the Financial Rhythms cadence, and what stays out of scope. <span class="dollar">No black box.</span>
      </p>
      <div class="hero-cta-row">
        <a href={CALENDLY} class="btn btn-primary">Book 30 minutes with Russ</a>
        <a href="#tiers" class="btn btn-secondary">Jump to tiers</a>
      </div>
      <div class="rally">FIND. INSTALL. RUN.</div>
    </div>
  </section>

  <section id="loop">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">The canonical visual</span>
        <h2>The Decision Loop.</h2>
        <p class="lede">
          An operating company is a chain of decisions made in a context, generating commitments that outlast the context that justified them. The Decisive Finance method is one closed loop: every material decision moves through six nodes, and our intervention sits at nodes 5 and 6, operated recurrently through the Financial Rhythms cadence rings (weekly, monthly, quarterly).
        </p>
      </div>
      <div class="loop-grid">
        {loopNodes.map((node, i) => (
          <div class="loop-node">
            <div class="loop-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="loop-name">{node.name}</div>
            <p>{node.body}</p>
          </div>
        ))}
      </div>
      <div class="container-narrow">
        <p class="category-pull">
          Other finance functions live in nodes 1 to 4 and never close the loop. Reporting describes; forecasting projects; budgeting allocates. None of those activities defend the next call. We diagnose at node 5 and defend forward at node 6, in a recurring rhythm, until the company is the loop.
        </p>
      </div>
    </div>
  </section>

  <section id="traps" class="traps">
    <div class="container">
      <span class="section-eyebrow">The proprietary IP</span>
      <h2>The Six Trap Diagnostic&trade;</h2>
      <p class="lede" style="color: rgba(255,255,255,0.88);">
        A 90-minute structured interview plus a standardized data pull, executed in Week 1. The traps are not failures of the owner. They are structural cognitive patterns no owner alone, however capable, can counteract while operating the business they built. The protocol exists to surface them so the next-call conversation can happen on math rather than on instinct.
      </p>
      <div class="trap-grid">
        {traps.map((trap, i) => (
          <div class="trap-card">
            <div class="trap-num">Trap {String(i + 1).padStart(2, '0')}</div>
            <div class="trap-name">{trap.name}</div>
            <p>{trap.body}</p>
          </div>
        ))}
      </div>
      <div class="traps-footer">
        Two views are produced. <strong>Scorecard view</strong> at the business level: which traps are LIVE, LATENT, or NOT PRESENT across cost, pricing, and growth. <strong>Trap Stack view</strong> at the decision level: which two or three traps are keeping each trapped decision running. The Scorecard ships in the Diagnostic. The Trap Stack appears inside every Three-Path Model, every Pricing Architecture Revisit, and every Growth Experiment Register entry.
      </div>
    </div>
  </section>

  <section id="tiers" class="alt">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Three tiers, three promises</span>
        <h2>Find. Install. Run.</h2>
        <p class="lede">
          Each tier carries a distinct promise. Find shows you your company the way a buyer will in 14 days. Install makes the numbers believable and decision-grade across 90 days. Run builds the value and the trend a buyer will pay for across the months before market. Pricing is banded by revenue: $5M to $8M / $8M to $25M / $25M to $50M. Below $5M in revenue, refer out; the guarantee math does not hold.
        </p>
      </div>
      <div class="tier-list">
        {tiers.map((tier) => (
          <div class="tier-row">
            <div class="tier-row-label">
              <span class="tier-row-eyebrow">{tier.label}</span>
              <h3>{tier.name}</h3>
              <div class="tier-row-meta"><span>{tier.duration}</span><span class="dot">&middot;</span><span>{tier.price}</span></div>
            </div>
            <div class="tier-row-body">
              <p class="tier-promise"><strong>{tier.promise}</strong></p>
              <p>{tier.body}</p>
              <p class="tier-meta-line"><strong>Deliverables.</strong> {tier.deliverables}</p>
              <p class="tier-meta-line tier-guarantee-line"><strong>Guarantee.</strong> {tier.guarantee}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="artifacts" class="artifacts">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">What we deliver</span>
        <h2>Named artifacts.</h2>
        <p class="lede">
          Every deliverable has a name, a definition, an output spec, and an owner. The catalog below is the full deliverables list across all three tiers. If a deliverable is not on this list, it is a change order, not a favor.
        </p>
      </div>
      <h3 class="artifact-group-h3">The Scan, 14 days, 5 artifacts</h3>
      <div class="artifact-grid">
        {artifactsT1.map((a) => (
          <div class="artifact">
            <div class="num">{a.num}</div>
            <div>
              <h4>{a.name}</h4>
              <p>{a.body}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="lede" style="margin-top: 16px;">
        To see what artifact 02 looks like for a company your size, <a href="/resources/recovery-checklist/">preview the Recoverable Value Report</a>. Four minutes, three questions.
      </p>
      <h3 class="artifact-group-h3">Resolution, Day 15 to Day 90, 10 artifacts</h3>
      <div class="artifact-grid">
        {artifactsT2.map((a) => (
          <div class="artifact">
            <div class="num">{a.num}</div>
            <div>
              <h4>{a.name}</h4>
              <p>{a.body}</p>
            </div>
          </div>
        ))}
      </div>
      <h3 class="artifact-group-h3">Partnership, ongoing, 4 recurring artifacts</h3>
      <div class="artifact-grid">
        {artifactsT3.map((a) => (
          <div class="artifact">
            <div class="num">{a.num}</div>
            <div>
              <h4>{a.name}</h4>
              <p>{a.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="timeline">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Owner deliverable timeline</span>
        <h2>What the owner gets, day by day.</h2>
        <p class="lede">
          The schedule is a contract. The owner knows what lands when. We know what we owe. Owner time across the full 90 days runs about 18 to 21 hours, including the Diagnostic.
        </p>
      </div>
      <ol class="timeline-list">
        {timeline.map((t) => (
          <li class="timeline-item">
            <div class="timeline-day">{t.day}</div>
            <div class="timeline-body">{t.body}</div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="rhythms" class="alt">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">The operating system</span>
        <h2>Financial Rhythms&trade;.</h2>
        <p class="lede">
          The cadence that runs the loop after the 90 days end. Three concentric rings. Weekly is decision cadence. Monthly is deep dive. Quarterly is model rebuild. The rings keep running whether we are in the chair or not.
        </p>
        <ul class="rhythm-list">
          <li><strong>Weekly.</strong> Open-decision review. Active experiment scoring against go and no-go triggers. Forward Capital Register movement. 30 minutes.</li>
          <li><strong>Monthly.</strong> Decision Dashboard refresh. Decision of the Month and Experiment of the Month. Validated Learning Log entries. Variance narrative. 90 minutes.</li>
          <li><strong>Quarterly.</strong> Strategic Review. Full model rebuild from current economics. Trap Scorecard refresh. Forecast reset. Pricing architecture revisit. Realized Value certification. Four to six hours.</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="value">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">The Tier 3 success fee</span>
        <h2>Realized Value, validated quarterly.</h2>
        <p class="lede">
          The 5% Partnership fee invoices only against confirmed Realized Value, defined in three categories. Each category has a quantification method written into the engagement letter. Russ does not get to grade his own homework: every category requires an owner signature against the methodology, not an opinion. No fee is ever calculated from the transaction or contingent on a closing. We are the one advisor in the deal who is not paid on the deal.
        </p>
        <ul class="value-list">
          <li><strong>In-market pricing or volume changes with measurement.</strong> Repricing live across at least one full cycle. Volume change attributable to a specific experiment. Measured in revenue uplift annualized at the new rate, with the comparison period explicit.</li>
          <li><strong>Capacity reallocation booked to a downstream metric.</strong> Engineering, marketing, or sales capacity moved off a low-margin line and onto a higher-margin one. Measured by the contribution margin delta over the next two quarters.</li>
          <li><strong>Capital structure or product-line changes with documented economic delta.</strong> Debt restructured. Product line exited. Ownership structure reset. Measured by the discount-rate-adjusted present-value delta to the company.</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="scope" class="alt">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Where the fence is</span>
        <h2>What we do not do.</h2>
        <p class="lede">
          Glass box means the boundary is named. Below is the list of common asks that are explicitly out of the 90-day scope. Each can be addressed via a change order with its own scope, price, and acceptance criteria. None of them dilute the base guarantee or extend the 90-day clock.
        </p>
        <ul class="scope-list">
          {outOfScope.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="close-section">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow" style="color: var(--orange);">The 14-day Scan</span>
        <h2>Read the guarantee, then book 30 minutes.</h2>
        <p class="lede" style="color: rgba(255,255,255,0.8);">
          30 minutes with Russ. No pitch. You leave knowing what a buyer would re-price. At least 3x the Scan fee in owner-accepted value identified in 14 days, or you pay nothing. We don't audit the past. We make the company worth believing.
        </p>
        <div class="hero-cta-row">
          <a href={CALENDLY} class="btn btn-primary">Book 30 minutes with Russ</a>
          <a href="/guarantee" class="btn btn-secondary">Read Guarantee</a>
        </div>
        <p class="close-frame">Decide from the numbers. Prove it in the cash.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .loop-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin: 50px 0 36px;
  }
  .loop-node {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 26px 24px;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .loop-node:hover {
    transform: translateY(-2px);
    border-color: var(--green);
  }
  .loop-num {
    font-family: Inter, sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: var(--orange);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .loop-name {
    font-family: Inter, sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.015em;
    margin-bottom: 10px;
  }
  .loop-node p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0;
  }

  .tier-list {
    margin-top: 50px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .tier-row {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 36px;
    padding: 36px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .tier-row:last-child { border-bottom: none; }
  .tier-row-eyebrow {
    font-family: Inter, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 8px;
    display: block;
  }
  .tier-row-label h3 {
    font-family: Inter, sans-serif;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 10px;
  }
  .tier-row-meta {
    font-family: Inter, sans-serif;
    font-size: 14px;
    color: var(--muted);
    display: flex;
    gap: 8px;
    margin-bottom: 8px;
  }
  .tier-row-meta .dot { opacity: 0.5; }
  .tier-row-body p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
    margin-bottom: 14px;
  }
  .tier-row-body .tier-promise {
    font-size: 19px;
    color: var(--green);
    font-style: italic;
    margin-bottom: 14px;
  }
  .tier-row-body .tier-meta-line {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .tier-row-body .tier-meta-line strong {
    color: var(--ink);
  }
  .tier-guarantee-line {
    background: rgba(33, 76, 82, 0.06);
    border-left: 3px solid var(--green);
    padding: 12px 16px;
    border-radius: 0 8px 8px 0;
  }

  .artifact-group-h3 {
    font-family: Inter, sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--orange);
    margin-top: 56px;
    margin-bottom: 20px;
  }
  .artifact-group-h3:first-of-type { margin-top: 36px; }

  .timeline-list {
    list-style: none;
    margin: 50px 0 0;
    padding: 0;
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    padding: 22px 0;
    border-top: 1px solid var(--hairline);
    align-items: baseline;
  }
  .timeline-item:last-child {
