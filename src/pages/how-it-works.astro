---
// /how-it-works/ , Decisive Finance methodology page
// Canon: Phrase Book v2.5.2, Manifesto v2.4, Service Architecture Blueprint v1.10
// Single-file Astro page. Inline CSS scoped via Astro. No external component dependencies.
const calendly = "https://calendly.com/russell-decisive/30min";
const pageTitle = "How it works | Find. Install. Run. | Decisive Finance";
const pageDescription =
  "Decision-First Finance with the methodology in view. A 14-day Diagnostic, a 90-day Resolution, an optional Partnership. Six traps named. Nineteen artifacts produced.";
const pageUrl = "https://decisive.finance/how-it-works/";
const ogImage = "https://decisive.finance/og-default.png";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={pageUrl} />
    <!-- OpenGraph -->
    <meta property="og:site_name" content="Decisive Finance" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Decisive Finance" href="/blog/rss.xml" />

    <!-- Organization JSON-LD (page-level, v2.5 canon) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Decisive Finance",
      "url": "https://decisive.finance",
      "logo": "https://decisive.finance/logo.png",
      "image": "https://decisive.finance/og-default.png",
      "description": "Decision-First Finance for venture-backed companies sitting on the growth-versus-runway call. Guaranteed 3x your Diagnostic fee in trapped value, in 14 days. Typical 5x to 10x.",
      "founder": {
        "@type": "Person",
        "name": "Russell Fette",
        "jobTitle": "Founder, Decisive Finance",
        "url": "https://linkedin.com/in/russellfette",
        "sameAs": ["https://linkedin.com/in/russellfette"]
      },
      "address": { "@type": "PostalAddress", "addressCountry": "US" },
      "email": "russell@decisive.finance",
      "sameAs": ["https://linkedin.com/in/russellfette"],
      "areaServed": { "@type": "Country", "name": "United States" },
      "serviceType": [
        "Decision Diagnostic",
        "90-Day Decision Resolution",
        "Decision Partnership",
        "Fractional CFO for Venture-Backed Technology Companies"
      ],
      "priceRange": "$7,500 to $30,000",
      "knowsAbout": [
        "Decision-First Finance",
        "Six Trap Diagnostic",
        "Financial Rhythms",
        "Trapped value recovery",
        "Unit economics for venture-backed SaaS",
        "Board-ready scenario forecasting"
      ]
    })} />

    <!-- HowTo JSON-LD (Decision Loop, v1.10) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How Decisive Finance names trapped value, installs the rhythm, and runs it on retainer",
      "description": "Find: a 14-day Diagnostic that names what your current capital is doing. Install: a 90-day Resolution that installs the rhythm and proves it in market. Run: an optional Partnership that runs the rhythm on retainer.",
      "totalTime": "P104D",
      "step": [
        { "@type": "HowToStep", "name": "Decision", "text": "A hire, a product launch, a vendor sign, a pricing set, a channel spend commit." },
        { "@type": "HowToStep", "name": "Commitment", "text": "The recurring P&L line or revenue-side commitment that decision creates." },
        { "@type": "HowToStep", "name": "Drift", "text": "Assumptions change. The decision stays. Context moves; capital does not." },
        { "@type": "HowToStep", "name": "Trap", "text": "One of six cognitive biases keeps the original decision running by default." },
        { "@type": "HowToStep", "name": "Diagnose", "text": "The Six Trap Diagnostic surfaces the gap on math, not instinct. Our work begins." },
        { "@type": "HowToStep", "name": "Defend", "text": "Three-Path Model, Pricing Architecture Revisit, or Growth Experiment Register produces a new decision tested in market." }
      ]
    })} />

    <style>
      :root {
        --ink: #182228;
        --orange: #E3632B;
        --teal: #214C52;
        --cream: #F5F2ED;
        --white: #FFFFFF;
        --muted: #5C6B72;
        --hairline: #E5E1DA;
        --grey: #F0EDE6;
        --width-prose: 760px;
        --width-hero: 920px;
        --width-content: 1180px;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: 'Inter', sans-serif;
        color: var(--ink);
        background: var(--cream);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      nav.nav { background: var(--cream); border-bottom: 1px solid var(--hairline); padding: 22px 32px; }
      .nav-inner { max-width: var(--width-content); margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
      .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 18px; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; }
      .brand-mark { width: 14px; height: 14px; background: var(--orange); border-radius: 50%; display: inline-block; }
      .nav-links { display: flex; gap: 28px; align-items: center; font-size: 15px; }
      .nav-links a { color: var(--ink); text-decoration: none; font-weight: 500; }
      .nav-links a:hover { color: var(--orange); }
      .btn { display: inline-block; padding: 12px 22px; border-radius: 6px; font-weight: 600; font-size: 15px; text-decoration: none; transition: all 0.15s ease; border: 1.5px solid transparent; }
      .btn-primary { background: var(--orange); color: var(--white); }
      .btn-primary:hover { background: #c8531e; }
      .btn-secondary { background: transparent; color: var(--ink); border-color: var(--ink); }
      .btn-secondary:hover { background: var(--ink); color: var(--white); }

      section.section { padding: 96px 32px; }
      section.section.alt { background: var(--white); }
      section.section.dark { background: var(--ink); color: var(--white); }
      .inner { margin: 0 auto; }
      .inner.prose { max-width: var(--width-prose); }
      .inner.hero { max-width: var(--width-hero); }
      .inner.content { max-width: var(--width-content); }

      .eyebrow { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.16em; color: var(--orange); margin-bottom: 18px; }
      h1.page-title { font-size: clamp(48px, 6.4vw, 84px); font-weight: 900; letter-spacing: -0.04em; line-height: 1.02; margin: 0 0 28px; color: var(--ink); max-width: var(--width-hero); }
      h1.page-title .accent { color: var(--orange); }
      p.lede { font-size: clamp(19px, 1.9vw, 22px); line-height: 1.5; color: var(--muted); margin: 0 0 36px; max-width: var(--width-prose); font-weight: 400; }
      p.lede strong { color: var(--ink); font-weight: 600; }
      h2.section-title { font-size: clamp(34px, 4.2vw, 52px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.08; margin: 0 0 18px; max-width: var(--width-hero); }
      p.section-sub { font-size: 18px; color: var(--muted); line-height: 1.55; max-width: var(--width-prose); margin: 0 0 48px; }
      .section.dark .section-sub { color: rgba(255,255,255,0.78); }

      .hero-section { padding-top: 100px; padding-bottom: 48px; }
      .hero-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--hairline); max-width: var(--width-content); }
      .hero-strip > div { font-size: 15px; color: var(--muted); }
      .hero-num { display: block; font-size: 44px; font-weight: 800; color: var(--ink); letter-spacing: -0.03em; line-height: 1; margin-bottom: 8px; }

      .triad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 16px; }
      .tier-card { background: var(--white); border: 1px solid var(--hairline); border-radius: 16px; padding: 40px 36px; display: flex; flex-direction: column; position: relative; overflow: hidden; }
      .tier-card::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--orange); }
      .tier-card.install::before { background: var(--teal); }
      .tier-card.run::before { background: var(--ink); }
      .tier-stamp { font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--orange); margin-bottom: 6px; }
      .tier-card.install .tier-stamp { color: var(--teal); }
      .tier-card.run .tier-stamp { color: var(--ink); }
      .tier-name { font-size: 14px; color: var(--muted); margin-bottom: 18px; }
      .tier-promise { font-size: 22px; font-weight: 700; line-height: 1.3; margin: 0 0 24px; letter-spacing: -0.015em; color: var(--ink); }
      .tier-meta { border-top: 1px solid var(--hairline); padding-top: 22px; display: grid; gap: 14px; }
      .tier-meta-row { display: grid; grid-template-columns: 110px 1fr; font-size: 14.5px; line-height: 1.45; }
      .tier-meta-label { color: var(--muted); font-weight: 500; text-transform: uppercase; font-size: 11.5px; letter-spacing: 0.1em; padding-top: 2px; }
      .tier-meta-value { color: var(--ink); font-weight: 500; }
      .tier-meta-value strong { font-weight: 700; }
      .triad-caption { margin-top: 36px; text-align: center; color: var(--muted); font-size: 16px; max-width: var(--width-prose); margin-left: auto; margin-right: auto; }

      .loop-wrapper { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
      .loop-visual { aspect-ratio: 1 / 1; position: relative; }
      .loop-svg { width: 100%; height: 100%; }
      .loop-list ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
      .loop-list li { display: grid; grid-template-columns: 36px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--hairline); }
      .loop-list li:last-child { border-bottom: none; }
      .loop-num-circle { width: 32px; height: 32px; border-radius: 50%; background: var(--ink); color: var(--white); font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
      .loop-list li.intervention .loop-num-circle { background: var(--orange); }
      .loop-step-name { font-size: 17px; font-weight: 700; color: var(--ink); margin: 0 0 4px; letter-spacing: -0.01em; }
      .loop-step-desc { font-size: 14.5px; color: var(--muted); margin: 0; line-height: 1.45; }
      .loop-caption { margin-top: 48px; padding: 28px 32px; background: var(--cream); border-left: 4px solid var(--orange); color: var(--ink); font-size: 16px; line-height: 1.55; max-width: var(--width-prose); }
      .loop-caption strong { color: var(--orange); }

      .traps-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 16px; }
      .trap-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12); border-radius: 14px; padding: 32px 30px; }
      .trap-index { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: var(--orange); margin-bottom: 10px; }
      .trap-name { font-size: 26px; font-weight: 800; color: var(--white); margin: 0 0 12px; letter-spacing: -0.02em; }
      .trap-line { font-size: 16px; color: rgba(255,255,255,0.85); font-style: italic; margin: 0 0 22px; line-height: 1.45; }
      .trap-evidence { margin-bottom: 18px; }
      .trap-evidence-label { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.55); margin-bottom: 8px; }
      .trap-evidence-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; font-size: 14px; color: rgba(255,255,255,0.82); line-height: 1.45; }
      .trap-evidence-list li { padding-left: 70px; position: relative; }
      .trap-evidence-list li span.tag { position: absolute; left: 0; top: 2px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--orange); }
      .trap-fix { margin-top: 18px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.12); }
      .trap-fix-label { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--orange); margin-bottom: 6px; }
      .trap-fix p { margin: 0; font-size: 14.5px; color: rgba(255,255,255,0.9); line-height: 1.5; }

      .path-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 16px; }
      .path-card { background: var(--white); border: 1px solid var(--hairline); border-radius: 14px; padding: 36px 32px; }
      .path-card.featured { border-color: var(--orange); box-shadow: 0 0 0 2px rgba(227,99,43,0.15); }
      .path-tag { display: inline-block; padding: 4px 12px; border-radius: 999px; background: var(--grey); color: var(--ink); font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 16px; }
      .path-card.featured .path-tag { background: var(--orange); color: var(--white); }
      .path-card p { margin: 0; font-size: 15.5px; line-height: 1.55; color: var(--ink); }
      .path-caption { margin-top: 36px; color: var(--muted); font-size: 15.5px; line-height: 1.55; max-width: var(--width-prose); }

      .timeline { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 0; border-left: 2px solid var(--hairline); }
      .timeline li { display: grid; grid-template-columns: 140px 1fr; gap: 28px; padding: 22px 0 22px 28px; border-bottom: 1px solid var(--hairline); margin-left: -2px; border-left: 2px solid transparent; transition: border-color 0.15s; }
      .timeline li:hover { border-left-color: var(--orange); }
      .timeline li:last-child { border-bottom: none; }
      .tl-window { font-weight: 700; color: var(--orange); font-size: 14px; letter-spacing: 0.04em; text-transform: uppercase; padding-top: 2px; }
      .tl-body { font-size: 15.5px; line-height: 1.55; color: var(--ink); }
      .tl-body strong { display: block; margin-bottom: 4px; font-weight: 700; }

      .catalog-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 16px; }
      .catalog-col { background: var(--white); border: 1px solid var(--hairline); border-radius: 14px; padding: 32px 28px; }
      .catalog-col-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--hairline); }
      .catalog-col-tier { font-size: 11.5px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--orange); }
      .catalog-col-count { font-size: 13px; color: var(--muted); font-weight: 500; }
      .catalog-col-name { font-size: 22px; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 4px; }
      .catalog-col-promise { font-size: 13.5px; color: var(--muted); margin: 0 0 22px; line-height: 1.45; font-style: italic; }
      .artifact-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
      .artifact-list li { display: grid; grid-template-columns: 28px 1fr; gap: 12px; align-items: start; }
      .artifact-num { font-size: 12px; font-weight: 700; color: var(--orange); background: rgba(227,99,43,0.08); border-radius: 4px; padding: 3px 0; text-align: center; min-width: 28px; }
      .artifact-name { font-weight: 600; color: var(--ink); font-size: 14.5px; line-height: 1.4; }
      .artifact-desc { color: var(--muted); font-size: 13px; line-height: 1.4; margin-top: 2px; }

      .diff-table { background: var(--white); border: 1px solid var(--hairline); border-radius: 14px; overflow: hidden; }
      .diff-head, .diff-row { display: grid; grid-template-columns: 1fr 1.4fr 1.4fr 1.6fr; padding: 18px 24px; gap: 20px; align-items: start; }
      .diff-head { background: var(--ink); color: var(--white); font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
      .diff-row { border-top: 1px solid var(--hairline); font-size: 14.5px; line-height: 1.45; }
      .diff-row:nth-child(odd) { background: var(--cream); }
      .diff-row strong { color: var(--ink); font-weight: 700; display: block; margin-bottom: 4px; }

      .cta-section { background: var(--ink); color: var(--white); padding: 96px 32px; text-align: center; }
      .cta-title { font-size: clamp(36px, 4.4vw, 56px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.08; margin: 0 0 18px; color: var(--white); }
      .cta-sub { font-size: 18px; color: rgba(255,255,255,0.78); max-width: var(--width-prose); margin: 0 auto 36px; line-height: 1.55; }
      .cta-buttons { display: inline-flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
      .cta-section .btn-secondary { color: var(--white); border-color: rgba(255,255,255,0.4); }
      .cta-section .btn-secondary:hover { background: var(--white); color: var(--ink); }

      footer { background: var(--ink); color: rgba(255,255,255,0.7); padding: 36px 32px; border-top: 1px solid rgba(255,255,255,0.1); }
      .footer-inner { max-width: var(--width-content); margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 18px; font-size: 14px; }
      footer a { color: rgba(255,255,255,0.85); text-decoration: none; margin-left: 14px; }
      footer a:hover { color: var(--orange); }
      footer strong { color: var(--white); font-weight: 600; }

      @media (max-width: 980px) {
        section.section { padding: 64px 24px; }
        .triad, .traps-grid, .path-grid, .catalog-tabs { grid-template-columns: 1fr; }
        .hero-strip { grid-template-columns: repeat(2, 1fr); }
        .loop-wrapper { grid-template-columns: 1fr; }
        .diff-head { display: none; }
        .diff-row { grid-template-columns: 1fr; gap: 8px; padding: 22px 20px; }
        .timeline li { grid-template-columns: 1fr; gap: 8px; }
      }
    </style>
  </head>
  <body>
    <!-- NAV -->
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="brand" aria-label="Decisive Finance home"><span class="brand-mark" aria-hidden="true"></span>Decisive Finance</a>
        <div class="nav-links">
          <a href="/how-it-works">How it works</a>
          <a href="/offers">Offers</a>
          <a href="/guarantee">Guarantee</a>
          <a href="/results">Results</a>
          <a href="/blog">Writing</a>
          <a href="/about">About</a>
          <a href={calendly} class="btn btn-primary">Book a conversation</a>
        </div>
      </div>
    </nav>

    <!-- HERO -->
    <section class="section hero-section">
      <div class="inner content">
        <div class="eyebrow">How it works</div>
        <h1 class="page-title">Find. <span class="accent">Install.</span> Run.</h1>
        <p class="lede">
          Decision-First Finance, with the methodology in plain view. A 14-day Diagnostic that
          <strong>names what your current capital is doing</strong>. A 90-day Resolution that
          <strong>installs the rhythm that defends every next call</strong> and proves it in market.
          An optional Partnership that <strong>runs the rhythm on retainer</strong>. Six cognitive
          traps named. Nineteen artifacts produced. Guaranteed 3x your Diagnostic fee in trapped
          value, in 14 days. Typical 5x to 10x.
        </p>
        <div class="hero-strip">
          <div><span class="hero-num">14</span>days to the Diagnostic readout</div>
          <div><span class="hero-num">90</span>days to the rhythm installed in market</div>
          <div><span class="hero-num">6</span>structural traps in the diagnostic</div>
          <div><span class="hero-num">19</span>deliverables, every one named and scoped</div>
        </div>
      </div>
    </section>

    <!-- FIND / INSTALL / RUN -->
    <section class="section alt">
      <div class="inner content">
        <div class="eyebrow">The architecture</div>
        <h2 class="section-title">Three tiers. Three distinct promises.</h2>
        <p class="section-sub">
          Find. Install. Run. No repeat guarantees against the same mechanism. Each tier earns its
          keep on a different test, with a different artifact set and a different exit door.
        </p>

        <div class="triad">
          <!-- FIND -->
          <div class="tier-card find">
            <div class="tier-stamp">Find · Tier 1</div>
            <div class="tier-name">The Decision Diagnostic</div>
            <h3 class="tier-promise">Names what your current capital is doing, in 14 days.</h3>
            <div class="tier-meta">
              <div class="tier-meta-row"><div class="tier-meta-label">Price</div><div class="tier-meta-value"><strong>$7,500</strong> under $3M ARR · <strong>$10,000</strong> $3M to $8M ARR</div></div>
              <div class="tier-meta-row"><div class="tier-meta-label">CEO time</div><div class="tier-meta-value">3 hours total</div></div>
              <div class="tier-meta-row"><div class="tier-meta-label">Artifacts</div><div class="tier-meta-value">5 named deliverables</div></div>
              <div class="tier-meta-row"><div class="tier-meta-label">Guarantee</div><div class="tier-meta-value"><strong>3x fee threshold</strong> with CEO-accepted recovery plans, a defined strategic finding, or 100% refund.</div></div>
            </div>
          </div>

          <!-- INSTALL -->
          <div class="tier-card install">
            <div class="tier-stamp">Install · Tier 2</div>
            <div class="tier-name">The 90-Day Decision Resolution</div>
            <h3 class="tier-promise">Installs the rhythm that defends every next call, and proves it in market across 90 days.</h3>
            <div class="tier-meta">
              <div class="tier-meta-row"><div class="tier-meta-label">Price</div><div class="tier-meta-value"><strong>$22,500 to $30,000</strong> total · Founding Cohort <strong>$18,000</strong> flat</div></div>
              <div class="tier-meta-row"><div class="tier-meta-label">CEO time</div><div class="tier-meta-value">15 to 18 hours total</div></div>
              <div class="tier-meta-row"><div class="tier-meta-label">Artifacts</div><div class="tier-meta-value">10 new (15 cumulative)</div></div>
              <div class="tier-meta-row"><div class="tier-meta-label">Guarantee</div><div class="tier-meta-value"><strong>Rhythm installed and in market</strong> by Day 90 or full refund. Five next calls defended forward, two executed with measurement, scenario forecast running.</div></div>
            </div>
          </div>

          <!-- RUN -->
          <div class="tier-card run">
            <div class="tier-stamp">Run · Tier 3</div>
            <div class="tier-name">The Decision Partnership</div>
            <h3 class="tier-promise">Runs the rhythm on retainer.</h3>
            <div class="tier-meta">
