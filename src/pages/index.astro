---
import BaseLayout from '../layouts/BaseLayout.astro';

const CALENDLY = 'https://calendly.com/russell-decisive/30min';

const title = 'Your future rides on the next call. | Decisive Finance';
const description =
  'Your board wants growth. Your bank wants runway. Your future rides on the next call. Put in $7,500. We name at least $22,500 of trapped value in 14 days, or the Diagnostic is free.';

const traps = [
  {
    name: 'Sunk Cost',
    body: 'The money already spent feels like it is voting. It is not. The next dollar is the only one that matters.',
  },
  {
    name: 'Status Quo',
    body: 'Doing nothing feels neutral. It is never neutral. Every week of unchanged spend is an active call.',
  },
  {
    name: 'Mental Accounting',
    body: 'The right total can hide the wrong allocation. A clean aggregate number can mask a customer-funded cost sitting in the wrong bucket.',
  },
  {
    name: 'Anchoring',
    body: 'The first number set becomes the number the conversation orbits. The price you launched at 18 months ago is rarely the price today’s buyer responds to.',
  },
  {
    name: 'Loss Aversion',
    body: 'The pain of admitting a commitment is not paying off is roughly twice the pleasure of recovering the cash. Most companies 18 months past their raise sit under that coefficient without naming it.',
  },
  {
    name: 'Certainty Illusion',
    body: 'Polished reporting can feel like evidence when it is actually theater. Defending numbers with a story that quietly stopped being true is the most expensive habit a company carries 18 months in.',
  },
];

const tiers = [
  {
    label: 'Tier 1',
    name: 'Decision Diagnostic',
    price: 'From $7,500',
    priceSecondary: '',
    promise: '14 days. Fixed fee. Five named deliverables.',
    body: 'An itemized list, in dollars, of what your current capital is earning and what it is not, with a CEO-accepted plan for every dollar that has to move.',
    guarantee: '3x the fee in trapped value with CEO-accepted recovery plans, a strategic finding of equivalent materiality, or full refund.',
    featured: true,
  },
  {
    label: 'Tier 2',
    name: 'Decision Resolution',
    price: '$22,500 to $30,000 total',
    priceSecondary: '+ $18,000 Founding Cohort',
    promise: '90 days. The rhythm installed in market.',
    body: 'Five decisions defended with math, two live in market with the data to score them, an 18-month forecast with a named path to profitability, Financial Rhythms™ running as the monthly cadence.',
    guarantee: 'Founding Cohort: $18,000 flat for the first three signed engagements. Closes at three or June 30, 2026.',
    featured: false,
  },
  {
    label: 'Tier 3',
    name: 'Decision Partnership',
    price: '$7,500 per month',
    priceSecondary: '+ 5% success fee on Realized Value',
    promise: 'Ongoing. The rhythm on retainer.',
    body: 'Weekly, monthly, quarterly cadence. Every new material decision hits the same loop. Realized Value certified quarterly against methodology, not opinion.',
    guarantee: 'Optional. Runs only once Tier 2 has installed what it is paid to operate.',
    featured: false,
  },
];

const engineTests = [
  {
    title: 'Five material decisions defended forward.',
    body: 'Each with a Three-Path Model, a Six Trap stack naming the patterns that quietly held capital in place, the recovery plan, and a CEO-accepted recommendation on file.',
  },
  {
    title: 'Two of those five live in market, with the data to score them.',
    body: 'Not modeled. Live. A pricing change with at least one cycle of data, a product-line restructure booked, a cost or headcount change implemented with documented impact, or a growth experiment running with named go and no-go triggers.',
  },
  {
    title: 'An 18-month forecast with a named path to profitability.',
    body: 'Base, upside, downside. Weekly actuals-vs-prediction reconciliation running. Not a hope. A specific sequence of decisions with named assumptions, triggers, and next-cycle hypotheses.',
  },
];

const artifacts = [
  {
    name: 'Unit Economics Dashboard',
    body: 'Live CAC, LTV, payback, gross and contribution margin, by segment, cohort, channel.',
  },
  {
    name: 'Product Line P&Ls',
    body: 'Contribution margin per product with full cost allocation and the cross-subsidy map nobody had.',
  },
  {
    name: 'Forward Capital Register',
    body: 'Every cost above $5,000 per month carries an explicit decision status, an owner, and a standing review cadence.',
  },
  {
    name: 'Three-Path Models',
    body: 'Keep / Kill / Restructure on every material decision, with the cognitive stack that quietly held the capital in place and where each dollar should move.',
  },
  {
    name: 'Scenario Forecast',
    body: 'Eighteen-month base, upside, downside, with named assumptions and weekly actuals-vs-prediction reconciliation.',
  },
  {
    name: 'Pricing Architecture Revisit',
    body: 'Repricing of existing offerings in existing channels. Not net-new products or channels.',
  },
  {
    name: 'Growth Experiment Register',
    body: 'The two in-market decisions with measurement protocol, go and no-go triggers.',
  },
  {
    name: 'Bridge / Pivot / Raise Model',
    body: 'Three financing paths including the capital plan the next round will be defended from.',
  },
  {
    name: 'Board Decision Package',
    body: 'Fully populated board deck the founder can walk through without hedging, plus a reusable template.',
  },
  {
    name: 'Final Readout and Decision Playbook',
    body: 'Ninety-day capstone and the playbook the CEO can run without us.',
  },
];

const proofs = [
  {
    name: 'Pathwright',
    tag: 'SaaS / EdTech',
    outcome: 'Valuation 3x.',
    trap: 'Mental Accounting + Sunk Cost',
    resolution:
      '$600,000 per year of engineering was customer-funded development hidden in the departmental P&L, deployed against a context that assumed it was all forward product investment. Product Line P&L broke the cross-subsidy. The recovery plan moved the work to paid services at 2.5x margin.',
    takeaway:
      'Engineering-hidden-in-R&D is standard across funded SaaS, concentrated in 18-month-old hires whose original charter has since changed.',
  },
  {
    name: 'SmartTab',
    tag: 'Tech / POS',
    outcome: 'Growth equity round secured. +19% valuation.',
    trap: 'Status Quo + Loss Aversion',
    resolution:
      'Hardware ops running on a 2022 strategic decision nobody had revisited against the current context. Founder anchored to the legacy model. The recovery plan made the emotion explicit and restructured to SaaS-led with partnered hardware. Zero cash crunches.',
    takeaway:
      'Post-raise strategic commitments never re-decided against the current context are the largest single bucket of trapped value in the average funded tech P&L.',
  },
  {
    name: 'Orchestraight',
    tag: 'AI SaaS',
    outcome: '$12M pre-seed closed. Board-ready Day 1.',
    trap: 'Mental Accounting + Anchoring',
    resolution:
      'Three revenue streams commingled. Pricing anchored to the wrong buyer. No scenario model for investors. Separated Enterprise / API / SMB economics, killed the money-losing $99 tier, sequenced API launch post-raise.',
    takeaway:
      'The investor-facing problem is identical. Commingled numbers, no downside case, no named assumption set. The raise is 18 months overdue, not next quarter.',
  },
];

const fitYes = [
  'Venture-backed tech, $1M to $8M ARR.',
  'Eighteen or more months since the last raise.',
  'Burn multiple above 3x. Growth has flattened.',
  'A founder making the hardest capital calls of their career without the math to defend them.',
];

const fitNo = [
  'Under $1M ARR. Not enough cost structure for the math to work.',
  'Raised in the last six months. Context has not shifted enough yet.',
  'Already in active turnaround with another firm in the chair.',
  'Bookkeeping so broken the work becomes archaeology, not analysis.',
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <span class="eyebrow">For venture-backed companies 18 months past their last raise</span>
      <h1>
        <span class="h1-line">Your board wants growth</span>
        <span class="h1-line">Your bank wants runway</span>
        <span class="h1-line h1-line-accent">Your future rides on the next call</span>
      </h1>
      <p class="hero-subhead">
        The next ninety days decide which founder you were. <span class="dollar">Put in $7,500. We name at least $22,500 of trapped value in 14 days, or the Diagnostic is free. Engagements to date: 5x to 10x.</span>
      </p>
      <div class="hero-cta-row">
        <a href={CALENDLY} class="btn btn-primary">Book 30 minutes with Russ</a>
        <a href="/guarantee" class="btn btn-secondary">Read Guarantee</a>
      </div>
      <p style="font-size: 15px; color: rgba(255,255,255,0.7); margin: 10px 0 0;">No pitch. You leave with at least one named action.</p>
      <blockquote class="hero-quote">
        &ldquo;You were the first person who made it feel like a solvable problem, not a permanent condition.&rdquo;
        <cite>Founder, venture-backed SaaS, 22 months post-raise</cite>
      </blockquote>
      <div class="rally">FIND. INSTALL. RUN.</div>
    </div>
  </section>

  <!-- The Stuck Raise -->
  <section id="stuck" class="alt">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">The round 18 months in</span>
        <h2>Roughly seven thousand venture-backed founders are at this call right now.</h2>
        <p class="lede">
          Growth has flattened against the curve the round assumed. Portfolio CFOs are reporting last quarter, not defending next quarter. Growth-stage fractional CFOs will not touch a cap table where the round is 18 months old. The hardest forward calls of the company (which product line earns the next dollar, which pricing lever to pull, which path to the next round) are getting made on instinct, because the math to defend them to a board or a new lead is not there. The portfolio company drifts into what one board member called &ldquo;narrative maintenance mode,&rdquo; reporting the same KPIs quarter after quarter while the unit economics quietly stop holding up. The trapped value, capital locked inside decisions whose context has died, compounds underneath the clean reporting.
        </p>
      </div>
    </div>
  </section>

  <!-- Why Not the Portfolio CFO -->
  <section>
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Why not the portfolio CFO</span>
        <h2>The portfolio CFO reports. Decisive Finance defends the next call.</h2>
        <p class="lede">
          Different mandate, different output, no overlap. A portfolio CFO is paid to tell investors what happened last quarter. Decisive Finance is paid to decide what the next dollar does, defend the call with math, prove it in market, and install the rhythm that keeps doing it. The report can be clean and the next call still undefended. When the raise story needs defending, the founder does not need better reporting. They need every material decision backed with math, executed, and live in market.
        </p>
        <div class="delay-callout">
          Every month the rhythm is absent, more capital stays deployed against a context that has already changed, and the raise story gets harder to defend.
        </div>
      </div>
    </div>
  </section>

  <!-- The Six Trap Diagnostic -->
  <section id="traps" class="traps">
    <div class="container">
      <span class="section-eyebrow">Method</span>
      <h2>The Six Trap Diagnostic&trade;</h2>
      <p class="lede" style="color: rgba(255,255,255,0.88);">
        Nobody re-validates every commitment when growth is compounding. Not because they are lazy or unserious, because the human brain is built not to. The traps below are structural patterns in human cognition, not failures of the founder. No founder alone, however smart or diligent, can counteract all six while operating the business they created.
      </p>
      <div class="trap-grid">
        {traps.map((trap, i) => (
          <div class="trap-card">
            <div class="trap-num">Trap {String(i + 1).padStart(2, '0')}</div>
            <div class="trap-name">{trap.name}</div>
            <p>{trap.body}</p>
          </div>
        ))}
      </div>
      <p class="traps-footer">
        Most companies 18 months past their raise are running three or four of these at once. We name the stack, surface each trap in the dollars, and convert every decision into a Three-Path Model the board can follow. Financial Rhythms&trade; is the monthly cadence that keeps the loop running after the engagement ends.
      </p>
    </div>
  </section>

  <!-- Three tiers -->
  <section id="tiers">
    <div class="container">
      <span class="section-eyebrow">Three tiers</span>
      <h2>Three promises. Find. Install. Run.</h2>
      <p class="lede">
        Tier 1 names what your current capital is doing, in 14 days. Tier 2 installs the rhythm that defends every next call, and proves it in market across 90 days. Tier 3 runs the rhythm on retainer. Most founders start with Tier 1 and move into Tier 2.
      </p>
      <div class="tier-grid">
        {tiers.map((tier) => (
          <div class={`tier${tier.featured ? ' featured' : ''}`}>
            {tier.featured && <span class="featured-badge">Start here</span>}
            <div class="tier-label">{tier.label}</div>
            <h3>{tier.name}</h3>
            <p class="tier-promise">{tier.promise}</p>
            <div class="tier-meta">
              <div class="tier-row">
                <span>Price</span>
                <span>
                  {tier.price}
                  {tier.priceSecondary && (
                    <span class="tier-fee-secondary">{tier.priceSecondary}</span>
                  )}
                </span>
              </div>
            </div>
            <p style="font-size:15px; line-height:1.55; margin-bottom:22px;">{tier.body}</p>
            <div class="tier-guarantee">
              <strong>Promise</strong>
              {tier.guarantee}
            </div>
          </div>
        ))}
      </div>

      <!-- Tier 3 worked magnitude -->
      <div class="worked">
        <span class="label">Tier 3 worked magnitude</span>
        <h4>Roughly $105,000 first year against quarterly-certified value.</h4>
        <p>
          Typical first year runs $90,000 in base fees ($7,500 &times; 12) plus a success fee on Realized Value. If a Tier 2 engagement produces $300,000 of Realized Value across year one (roughly one well-executed pricing change plus one capacity reallocation), the success fee adds $15,000. If Realized Value is zero, the success fee is zero.
        </p>
        <div class="calc">
          <div><span class="k">Base fees, year 1</span><span class="v">$90,000</span></div>
          <div><span class="k">Realized Value</span><span class="v">$300,000</span></div>
          <div><span class="k">Success fee (5%)</span><span class="v accent">$15,000</span></div>
          <div><span class="k">Year 1 total</span><span class="v">$105,000</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- What "Rhythm Installed" Means at Day 90 -->
  <section class="alt">
    <div class="container">
      <span class="section-eyebrow">Day 90 readout</span>
      <h2>The Day 90 readout: three tests the rhythm has to pass.</h2>
      <p class="lede">
        Tier 2 is not a second pull on the trapped-value well. Tier 1 already did that. Tier 2 is paid to install the decision rhythm that backs new material calls with math, proves them in market, and compounds quarter over quarter. Three things have to be true on the Day 90 readout. If all three are not true, the rhythm is not installed. That is the test the guarantee measures against.
      </p>
      <div class="engine-list">
        {engineTests.map((item) => (
          <div class="engine-item">
            <div>
              <p><strong>{item.title}</strong></p>
              <p style="margin-top: 8px; color: var(--muted);">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ten Artifacts catalog -->
  <section id="artifacts" class="artifacts">
    <div class="container">
      <span class="section-eyebrow">Tier 2 artifacts</span>
      <h2>Ten new artifacts. Fifteen cumulative.</h2>
      <p class="lede">
        Not advisory hours. A specified product with specified output. Tier 1 delivers five artifacts. Tier 2 adds ten more on top. Fifteen cumulative through Day 90.
      </p>
      <div class="artifact-grid">
        {artifacts.map((art, i) => (
          <div class="artifact">
            <div class="num">{String(i + 1).padStart(2, '0')}.</div>
            <div>
              <h4>{art.name}</h4>
              <p>{art.body}</p>
            </div>
          </div>
        ))}
      </div>

      <details class="scope">
        <summary>What&rsquo;s out of scope</summary>
        <div class="scope-body">
          If it is not in the artifact catalog, it is a change order. Explicitly outside Tier 2: ad-hoc modeling of unrelated transactions (acquisition offers, side investments), bookkeeping cleanup beyond what the artifacts require, board-meeting facilitation, HR or legal consulting on specific RIF cases, fundraising introductions or pitch coaching, interim controller or FP&amp;A hiring, pricing architecture for net-new products or net-new channels, and growth experiments in channels the company is not already operating in. Any of those can be added as a change order with separate scope, separate price, and a fixed delivery date.
        </div>
      </details>
    </div>
  </section>

  <!-- What That Does for the Raise -->
  <section>
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">The raise story</span>
        <h2>What that does for the raise.</h2>
        <p class="lede">
          By the end of 90 days the company has clean unit economics per revenue stream, a defended pricing architecture, a three-scenario forecast with a named path to profitability, two live experiments with measurement in market, a board package the founder can walk through without hedging, and a capital plan with explicit triggers. The raise story stops being last quarter&rsquo;s narrative retold. It becomes current-quarter reality, with math behind every call and a rhythm that keeps making the next one.
        </p>
      </div>
    </div>
  </section>

  <!-- Pattern Proof -->
  <section id="proof" class="alt">
    <div class="container">
      <span class="section-eyebrow">Pattern proof</span>
      <h2>Three mechanisms across funded tech.</h2>
      <p class="lede">
        The Decisive Finance mechanism works because the Six Trap Diagnostic&trade; reads the same way across funded tech contexts. These three engagements spanned SaaS, POS with hardware, and pre-seed AI. Post-Series A/B case studies are being built now through the Founding Cohort.
      </p>
      <div class="proof-grid">
        {proofs.map((p) => (
          <div class="proof-card">
            <div class="proof-name">{p.name}</div>
            <span class="proof-tag">{p.tag}</span>
            <div class="proof-outcome">{p.outcome}</div>
            <span class="proof-trap">{p.trap}</span>
            <p class="resolution">{p.resolution}</p>
            <div class="takeaway">What this means for post-Series A/B funded tech: {p.takeaway}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Founding Cohort -->
  <section class="cohort">
    <div class="container">
      <span class="cohort-eyebrow">Founding cohort &middot; first three resolutions</span>
      <h2>Be one of the first three post-Series A/B engagements in the record.</h2>
      <p style="color: #ffffffeb; font-size: 18px; line-height: 1.55; max-width: 760px;">
        Decisive Finance is opening the first three Resolutions as the Founding Cohort. Same architecture, same guarantee, two differences below. Closes at three signed Resolution engagements or June 30, 2026, whichever comes first. Diagnostic runs at standard price.
      </p>
      <div class="cohort-grid">
        <div class="cohort-block">
          <strong>Founding pricing</strong>
          <p>The 90-Day Decision Resolution at $18,000 flat, versus $22,500 to $30,000 standard.</p>
        </div>
        <div class="cohort-block">
          <strong>Published mechanism</strong>
          <p>In exchange for the concession, the CEO grants written permission to publish the trap stack, Three-Path outputs, and financial outcomes as a case study after Day 90. Named or anonymized at CEO discretion.</p>
        </div>
        <div class="cohort-block">
          <strong>Eligibility filter</strong>
          <p>By Day 21, the engagement must have a credible draft Pricing Architecture Revisit and Growth Experiment Register on track to produce at least one in-market decision by Day 60. Otherwise it runs at standard pricing.</p>
        </div>
      </div>
      <a href={CALENDLY} class="btn btn-secondary">Book 30 minutes with Russ</a>
      <div class="cohort-status">Cohort open · seats remaining</div>
    </div>
  </section>

  <!-- Who This Fits -->
  <section>
    <div class="container">
      <span class="section-eyebrow">Who this fits</span>
      <h2>Who this is for, and who it is not.</h2>
      <p class="lede">
        The Diagnostic and Resolution math is built for a specific cohort. If you are inside the band, the work fits. If you are outside, we will say so on the first call and you keep your time.
      </p>
      <div class="fit-grid">
        <div class="fit-col yes">
          <h4>Fits</h4>
          <ul>
            {fitYes.map((line) => <li>{line}</li>)}
          </ul>
        </div>
        <div class="fit-col no">
          <h4>Not a fit</h4>
          <ul>
            {fitNo.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Methodology -->
  <section class="alt">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Methodology</span>
        <h2>The methodology is called decision-first finance.</h2>
        <p class="lede">
          We reorganize the finance function around the next five material calls the company has to make, not the last five months of variance. Reporting is a byproduct of decision-first work, not its product. The close still closes. The board deck still ships. The center of gravity moves to the decision queue. We don&rsquo;t audit the past. We justify each next call.
        </p>
        <p>
          <a href="/perspectives/decision-first-finance">Read the methodology &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- For investors -->
  <section>
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">For investors</span>
        <h2>The decision rhythm that installs in 90 days.</h2>
        <p class="lede">
          GPs, LPs, and independent directors bring us into portfolio companies where the growth-versus-runway call is live but a CEO change is the wrong first move. A Decision Diagnostic is 14 days, fixed fee, guaranteed. It is designed to install 90 days of operating space before anyone has to make a bigger call. After the first call you get a one-paragraph write-up so you stay in the loop without being in the room.
        </p>
        <p>
          <a href="/perspectives/stalled-portco-field-guide-for-investors">Field guide for investors &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Closing CTA · Start Here -->
  <section class="close-section">
    <div class="container">
      <span class="section-eyebrow">Start here</span>
      <h2>Read the guarantee, then book 30 minutes.</h2>
      <p class="lede">
        The promise is the quote at the top of this page. The decisions behind the round 18 months in were right for a context that no longer exists. Nobody had the bandwidth, the framework, or the neutrality to install the rhythm the company needs now. Decisive Finance does.
      </p>
      <div class="close-grid">
        <div class="close-card">
          <h3>For founders</h3>
          <p>One 30-minute call. No pitch. If the fit is there, we book a 60-minute working session to run the Diagnostic. If it is not, both sides know inside the first call and we end clean.</p>
          <a href={CALENDLY} class="btn btn-primary">Book 30 minutes with Russ</a>
        </div>
        <div class="close-card">
          <h3>For investors</h3>
          <p>If you&rsquo;re watching a portfolio company make hard calls without the math to defend them, this is what we install. After the first call we send a one-paragraph fit/not-fit note so you stay in the loop.</p>
          <a href="/guarantee" class="btn btn-secondary">Read Guarantee</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
