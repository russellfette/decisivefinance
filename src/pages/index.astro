---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';

const CALENDLY = '#book';

const title = 'Numbers a buyer will believe | Decisive Finance';
const description =
  'A sale price is a multiple times earnings. We work both numbers: what a buyer would re-price, and where the value expansion is, in dollars, in 14 days.';

// The value proposition: both sides of the sale-price equation
const both = [
  {
    side: 'Defense',
    head: 'Protect the multiple.',
    body: 'Believable numbers survive diligence. When the earnings can be trusted, buyers stop discounting. Every soft number is their leverage and your haircut. We take that leverage off the table before you go to market.',
  },
  {
    side: 'Offense',
    head: 'Grow the earnings.',
    body: 'Decision-grade numbers earn the multiple. Pricing, mix, margin, customer concentration, owner independence. The trend a buyer will pay for is built, not found, and we build it on a rhythm across the months before market.',
  },
];

// The Six Traps, read through the valuation lens
const traps = [
  {
    name: 'Sunk Cost',
    body: 'The money already spent feels like it is voting on the next call. A buyer does not pay for what you already spent. They pay for what the business earns from here.',
  },
  {
    name: 'Status Quo',
    body: 'A line item nobody has revisited in three years reads to a buyer as a cost they can cut, which means it is upside you left on the table, priced as your risk.',
  },
  {
    name: 'Mental Accounting',
    body: 'A clean bottom line can hide the product or customer the rest of the business is quietly funding. Diligence finds the cross-subsidy. Better you find it first.',
  },
  {
    name: 'Anchoring',
    body: 'The price you set years ago is rarely the price the market would pay now. Anchored pricing is the most common trapped margin a buyer re-prices against you.',
  },
  {
    name: 'Loss Aversion',
    body: 'The account you are most afraid to touch is often the one capping your margin, and the concentration a buyer will discount hardest. Naming it early is worth real multiple.',
  },
  {
    name: 'Certainty Illusion',
    body: 'Polished reporting can feel like proof when it is really theater. A buyer tests the story behind every number. The ones that stopped being true become the re-trade.',
  },
];

const steps = [
  {
    title: 'Find. The Sellable-Numbers Scan, in 14 days.',
    body: 'We show you your company the way a buyer will, in dollars, on both sides of the equation: what diligence would knock off your number, and where the value expansion lives. You leave with the re-price read, the worth read, and the first three moves.',
  },
  {
    title: 'Install. The 90-Day Resolution, exit-clothed.',
    body: 'Numbers made believable and decision-grade in 90 days. The close tightens, the add-backs and owner-dependence flags get resolved, and the trailing-twelve clock starts running on numbers a buyer can trust.',
  },
  {
    title: 'Run. The Exit-Value Partnership, 12 to 24 months.',
    body: 'We build the value the Scan found and the trend a buyer will pay for, on a quarterly re-valuation against the engagement baseline, so you watch the number move. Fees tied to the value created, never to the deal.',
  },
];

const tiers = [
  {
    label: 'Tier 1, Find',
    name: 'The Sellable-Numbers Scan',
    promise: 'Find. 14 days. See your company the way a buyer will, in dollars.',
    bands: [
      ['$5M to $8M revenue', '$10,000'],
      ['$8M to $25M revenue', '$15,000'],
      ['$25M to $50M revenue', '$20,000'],
    ],
    body: 'Your numbers normalized, the Six Trap Diagnostic run through the valuation lens, and the dollarized findings: buyer discounts, add-back and owner-dependence flags, and the value-expansion map. It reads both ways: what a buyer re-prices, and where your worth is.',
    guarantee: 'At least 3x the Scan fee in owner-accepted value identified by Day 14, or you pay nothing.',
    featured: true,
  },
  {
    label: 'Tier 2, Install',
    name: 'The 90-Day Decision Resolution',
    promise: 'Install. 90 days. Numbers believable and decision-grade.',
    bands: [
      ['$5M to $8M revenue', '$30,000'],
      ['$8M to $25M revenue', '$45,000'],
      ['$25M to $50M revenue', '$60,000'],
    ],
    body: 'Material calls defended with math, taken live in market, and scored against what happened, with Financial Rhythms™ running as the monthly cadence. The close, the add-backs, and the data room reach a state a buyer can trust. A Resolution signed within 7 days of the Day 14 readout credits the Scan fee 100%.',
    guarantee: 'The rhythm installed and in market, a strategic finding of equivalent materiality, or full refund of all fees paid. You keep every deliverable.',
    featured: false,
  },
  {
    label: 'Tier 3, Run',
    name: 'The Exit-Value Partnership',
    promise: 'Run. 12 to 24 months. A more valuable company, and the numbers to prove it.',
    bands: [
      ['$5M to $8M revenue', '$7,500 / mo'],
      ['$8M to $25M revenue', '$10,000 / mo'],
      ['$25M to $50M revenue', '$12,500 / mo'],
    ],
    body: 'Financial Rhythms plus a quarterly re-valuation against the engagement baseline. We build the value and the trend a buyer will pay for, concurrently with the trailing-twelve clock. Fees ride the value created, never the deal. We are the one advisor in the deal who is not paid on the deal.',
    guarantee: 'Realized Value validated quarterly against methodology, not opinion. No fee is ever calculated from the transaction or contingent on a closing.',
    featured: false,
  },
];

const proofs = [
  {
    name: 'Consumer products manufacturer',
    tag: '$25M revenue',
    outcome: "The banker's estimate was $25M to $35M, on books the owner didn't trust. We modeled a path to roughly $52M in enterprise value.",
    trap: 'Mental Accounting + Anchoring',
    resolution:
      'We found the mispriced input costs, the phantom discounts, and the revenue that was never brought over, then rebuilt the close to 10 days. Pricing had been anchored to costs that moved years earlier, and the aggregate P&L hid which products carried the business.',
    takeaway:
      'The gap was never the market. It was the numbers.',
  },
  {
    name: 'Professional services firm',
    tag: '$30M revenue',
    outcome: '$380,000 of working capital recovered. Close cut from 22 days to 3. Roughly $50,000 a month of margin improvement, in 90 days.',
    trap: 'Status Quo + Certainty Illusion',
    resolution:
      'Cash was trapped in a billing and close cadence nobody had revisited, and clean-looking reports masked the leak. We rebuilt the rhythm, pulled the working capital forward, and put margin on a weekly line of sight, the kind of report a buyer believes.',
    takeaway:
      'A clean close is not the same as a fast one, and neither one tells a buyer where the cash is stuck.',
  },
  {
    name: 'Manufacturer',
    tag: '$15M revenue',
    outcome: 'The largest customer turned out to be the least profitable. Margins moved from 15% to 22% in 90 days.',
    trap: 'Loss Aversion + Mental Accounting',
    resolution:
      'The biggest account felt untouchable, so the math on it never got run, and the concentration was exactly what a buyer would discount hardest. Full cost allocation showed it was funded by everyone else. We repriced and reset terms instead of protecting the logo.',
    takeaway:
      'Customer concentration a buyer discounts is margin you can recover before you ever go to market.',
  },
];

const fitYes = [
  'Owners of operating companies, $5M to $50M in revenue.',
  'An ownership change is on your horizon in the next one to three years: a sale, a PE approach, a succession, a partner exit.',
  'You run on data but suspect your numbers would not survive the person writing the check.',
  'EOS and Vistage operating companies, plus manufacturing, consumer products, professional services, and construction.',
];

const fitNo = [
  'Under $5M in revenue. The guarantee math does not hold, so we refer out.',
  'You want someone to promise a sale price or find you a buyer. We do not sell companies.',
  'Happy deciding on instinct, or unwilling to act on the numbers.',
  'Shopping for cheap bookkeeping.',
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero / the trigger -->
  <section id="exit" class="hero">
    <div class="hero-inner hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">For owners facing a sale, a PE approach, or a succession</span>
        <h1>
          <span class="h1-line">You can&rsquo;t sell a company</span>
          <span class="h1-line">on numbers</span>
          <span class="h1-line h1-line-accent">you don&rsquo;t trust yourself.</span>
        </h1>
        <p class="hero-subhead">
          A sale price is a multiple times earnings. <span class="dollar">We work both numbers.</span> Buyers pay for a trend they can believe, and the trailing-twelve clock doesn&rsquo;t start until the numbers are true.
        </p>
        <div class="hero-cta-row">
          <a href={CALENDLY} class="btn btn-primary">Book a fit call</a>
          <a href="#how" class="btn btn-secondary">See the 14-day Scan</a>
        </div>
        <p class="hero-microcopy">30 minutes with Russ. No pitch. You leave knowing what a buyer would re-price.</p>
        <blockquote class="hero-quote">
          Most owners aren&rsquo;t waiting for the right market. They&rsquo;re waiting for numbers they&rsquo;d be willing to show.
          <cite>The deferral, in one line</cite>
        </blockquote>
        <div class="rally">FIND. INSTALL. RUN.</div>
      </div>

      <div class="hero-viz" aria-hidden="true">
        <svg viewBox="0 0 460 380" role="img" xmlns="http://www.w3.org/2000/svg">
          <title>Banker's estimate versus the modeled path once the numbers can be believed</title>
          <line x1="60" y1="330" x2="440" y2="330" class="viz-axis" />
          <!-- Banker estimate bar (uncertain, shorter) -->
          <rect class="viz-bar viz-bar-est" x="96" y="196" width="104" height="134" rx="6" />
          <text x="148" y="182" class="viz-tag viz-tag-est" text-anchor="middle">Banker&rsquo;s estimate</text>
          <text x="148" y="356" class="viz-num viz-num-est" text-anchor="middle">$25M to $35M</text>
          <!-- Modeled path bar (taller, orange) -->
          <rect class="viz-bar viz-bar-worth" x="272" y="86" width="104" height="244" rx="6" />
          <text x="324" y="72" class="viz-tag viz-tag-worth" text-anchor="middle">Modeled path</text>
          <text x="324" y="356" class="viz-num viz-num-worth" text-anchor="middle">roughly $52M</text>
          <!-- gap note -->
          <text x="250" y="40" class="viz-note" text-anchor="middle">The gap was never the market. It was the numbers.</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- The value proposition: both numbers -->
  <section id="both">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">The value proposition</span>
        <h2>A sale price is a multiple times earnings. We work both numbers.</h2>
        <p class="lede">
          Believable numbers protect the multiple from diligence discounts. Decision-grade numbers grow the earnings that earn the multiple. Most advisors touch one side. We work both, and we start by showing you where each one stands, in dollars.
        </p>
      </div>
      <div class="both-grid">
        {both.map((b) => (
          <div class="both-card">
            <span class="both-side">{b.side}</span>
            <h3>{b.head}</h3>
            <p>{b.body}</p>
          </div>
        ))}
      </div>
      <div class="container-narrow">
        <div class="category-pull">
          Accurate and ugly beats polished and untrustworthy. Buyers know the difference.
        </div>
      </div>
    </div>
  </section>

  <!-- The parent diagnosis: why the numbers can't be trusted -->
  <section id="why" class="alt">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Why your numbers can&rsquo;t be trusted yet</span>
        <h2>You have a system of record. You don&rsquo;t have a system of decision.</h2>
        <p class="lede">
          The moment you decide the company will change hands, every weakness in the numbers converts from a chronic annoyance to priced risk, and the clock starts. Your books were built for the tax return and the closed month, not for a buyer&rsquo;s read.
        </p>
        <p>
          The mess isn&rsquo;t negligence. Growth covered it, and the people producing the numbers were never paid to look. Everyone who touches your books closes the month. Nobody is making your company worth believing. That is a different job, and it is the one we do.
        </p>
        <div class="delay-callout">
          The trailing-twelve clock doesn&rsquo;t start until the numbers are true. Every month you wait moves the sale date a month.
        </div>
      </div>
    </div>
  </section>

  <!-- The Six Traps, through the valuation lens -->
  <section class="traps">
    <div class="container">
      <span class="section-eyebrow">Where the value is trapped</span>
      <h2>The Six Trap Diagnostic&trade;, read through a buyer&rsquo;s eyes.</h2>
      <p class="lede" style="color: rgba(255,255,255,0.88);">
        The value trapped inside past calls does not stay hidden when a buyer looks. Each trap below is a place diligence knocks your number down, and a place your worth can grow before you ever go to market. The patterns are structural, not failures of the owner. No one running a company can counteract all six alone.
      </p>
      <div class="trap-grid">
        {traps.map((trap, i) => (
          <div class="trap-card">
            <div class="trap-num">Trap {String(i + 1).padStart(2, '0')}</div>
            <div class="trap-name">{trap.name}</div>
            <p>{trap.body}</p>
          </div>
        ))}
      </div>
      <p class="traps-footer">
        Most companies are running three or four of these at once. We name the stack, price each one two ways, what a buyer discounts and what you can recover, and turn the read into a plan. We don&rsquo;t audit the past. We make the company worth believing.
      </p>
    </div>
  </section>

  <!-- How it works -->
  <section id="how">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">How it works</span>
        <h2>Find. Install. Run.</h2>
        <p class="lede">
          Three steps, one rhythm. We find what a buyer would re-price and where your worth is, install the numbers a buyer can trust, and run the value build across the months before market until the trend is real.
        </p>
      </div>
      <div class="engine-list">
        {steps.map((item) => (
          <div class="engine-item">
            <div>
              <p><strong>{item.title}</strong></p>
              <p style="margin-top: 8px; color: var(--muted);">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
      <p style="margin-top: 36px;">
        <a href="/how-it-works">See the full method &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Tiers and pricing -->
  <section id="tiers" class="alt">
    <div class="container">
      <span class="section-eyebrow">Tiers and pricing</span>
      <h2>Three promises, priced to your revenue.</h2>
      <p class="lede">
        Most owners start with the Scan and move into the Resolution. Pricing is banded by revenue. The floor is $5M; below that the guarantee math does not hold, so we refer out.
      </p>
      <div class="band-toggle" role="group" aria-label="Highlight your revenue band">
        <button type="button" data-band="0" class="is-active">$5M to $8M</button>
        <button type="button" data-band="1">$8M to $25M</button>
        <button type="button" data-band="2">$25M to $50M</button>
      </div>
      <div class="tier-grid" data-band="0">
        {tiers.map((tier) => (
          <div class={`tier${tier.featured ? ' featured' : ''}`}>
            {tier.featured && <span class="featured-badge">Start here</span>}
            <div class="tier-label">{tier.label}</div>
            <h3>{tier.name}</h3>
            <p class="tier-promise">{tier.promise}</p>
            <div class="tier-meta">
              {tier.bands.map((band, bi) => (
                <div class="tier-row" data-row={bi}>
                  <span>{band[0]}</span>
                  <span>{band[1]}</span>
                </div>
              ))}
            </div>
            <p style="font-size:15px; line-height:1.55; margin-bottom:22px;">{tier.body}</p>
            <div class="tier-guarantee">
              <strong>Promise</strong>
              {tier.guarantee}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who this is for -->
  <section id="who">
    <div class="container">
      <span class="section-eyebrow">Who this is for</span>
      <h2>Built for owners who can see the exit from here.</h2>
      <p class="lede">
        The work fits a specific band and a specific moment. If you are inside it, the method reads the same across whatever you build or sell. If you are outside it, we will say so on the first call and you keep your time.
      </p>
      <div class="category-pull">
        For EOS and Vistage companies: the Scorecard tells you the boat is moving. We tell you if it&rsquo;s pointed at the money, and whether a buyer would believe it.
      </div>
      <div class="fit-grid">
        <div class="fit-col yes">
          <h4>Fits</h4>
          <ul>
            {fitYes.map((line) => <li>{line}</li>)}
          </ul>
        </div>
        <div class="fit-col no">
          <h4>Not a fit</h4>
          <ul>
            {fitNo.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section id="proof" class="alt">
    <div class="container">
      <span class="section-eyebrow">Proof</span>
      <h2>Worth built, and proven in the cash.</h2>
      <p class="lede">
        The mechanism reads the same across industries because the traps do. Three companies, three sectors, one method. Anonymized by segment and revenue band until attribution is confirmed.
      </p>
      <div class="proof-grid">
        {proofs.map((p) => (
          <div class="proof-card">
            <div class="proof-name">{p.name}</div>
            <span class="proof-tag">{p.tag}</span>
            <div class="proof-outcome">{p.outcome}</div>
            <span class="proof-trap">{p.trap}</span>
            <p class="resolution">{p.resolution}</p>
            <div class="takeaway">{p.takeaway}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Methodology / Decision Loop -->
  <section>
    <div class="container">
      <div class="loop-grid">
        <div class="loop-copy">
          <span class="section-eyebrow">Methodology</span>
          <h2>The methodology is called Decision-First Finance.</h2>
          <p class="lede">
            We reorganize the finance function around the calls that set your worth, not the last few months of variance. Every decision runs the same loop. Most companies never close it, so value traps and stays trapped, and a buyer prices the gap against you.
          </p>
          <p>
            Our intervention is the last two nodes, Diagnose and Defend, run on a rhythm: weekly cadence, monthly deep dive, quarterly rebuild. That rhythm is what turns a set of numbers into a trend a buyer will pay for.
          </p>
          <p>
            <a href="/perspectives/decision-first-finance">Read the methodology &rarr;</a>
          </p>
        </div>

        <figure class="loop-fig">
          <svg viewBox="0 0 480 440" role="img" xmlns="http://www.w3.org/2000/svg">
            <title>The Decision Loop: Decision, Cost and Commitment, Drift, Trap, Diagnose, Defend</title>
            <defs>
              <marker id="arrowGrey" markerWidth="9" markerHeight="9" refX="5" refY="3" orient="auto" markerUnits="strokeWidth">
                <path d="M0 0 L6 3 L0 6 Z" class="loop-arrow-grey" />
              </marker>
              <marker id="arrowOrange" markerWidth="9" markerHeight="9" refX="5" refY="3" orient="auto" markerUnits="strokeWidth">
                <path d="M0 0 L6 3 L0 6 Z" class="loop-arrow-orange" />
              </marker>
            </defs>

            <path class="loop-arc" d="M220 80 A140 140 0 0 1 341 150" marker-end="url(#arrowGrey)" />
            <path class="loop-arc" d="M341 150 A140 140 0 0 1 341 290" marker-end="url(#arrowGrey)" />
            <path class="loop-arc" d="M341 290 A140 140 0 0 1 220 360" marker-end="url(#arrowGrey)" />
            <path class="loop-arc loop-arc-on" d="M220 360 A140 140 0 0 1 99 290" marker-end="url(#arrowOrange)" />
            <path class="loop-arc loop-arc-on" d="M99 290 A140 140 0 0 1 99 150" marker-end="url(#arrowOrange)" />
            <path class="loop-arc loop-arc-on" d="M99 150 A140 140 0 0 1 220 80" marker-end="url(#arrowOrange)" />

            <text x="220" y="214" class="loop-center">The</text>
            <text x="220" y="236" class="loop-center">Decision Loop</text>

            <g class="loop-node"><circle cx="220" cy="80" r="9" /><text x="220" y="56" class="loop-label" text-anchor="middle">Decision</text></g>
            <g class="loop-node"><circle cx="341" cy="150" r="9" /><text x="356" y="146" class="loop-label">Cost &amp;</text><text x="356" y="163" class="loop-label">commitment</text></g>
            <g class="loop-node"><circle cx="341" cy="290" r="9" /><text x="356" y="295" class="loop-label">Drift</text></g>
            <g class="loop-node"><circle cx="220" cy="360" r="9" /><text x="220" y="386" class="loop-label" text-anchor="middle">Trap</text></g>
            <g class="loop-node loop-node-on"><circle cx="99" cy="290" r="9" /><text x="84" y="295" class="loop-label loop-label-on" text-anchor="end">Diagnose</text></g>
            <g class="loop-node loop-node-on"><circle cx="99" cy="150" r="9" /><text x="84" y="155" class="loop-label loop-label-on" text-anchor="end">Defend</text></g>
          </svg>
          <figcaption>Decision &rarr; Cost and commitment &rarr; Drift &rarr; Trap &rarr; <strong>Diagnose</strong> &rarr; <strong>Defend</strong>. We close the loop.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section id="book" class="close-section">
    <div class="container">
      <span class="section-eyebrow">Book a fit call</span>
      <h2>Decide from the numbers. Prove it in the cash.</h2>
      <p class="lede">
        In 14 days you see your company the way a buyer will, in dollars, on both sides of the equation. You leave with the re-price read, the worth read, and the first three moves, whether or not we ever work together again. It starts with one 30-minute call.
      </p>
      <div class="book-grid">
        <div class="book-aside">
          <div class="book-note">
            <h3>For owners</h3>
            <p>One 30-minute fit call. No pitch. If the fit is there, the 14-day Scan starts. If it is not, both sides know inside the first call and we end clean.</p>
          </div>
          <div class="book-note">
            <h3>For advisors and deal professionals</h3>
            <p>M&amp;A advisors, brokers, bankers, and attorneys bring us in before the mandate, so the financials survive diligence and the deal doesn&rsquo;t die in it. We are the one advisor in the deal who is not paid on the deal.</p>
            <a href="/guarantee" class="btn btn-secondary">Read the guarantee</a>
          </div>
        </div>
        <div class="book-embed">
          <CalendlyEmbed />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero: two columns + chart */
  .hero { padding-bottom: 96px; }
  .hero-grid { display: grid; grid-template-columns: 1fr; gap: 36px; align-items: center; }
  .hero-copy { min-width: 0; }
  .hero-microcopy { font-size: 15px; color: rgba(255, 255, 255, 0.7); margin: 10px 0 0; }
  .hero-viz { display: none; }
  .hero-viz svg { width: 100%; height: auto; overflow: visible; }
  @media (min-width: 1000px) {
    .hero-grid { grid-template-columns: 1.12fr 0.88fr; gap: 48px; }
    .hero-viz { display: block; }
  }
  .viz-axis { stroke: rgba(255, 255, 255, 0.18); stroke-width: 1.5; }
  .viz-bar { opacity: 0; transform: scaleY(0); transform-origin: bottom; transform-box: fill-box; animation: vizgrow 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .viz-bar-est { fill: rgba(255, 255, 255, 0.16); stroke: rgba(255, 255, 255, 0.3); stroke-width: 1.5; animation-delay: 0.15s; }
  .viz-bar-worth { fill: rgba(227, 99, 43, 0.9); animation-delay: 0.45s; }
  .viz-tag { font: 600 13px Inter, sans-serif; }
  .viz-tag-est { fill: rgba(255, 255, 255, 0.6); }
  .viz-tag-worth { fill: var(--orange); }
  .viz-num { font: 700 15px Inter, sans-serif; }
  .viz-num-est { fill: rgba(255, 255, 255, 0.6); }
  .viz-num-worth { fill: var(--white); }
  .viz-note { fill: rgba(255, 255, 255, 0.7); font: italic 12px Inter, sans-serif; }
  .viz-tag, .viz-num, .viz-note { opacity: 0; animation: vizfade 0.6s ease 0.9s forwards; }
  @keyframes vizgrow { to { opacity: 1; transform: scaleY(1); } }
  @keyframes vizfade { to { opacity: 1; } }

  /* Both-numbers value prop */
  .both-grid { display: grid; grid-template-columns: 1fr; gap: 20px; margin: 44px 0 8px; }
  @media (min-width: 800px) { .both-grid { grid-template-columns: 1fr 1fr; gap: 24px; } }
  .both-card { background: var(--white); border: 1px solid var(--hairline); border-radius: 16px; padding: 32px 30px; transition: border-color 0.18s ease, transform 0.18s ease; }
  .both-card:hover { border-color: var(--green); transform: translateY(-2px); }
  .both-side { display: inline-block; font: 700 12px Inter, sans-serif; text-transform: uppercase; letter-spacing: 0.16em; color: var(--orange); margin-bottom: 12px; }
  .both-card h3 { margin: 0 0 12px; font-size: 24px; }
  .both-card p { font-size: 16px; line-height: 1.6; color: var(--muted); margin: 0; }

  /* Tier band selector */
  .band-toggle { display: inline-flex; flex-wrap: wrap; gap: 6px; background: var(--white); border: 1px solid var(--hairline); border-radius: 999px; padding: 5px; margin: 0 0 28px; }
  .band-toggle button { border: none; background: none; font: inherit; font-size: 14px; font-weight: 600; color: var(--muted); padding: 9px 16px; border-radius: 999px; cursor: pointer; transition: background 0.15s ease, color 0.15s ease; }
  .band-toggle button:hover { color: var(--ink); }
  .band-toggle button.is-active { background: var(--ink); color: var(--white); }
  .tier-row { transition: opacity 0.18s ease; }
  .tier-grid[data-band="0"] .tier-row:not([data-row="0"]),
  .tier-grid[data-band="1"] .tier-row:not([data-row="1"]),
  .tier-grid[data-band="2"] .tier-row:not([data-row="2"]) { opacity: 0.32; }
  .tier-grid[data-band="0"] .tier-row[data-row="0"] span:last-child,
  .tier-grid[data-band="1"] .tier-row[data-row="1"] span:last-child,
  .tier-grid[data-band="2"] .tier-row[data-row="2"] span:last-child { color: var(--orange); }

  /* Decision Loop */
  .loop-grid { display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .loop-grid { grid-template-columns: 1fr 1fr; gap: 56px; } }
  .loop-copy { max-width: 620px; }
  .loop-fig { margin: 0; }
  .loop-fig svg { width: 100%; height: auto; max-width: 460px; display: block; margin: 0 auto; overflow: visible; }
  .loop-arc { fill: none; stroke: var(--hairline); stroke-width: 2.5; }
  .loop-arc-on { stroke: var(--orange); }
  .loop-arrow-grey { fill: #9aa7ad; }
  .loop-arrow-orange { fill: var(--orange); }
  .loop-node circle { fill: var(--white); stroke: var(--ink); stroke-width: 2.5; transition: transform 0.15s ease; transform-box: fill-box; transform-origin: center; }
  .loop-node:hover circle { transform: scale(1.25); }
  .loop-node-on circle { fill: var(--orange); stroke: var(--orange); }
  .loop-label { font: 600 13px Inter, sans-serif; fill: var(--ink); }
  .loop-label-on { fill: var(--orange); }
  .loop-center { font: 700 15px Inter, sans-serif; fill: var(--muted); text-anchor: middle; }
  .loop-fig figcaption { margin: 18px auto 0; text-align: center; font-size: 14px; color: var(--muted); max-width: 440px; line-height: 1.5; }
  .loop-fig figcaption strong { color: var(--orange); }

  @media (prefers-reduced-motion: reduce) {
    .viz-bar { opacity: 1; transform: scaleY(1); animation: none; }
    .viz-tag, .viz-num, .viz-note { opacity: 1; animation: none; }
  }

  /* Book: copy aside + inline scheduler */
  .book-grid { display: grid; grid-template-columns: 1fr; gap: 32px; margin-top: 44px; align-items: start; }
  @media (min-width: 1000px) { .book-grid { grid-template-columns: 0.82fr 1.18fr; gap: 48px; } }
  .book-aside { display: flex; flex-direction: column; gap: 22px; }
  .book-note { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 14px; padding: 28px 26px; }
  .book-note h3 { color: var(--white); margin-top: 0; margin-bottom: 12px; font-size: 21px; }
  .book-note p { color: rgba(255, 255, 255, 0.78); font-size: 15px; margin-bottom: 0; line-height: 1.55; }
  .book-note .btn { margin-top: 20px; }
  .book-embed { min-width: 0; }
</style>

<script>
  // Tier band selector
  const grid = document.querySelector('.tier-grid');
  const bandBtns = document.querySelectorAll<HTMLButtonElement>('.band-toggle button');
  bandBtns.forEach((btn) =>
    btn.addEventListener('click', () => {
      bandBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      if (grid && btn.dataset.band) grid.setAttribute('data-band', btn.dataset.band);
    })
  );
</script>
