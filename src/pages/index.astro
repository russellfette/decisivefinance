---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';

const CALENDLY = '#book';

const title = "You can't sell a company on numbers you don't trust yourself";
const description =
  'In 14 days, see your company the way a buyer will, in dollars. Guaranteed 3x the fee in identified value or you pay nothing. For $5M to $50M companies.';

// How it works: Find, Install, Run (the Two Numbers)
const steps = [
  {
    step: 'Find',
    title: 'The Sellable-Numbers Scan, 14 days.',
    body: "We normalize your numbers and run the Six Trap Diagnostic™ through a buyer's eyes. You get the re-price read (what diligence would knock off your number, in dollars), the worth read (where the value expansion lives: pricing, mix, margin, concentration), and the first three moves. From $10,000, fixed. Guaranteed.",
    href: '/scan',
    link: 'The Scan, in full',
  },
  {
    step: 'Install',
    title: 'The 90-Day Decision Resolution.',
    body: 'The decision rhythm installed: numbers you can decide from and defend, proven on your real decisions, in market. The trailing-twelve clock starts here.',
    href: '/how-it-works',
    link: 'How the install works',
  },
  {
    step: 'Run',
    title: 'The Exit-Value Partnership, 12 to 24 months to market.',
    body: 'We build the value the Scan found and the trend a buyer will pay for, with a re-valuation every quarter so you watch the number move. Our fees ride the value created, never the transaction. We are the one advisor in the deal who is not paid on the deal.',
    href: '/partnership',
    link: 'The Partnership, both faces',
  },
];

const proofs = [
  {
    name: 'Consumer products manufacturer',
    tag: '$25M revenue',
    outcome:
      "Bankers' estimate was $25M to $35M, on books the owner didn't trust. We modeled a path to roughly $52M in enterprise value.",
    resolution:
      'Mispriced inputs, phantom discounts, and revenue never brought over. Pricing was anchored to costs that had moved years earlier, and the aggregate P&L hid which products carried the business.',
    takeaway: 'The gap was never the market. It was the numbers.',
  },
  {
    name: 'Professional services',
    tag: '$30M revenue',
    outcome:
      '$380,000 of working capital recovered. Close cut from 22 days to 3. Roughly $50,000 a month of margin, in 90 days.',
    resolution:
      'Cash was trapped in a billing and close cadence nobody had revisited, and clean reports masked the leak. We rebuilt the rhythm, pulled the working capital forward, and put margin on a weekly line of sight.',
    takeaway: 'A clean close is not a fast one, and neither tells you where the cash is stuck.',
  },
  {
    name: 'Manufacturer',
    tag: '$15M revenue',
    outcome: 'The largest customer was the least profitable. Margins moved from 15% to 22% in 90 days.',
    resolution:
      'The biggest account felt untouchable, so the math never got run. Full cost allocation showed it was funded by everyone else. We repriced and reset terms, and margin followed inside the quarter.',
    takeaway: 'The account nobody would touch was the margin everyone was looking for.',
  },
];

const fitNo = [
  'Under $5M in revenue. The guarantee math does not hold, so we refer out.',
  'You want someone to promise a sale price or find you a buyer. We do not sell companies.',
  'Happy deciding on instinct, or unwilling to act on the numbers.',
  'Shopping for bookkeeping.',
];

const fitYes = [
  'You own an operating company between $5M and $50M in revenue.',
  'A real decision is on the table: a sale, a succession, a price, a hire, an expansion.',
  "You're tired of making it half-blind.",
  'EOS and Vistage operating companies, manufacturing, consumer products, professional services, and construction.',
];

const pricing = [
  {
    name: 'Sellable-Numbers Scan or Decision Diagnostic (14 days)',
    bands: ['$10,000', '$15,000', '$20,000'],
  },
  {
    name: '90-Day Decision Resolution',
    bands: ['$30,000', '$45,000', '$60,000'],
  },
  {
    name: 'Partnership (monthly)',
    bands: ['$7,500', '$10,000', '$12,500'],
  },
];

// Page-level JSON-LD: banded offers + founder, per Homepage v3 build notes
const offersJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Decisive Finance',
  url: 'https://decisive.finance',
  founder: {
    '@type': 'Person',
    name: 'Russell Fette',
    jobTitle: 'Founder',
    sameAs: 'https://www.linkedin.com/in/russellfette',
  },
  makesOffer: [
    {
      '@type': 'Offer',
      name: 'Sellable-Numbers Scan / Decision Diagnostic (14 days)',
      priceSpecification: [
        { '@type': 'UnitPriceSpecification', price: 10000, priceCurrency: 'USD', name: '$5M to $8M revenue' },
        { '@type': 'UnitPriceSpecification', price: 15000, priceCurrency: 'USD', name: '$8M to $25M revenue' },
        { '@type': 'UnitPriceSpecification', price: 20000, priceCurrency: 'USD', name: '$25M to $50M revenue' },
      ],
    },
    {
      '@type': 'Offer',
      name: '90-Day Decision Resolution',
      priceSpecification: [
        { '@type': 'UnitPriceSpecification', price: 30000, priceCurrency: 'USD', name: '$5M to $8M revenue' },
        { '@type': 'UnitPriceSpecification', price: 45000, priceCurrency: 'USD', name: '$8M to $25M revenue' },
        { '@type': 'UnitPriceSpecification', price: 60000, priceCurrency: 'USD', name: '$25M to $50M revenue' },
      ],
    },
    {
      '@type': 'Offer',
      name: 'Decision Partnership / Exit-Value Partnership (monthly)',
      priceSpecification: [
        { '@type': 'UnitPriceSpecification', price: 7500, priceCurrency: 'USD', name: '$5M to $8M revenue' },
        { '@type': 'UnitPriceSpecification', price: 10000, priceCurrency: 'USD', name: '$8M to $25M revenue' },
        { '@type': 'UnitPriceSpecification', price: 12500, priceCurrency: 'USD', name: '$25M to $50M revenue' },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(offersJsonLd)} />

  <!-- Exit hero: why now -->
  <section id="hero" class="hero">
    <div class="hero-inner">
      <span class="eyebrow">For owner-led operating companies, $5M to $50M in revenue</span>
      <h1>
        <span class="h1-line">You can&rsquo;t sell a company</span>
        <span class="h1-line h1-line-accent">on numbers you don&rsquo;t trust yourself.</span>
      </h1>
      <p class="hero-subhead">
        Most owners aren&rsquo;t waiting for the right market. They&rsquo;re waiting for numbers they&rsquo;d be willing to show. In 14 days, we show you your company the way a buyer will, in dollars, guaranteed: <span class="dollar">at least 3x the fee in owner-accepted value identified, or you pay nothing.</span>
      </p>
      <div class="hero-cta-row">
        <a href={CALENDLY} class="btn btn-primary">See if you qualify</a>
      </div>
      <p class="trust-strip">
        A $25M manufacturer&rsquo;s modeled exit value, roughly doubled &middot; $380K of working capital recovered in 90 days &middot; a monthly close cut from 22 days to 3
      </p>
    </div>
  </section>

  <!-- Proof strip -->
  <section id="proof" class="alt">
    <div class="container">
      <span class="section-eyebrow">Proof</span>
      <h2>The numbers moved because the numbers changed.</h2>
      <p class="lede">
        Three companies, three sectors, one method. Anonymized by segment and revenue band until attribution is confirmed.
      </p>
      <div class="proof-grid">
        {proofs.map((p) => (
          <div class="proof-card">
            <div class="proof-name">{p.name}</div>
            <span class="proof-tag">{p.tag}</span>
            <div class="proof-outcome">{p.outcome}</div>
            <p class="resolution">{p.resolution}</p>
            <div class="takeaway">{p.takeaway}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Second act: the wound (why us) -->
  <section id="why-us">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Why this keeps happening</span>
        <h2>Your books tell you what happened. They can&rsquo;t tell you what to do next.</h2>
        <p class="lede">
          Your accounting was built to answer one question: what happened. It closes the month, files the taxes, satisfies the bank. It was never built to answer the question a sale forces: what is this actually worth, and can I prove it?
        </p>
        <p>
          Here&rsquo;s the part nobody says out loud. Everyone who touches your numbers is paid to serve something other than you. The tax preparer optimizes the return. The bookkeeper, often a junior person carrying a senior title, produces a P&amp;L and closes the month. Not one of them is paid to make your company worth believing.
        </p>
        <p>
          The decisions weren&rsquo;t wrong. You made them on the only numbers you had, and those numbers were never built to decide from. The mess isn&rsquo;t negligence. Growth covered it, and the people producing the numbers were never paid to look. But a buyer will look. Buyers pay a multiple times earnings, and they only pay for a trend they can believe.
        </p>
        <div class="delay-callout">
          The trailing-twelve clock doesn&rsquo;t start until the numbers are true, and every month you wait moves the sale date a month.
        </div>
      </div>
    </div>
  </section>

  <!-- How it works: Find. Install. Run. -->
  <section id="how" class="alt">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">How it works</span>
        <h2>A sale price is a multiple times earnings. We work both numbers.</h2>
        <p class="lede">
          Three steps, one rhythm. Find what a buyer would pay and would question. Install the rhythm that fixes both. Run it until the trend is one a buyer will pay for.
        </p>
      </div>
      <div class="step-grid">
        {steps.map((item, i) => (
          <div class="step-card">
            <div class="step-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="step-name">{item.step}</div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <a href={item.href} class="step-link">{item.link} &rarr;</a>
          </div>
        ))}
      </div>
      <div class="container-narrow">
        <div class="rally" style="margin-top: 44px;">FIND. INSTALL. RUN.</div>
      </div>
    </div>
  </section>

  <!-- The guarantee -->
  <section id="guarantee">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">The guarantee</span>
        <h2>We put the risk on our side of the table.</h2>
        <p class="lede">
          The Scan identifies at least 3x its fee in owner-accepted value (recoverable cash, recoverable margin, avoided cost, or dollarized valuation exposure) inside 14 days, validated by you in writing, or you pay nothing. Typical results run 5x to 10x.
        </p>
        <p>
          The 90-Day Resolution installs the rhythm and proves it in market, or every fee is refunded and you keep every artifact we built. We never guarantee a sale price or a multiple. We don&rsquo;t control the market. We control whether a buyer can believe you.
        </p>
        <p>
          <a href="/guarantee">The guarantee mechanics, in full &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- The second door: not selling -->
  <section id="not-selling" class="traps">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">The second door</span>
        <h2>Not selling? The same numbers are costing you every month.</h2>
        <p class="lede" style="color: rgba(255,255,255,0.88);">
          Revenue&rsquo;s up. Profit isn&rsquo;t. And your numbers can&rsquo;t tell you why. The wound is identical; only the deadline is missing.
        </p>
        <p style="max-width: 760px;">
          The 14-day <a href="/diagnostic">Decision Diagnostic</a> runs the same engine without the buyer&rsquo;s lens: which products, customers, or jobs actually make money, where the recoverable value sits, and what to do first. Same bands, same guarantee.
        </p>
        <p style="margin-top: 28px;">
          <a href={CALENDLY} class="second-door-cta">Book the Diagnostic fit call &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Who this is for (the filter) -->
  <section id="filter" class="alt">
    <div class="container">
      <span class="section-eyebrow">Who this is for</span>
      <h2>The filter runs both ways.</h2>
      <div class="fit-grid">
        <div class="fit-col yes">
          <h3>It is for you if</h3>
          <ul>
            {fitYes.map((line) => <li>{line}</li>)}
          </ul>
        </div>
        <div class="fit-col no">
          <h3>This is not for you if</h3>
          <ul>
            {fitNo.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing: visible, banded, no form -->
  <section id="pricing">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Pricing</span>
        <h2>Fixed before we begin. Banded to your revenue.</h2>
      </div>
      <div class="pricing-table-wrap">
        <table class="pricing-table">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Engagement</span></th>
              <th scope="col">$5M to $8M revenue</th>
              <th scope="col">$8M to $25M</th>
              <th scope="col">$25M to $50M</th>
            </tr>
          </thead>
          <tbody>
            {pricing.map((row) => (
              <tr>
                <th scope="row">{row.name}</th>
                {row.bands.map((price) => <td>{price}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="container-narrow">
        <p class="pricing-note">
          A Resolution signed within 7 days of the Scan readout credits the Scan fee in full. The floor is $5M in revenue; below that the guarantee math does not hold, so we refer out.
        </p>
        <p style="margin-top: 32px;">
          <a href={CALENDLY} class="btn btn-primary">See if you qualify</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section id="book" class="close-section">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Book the fit call</span>
        <h2>Decide from the numbers. Prove it in the cash.</h2>
        <p class="lede">
          One 30-minute fit call. If it fits, the 14 days start.
        </p>
        <a href="https://calendly.com/russell-decisive/30min" class="btn btn-primary" style="margin-bottom: 40px;">See if you qualify</a>
      </div>
      <div class="book-embed">
        <CalendlyEmbed />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-bottom: 110px; }
  .trust-strip {
    font-family: Inter, sans-serif;
    font-size: 14.5px;
    color: rgba(255, 255, 255, 0.72);
    max-width: 920px;
    margin: 6px 0 0;
    line-height: 1.6;
  }

  /* Find / Install / Run cards */
  .step-grid { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 44px; }
  @media (min-width: 900px) { .step-grid { grid-template-columns: repeat(3, 1fr); gap: 24px; } }
  .step-card {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: 16px;
    padding: 34px 30px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .step-card:hover { border-color: var(--green); transform: translateY(-2px); }
  .step-num { font-family: Inter, sans-serif; font-size: 30px; font-weight: 600; color: var(--orange); line-height: 1; margin-bottom: 14px; }
  .step-name { font: 700 12px Inter, sans-serif; text-transform: uppercase; letter-spacing: 0.16em; color: var(--orange-ink); margin-bottom: 10px; }
  .step-card h3 { margin: 0 0 12px; font-size: 21px; }
  .step-card p { font-size: 15px; line-height: 1.6; color: var(--muted); margin: 0 0 20px; flex-grow: 1; }
  .step-link { font-family: Inter, sans-serif; font-size: 14px; font-weight: 600; margin-top: auto; }

  /* Second door CTA (on ink background) */
  .second-door-cta {
    display: inline-block;
    font-family: Inter, sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: var(--orange);
    border-bottom: 2px solid rgba(227, 99, 43, 0.5);
    padding-bottom: 3px;
  }
  .second-door-cta:hover { border-bottom-color: var(--orange); opacity: 1; }
  #not-selling a { color: var(--orange); }

  /* Pricing table */
  .pricing-table-wrap { margin-top: 44px; overflow-x: auto; }
  .pricing-table { width: 100%; max-width: 1180px; border-collapse: collapse; font-family: Inter, sans-serif; }
  .pricing-table th, .pricing-table td { padding: 18px 20px; text-align: left; border-bottom: 1px solid var(--hairline); font-size: 15.5px; }
  .pricing-table thead th { font-size: 13px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 600; }
  .pricing-table tbody th { font-weight: 600; color: var(--ink); max-width: 340px; }
  .pricing-table td { font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .pricing-note { margin-top: 28px; font-size: 15.5px; color: var(--muted); max-width: 760px; }

  .book-embed { margin-top: 12px; }
</style>
