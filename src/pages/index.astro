---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';

const CALENDLY = '#book';

const title = 'Hourly CFOs get paid to look. We get paid to find.';
const description =
  'At least 3x the fee in owner-accepted value, in 14 days, or you pay nothing. For $5M to $50M owner-led companies, running it or selling it.';

// Two lanes of equal weight under the hero (Homepage v4.1, Phrase Book v3.5 grid 3a)
const lanes = [
  {
    label: 'Running it',
    h2: "Revenue\u2019s up. Profit isn\u2019t. And your numbers can\u2019t tell you why.",
    body: 'The Decision Diagnostic shows you, in 14 days, which products, customers and jobs actually make money, where the recoverable cash and margin sit, and what to decide first.',
    href: '/diagnostic',
    link: 'The Diagnostic, in full',
    cta: 'Book the Diagnostic fit call',
  },
  {
    label: 'Selling it',
    h2: "You can\u2019t sell a company on numbers you don\u2019t trust yourself.",
    body: "Most owners aren\u2019t waiting for the right market. They\u2019re waiting for numbers they\u2019d be willing to show. The Sellable-Numbers Scan shows you your company the way a buyer will, in dollars, in 14 days. Buying a company instead? Same lens, pointed the other way.",
    href: '/scan',
    link: 'The Scan, in full',
    cta: 'Book the Scan fit call',
  },
];

// How it works: Find, Install, Run (the Two Numbers)
const steps = [
  {
    step: 'Find',
    title: 'The Decision Diagnostic or the Sellable-Numbers Scan, 14 days.',
    body: "The Diagnostic if you're running it; the Scan if you're selling. We normalize your numbers and run the Six Trap Diagnostic™. You get the recoverable cash and margin in dollars, and on the Scan, what diligence would knock off your number. From $10,000, fixed. Guaranteed.",
    href: '/how-it-works',
    link: 'How Find works',
  },
  {
    step: 'Install',
    title: 'The 90-Day Decision Resolution.',
    body: "The Financial Rhythm System™ installed: numbers you can decide from and defend, proven on your real decisions, in market. If you're selling, the trailing-twelve clock starts here.",
    href: '/how-it-works',
    link: 'How the install works',
  },
  {
    step: 'Run',
    title: 'The Decision Partnership or the Exit-Value Partnership.',
    body: 'The Decision Partnership keeps the rhythm running on retainer. For owners heading to market, the Exit-Value Partnership spends the 12 to 24 months before a sale building the value the Scan found and the trend a buyer will pay for. Our fees are tied to the value created, never to the deal. We take no piece of the transaction.',
    href: '/partnership',
    link: 'The Partnership, both faces',
  },
];


const fitNo = [
  'Under $5M in revenue. The guarantee math does not hold, so we refer out.',
  'You want someone to promise a sale price or find you a buyer. We do not sell companies.',
  'Happy deciding on instinct, or unwilling to act on the numbers.',
  'Shopping for bookkeeping.',
];

const fitYes = [
  'You own an operating company between $5M and $50M in revenue.',
  'A real decision is on the table: a price, a hire, an expansion, a bank renewal, a sale, a succession.',
  "You're tired of making it half-blind.",
  'EOS and Vistage operating companies, manufacturing, consumer products, professional services, and construction.',
];

const pricing = [
  {
    name: 'Decision Diagnostic or Sellable-Numbers Scan (14 days)',
    bands: ['$10,000', '$15,000', '$20,000'],
  },
  {
    name: '90-Day Decision Resolution',
    bands: ['$30,000', '$45,000', '$60,000'],
  },
  {
    name: 'Decision Partnership or Exit-Value Partnership (monthly)',
    bands: ['$7,500', '$10,000', '$12,500'],
  },
];

// Page-level JSON-LD: banded offers + founder, per Homepage v4 build notes
const offersJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Decisive Finance',
  url: 'https://decisive.finance',
  description:
    'Decision-First Finance for owner-led companies, $5M to $50M in revenue, running it or getting it ready to sell. At least 3x the fee in owner-accepted value, in 14 days, or you pay nothing.',
  founder: {
    '@type': 'Person',
    name: 'Russell Fette',
    jobTitle: 'Founder',
    sameAs: 'https://www.linkedin.com/in/russellfette',
  },
  makesOffer: [
    {
      '@type': 'Offer',
      name: 'Decision Diagnostic / Sellable-Numbers Scan (14 days)',
      priceSpecification: [
        { '@type': 'UnitPriceSpecification', price: 10000, priceCurrency: 'USD', name: '$5M to $8M revenue' },
        { '@type': 'UnitPriceSpecification', price: 15000, priceCurrency: 'USD', name: '$8M to $25M revenue' },
        { '@type': 'UnitPriceSpecification', price: 20000, priceCurrency: 'USD', name: '$25M to $50M revenue' },
      ],
    },
    {
      '@type': 'Offer',
      name: '90-Day Decision Resolution',
      priceSpecification: [
        { '@type': 'UnitPriceSpecification', price: 30000, priceCurrency: 'USD', name: '$5M to $8M revenue' },
        { '@type': 'UnitPriceSpecification', price: 45000, priceCurrency: 'USD', name: '$8M to $25M revenue' },
        { '@type': 'UnitPriceSpecification', price: 60000, priceCurrency: 'USD', name: '$25M to $50M revenue' },
      ],
    },
    {
      '@type': 'Offer',
      name: 'Decision Partnership / Exit-Value Partnership (monthly)',
      priceSpecification: [
        { '@type': 'UnitPriceSpecification', price: 7500, priceCurrency: 'USD', name: '$5M to $8M revenue' },
        { '@type': 'UnitPriceSpecification', price: 10000, priceCurrency: 'USD', name: '$8M to $25M revenue' },
        { '@type': 'UnitPriceSpecification', price: 12500, priceCurrency: 'USD', name: '$25M to $50M revenue' },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(offersJsonLd)} />

  <!-- Hero: both prongs -->
  <section id="hero" class="hero">
    <div class="hero-inner">
      <span class="eyebrow">For owner-led companies, $5M to $50M in revenue</span>
      <h1>
        <span class="h1-line">Hourly CFOs get paid to look.</span>
        <span class="h1-line h1-line-accent">We get paid to find.</span>
      </h1>
      <p class="hero-subhead">
        <span class="dollar">At least 3x the fee in owner-accepted value, in 14 days, or you pay nothing.</span> For owner-led companies, $5M to $50M, whether you&rsquo;re running it or getting it ready to sell.
      </p>
      <div class="hero-cta-row">
        <a href={CALENDLY} class="btn btn-primary">See if you qualify</a>
      </div>
    </div>
  </section>

  <!-- Two lanes, equal weight -->
  <section id="lanes" class="lanes-section">
    <div class="container">
      <div class="lane-grid">
        {lanes.map((lane) => (
          <div class="lane-card">
            <div class="lane-label">{lane.label}</div>
            <h2 class="lane-h2">{lane.h2}</h2>
            <p>{lane.body}</p>
            <div class="lane-links">
              <a href={CALENDLY} class="lane-cta">{lane.cta} &rarr;</a>
              <a href={lane.href} class="lane-more">{lane.link}</a>
            </div>
          </div>
        ))}
      </div>
      <p class="trust-strip">
        A $30M services firm: $380K of working capital recovered and the monthly close cut from 22 days to 3, in 90 days. &middot; A $25M consumer products manufacturer whose owner didn&rsquo;t trust the P&amp;L behind the bankers&rsquo; estimate; the work roughly doubled the modeled exit value.
      </p>
    </div>
  </section>


  <!-- Second act: the wound (why us) -->
  <section id="why-us">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Why this keeps happening</span>
        <h2>Your books tell you what happened. They can&rsquo;t tell you what to do next.</h2>
        <p class="lede">
          Your accounting was built to answer one question: what happened. It closes the month, files the taxes, satisfies the bank. It was never built to answer the questions an owner actually faces: which work makes money, what to do next, and what the company is worth.
        </p>
        <p>
          Here&rsquo;s the part nobody says out loud. Everyone who touches your numbers is paid to serve something other than you. The tax preparer optimizes the return. The bookkeeper closes the month. Not one of them is paid to find the margin, the cash or the value.
        </p>
        <p>
          The decisions weren&rsquo;t wrong. You made them on the only numbers you had, and those numbers were never built to decide from. Growth covered it. Then a big call lands, or a buyer calls, and the gap has a price.
        </p>
      </div>
    </div>
  </section>

  <!-- How it works: Find. Install. Run. -->
  <section id="how" class="alt">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">How it works</span>
        <h2>A sale price is a multiple times earnings. We work both numbers.</h2>
      </div>
      <div class="step-grid">
        {steps.map((item, i) => (
          <div class="step-card">
            <div class="step-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="step-name">{item.step}</div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <a href={item.href} class="step-link">{item.link} &rarr;</a>
          </div>
        ))}
      </div>
      <div class="container-narrow">
        <div class="rally" style="margin-top: 44px;">FIND. INSTALL. RUN.</div>
      </div>
    </div>
  </section>

  <!-- The guarantee -->
  <section id="guarantee">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">The guarantee</span>
        <h2>We put the risk on our side of the table.</h2>
        <p class="lede">
          The Diagnostic or the Scan: at least 3x the fee in owner-accepted value, in 14 days, or you pay nothing. Typical 5x to 10x. Owner-accepted value is recoverable cash, recoverable margin, avoided cost, and on the Scan, dollarized valuation exposure.
        </p>
        <p>
          The 90-Day Resolution installs the rhythm and proves it in market, or every fee is refunded and you keep every artifact we built. We never guarantee a sale price or a multiple.
        </p>
        <p>
          <a href="/guarantee">The guarantee mechanics, in full &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Who this is for (the filter) -->
  <section id="filter" class="alt">
    <div class="container">
      <span class="section-eyebrow">Who this is for</span>
      <h2>The filter runs both ways.</h2>
      <div class="fit-grid">
        <div class="fit-col yes">
          <h3>It is for you if</h3>
          <ul>
            {fitYes.map((line) => <li>{line}</li>)}
          </ul>
        </div>
        <div class="fit-col no">
          <h3>This is not for you if</h3>
          <ul>
            {fitNo.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing: visible, banded, no form -->
  <section id="pricing">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Pricing</span>
        <h2>Fixed before we begin. Banded to your revenue.</h2>
      </div>
      <div class="pricing-table-wrap">
        <table class="pricing-table">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Engagement</span></th>
              <th scope="col">$5M to $8M revenue</th>
              <th scope="col">$8M to $25M</th>
              <th scope="col">$25M to $50M</th>
            </tr>
          </thead>
          <tbody>
            {pricing.map((row) => (
              <tr>
                <th scope="row">{row.name}</th>
                {row.bands.map((price) => <td>{price}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="container-narrow">
        <p class="pricing-note">
          A Resolution signed within 7 days of the Find readout credits the Find fee in full. Partnerships add 5% of Realized Value, validated quarterly, never a percentage of a sale. The floor is $5M in revenue; below that the guarantee math does not hold, so we refer out.
        </p>
        <p style="margin-top: 32px;">
          <a href={CALENDLY} class="btn btn-primary">See if you qualify</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section id="book" class="close-section">
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">Book the fit call</span>
        <h2>Decide from the numbers. Prove it in the cash.</h2>
        <p class="lede">
          One 30-minute fit call. If it fits, the 14 days start.
        </p>
        <a href="https://calendly.com/russell-decisive/30min" class="btn btn-primary" style="margin-bottom: 40px;">See if you qualify</a>
      </div>
      <div class="book-embed">
        <CalendlyEmbed />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-bottom: 110px; }
  .trust-strip {
    font-family: Inter, sans-serif;
    font-size: 14.5px;
    color: rgba(255, 255, 255, 0.72);
    max-width: 920px;
    margin: 6px 0 0;
    line-height: 1.6;
  }

  /* Find / Install / Run cards */
  .step-grid { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 44px; }
  @media (min-width: 900px) { .step-grid { grid-template-columns: repeat(3, 1fr); gap: 24px; } }
  .step-card {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: 16px;
    padding: 34px 30px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .step-card:hover { border-color: var(--green); transform: translateY(-2px); }
  .step-num { font-family: Inter, sans-serif; font-size: 30px; font-weight: 600; color: var(--orange); line-height: 1; margin-bottom: 14px; }
  .step-name { font: 700 12px Inter, sans-serif; text-transform: uppercase; letter-spacing: 0.16em; color: var(--orange-ink); margin-bottom: 10px; }
  .step-card h3 { margin: 0 0 12px; font-size: 21px; }
  .step-card p { font-size: 15px; line-height: 1.6; color: var(--muted); margin: 0 0 20px; flex-grow: 1; }
  .step-link { font-family: Inter, sans-serif; font-size: 14px; font-weight: 600; margin-top: auto; }

  /* Two lanes, equal weight */
  .lanes-section { padding-top: 64px; padding-bottom: 64px; }
  .lane-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 900px) { .lane-grid { grid-template-columns: 1fr 1fr; gap: 24px; } }
  .lane-card {
    background: var(--grey);
    border-radius: 16px;
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
  }
  .lane-label { font: 700 12px Inter, sans-serif; text-transform: uppercase; letter-spacing: 0.16em; color: var(--orange-ink); margin-bottom: 14px; }
  .lane-h2 { font-size: clamp(24px, 2.4vw, 30px); line-height: 1.15; margin: 0 0 16px; padding-top: 14px; border-top: 3px solid var(--orange); }
  .lane-card p { font-size: 16px; line-height: 1.6; margin: 0 0 24px; flex-grow: 1; }
  .lane-links { display: flex; flex-wrap: wrap; gap: 18px; align-items: baseline; margin-top: auto; }
  .lane-cta { font-family: Inter, sans-serif; font-size: 16px; font-weight: 600; color: var(--orange-ink); border-bottom: 2px solid var(--orange); padding-bottom: 2px; }
  .lane-more { font-family: Inter, sans-serif; font-size: 14px; font-weight: 600; color: var(--ink); }
  .lanes-section .trust-strip { color: var(--muted); margin-top: 28px; }

  /* Pricing table */
  .pricing-table-wrap { margin-top: 44px; overflow-x: auto; }
  .pricing-table { width: 100%; max-width: 1180px; border-collapse: collapse; font-family: Inter, sans-serif; }
  .pricing-table th, .pricing-table td { padding: 18px 20px; text-align: left; border-bottom: 1px solid var(--hairline); font-size: 15.5px; }
  .pricing-table thead th { font-size: 13px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 600; }
  .pricing-table tbody th { font-weight: 600; color: var(--ink); max-width: 340px; }
  .pricing-table td { font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .pricing-note { margin-top: 28px; font-size: 15.5px; color: var(--muted); max-width: 760px; }

  .book-embed { margin-top: 12px; }
</style>
