---
import BaseLayout from '../layouts/BaseLayout.astro';

const CALENDLY = 'https://calendly.com/russell-decisive/30min';
---

<BaseLayout
  title="Contact | Decisive Finance"
  description="Book 30 minutes with Russ or email. No pitch. You leave with at least one named action."
>
  <section class="hero">
    <div class="hero-inner">
      <span class="eyebrow">Contact</span>
      <h1>Two ways to reach us.</h1>
      <p class="hero-subhead">
        The fastest path is the 30-minute call. No pitch. You leave with at least one action. If a call isn&rsquo;t the right first move, the inbox is open.
      </p>
      <div class="hero-cta-row">
        <a href={CALENDLY} class="btn btn-primary">Book 30 minutes with Russ</a>
        <a href="mailto:contact@decisive.finance" class="btn btn-secondary">Email us</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="container-narrow">
        <span class="section-eyebrow">What happens on the call</span>
        <h2>Thirty minutes. Two questions. One number.</h2>
        <p class="lede">
          We ask where the company is, we ask what the next material decision is, and we name the number that decision is running against. If the engagement fits, we scope it on the call. If it doesn&rsquo;t, we tell you why and you walk away with at least one action.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
