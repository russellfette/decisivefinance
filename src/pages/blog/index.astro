---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.pubDate || p.data.pubDate.getTime() <= Date.now())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts.filter((p) => p.data.featured);
const rest = posts.filter((p) => !p.data.featured);

const title = 'Field notes | Decisive Finance';
const description =
  'Field notes from inside stalled funded-tech engagements. The stalled-portco pattern, decision-first finance, and how stalled Series A/B portcos come back.';

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="hero-inner">
      <span class="eyebrow">Field notes</span>
      <h1>Field notes from inside stalled funded-tech engagements.</h1>
      <p class="hero-subhead">
        The stalled-portco pattern, decision-first finance, and how stalled Series A and Series B portcos come back. Updated weekly.
      </p>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="alt">
      <div class="container">
        <span class="section-eyebrow">Hubs</span>
        <h2>Start here.</h2>
        <div class="post-grid featured-grid">
          {featured.map((post) => (
            <a class="post-card featured" href={`/blog/${post.slug}/`}>
              <div class="post-card-meta">
                <span>{fmtDate(post.data.pubDate)}</span>
                {post.data.readingTime && <span>&middot; {post.data.readingTime} min read</span>}
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="post-card-cta">Read &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section>
    <div class="container">
      <span class="section-eyebrow">All posts</span>
      <h2>The full library.</h2>
      <div class="post-grid">
        {rest.map((post) => (
          <a class="post-card" href={`/blog/${post.slug}/`}>
            <div class="post-card-meta">
              <span>{fmtDate(post.data.pubDate)}</span>
              {post.data.readingTime && <span>&middot; {post.data.readingTime} min read</span>}
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="post-card-cta">Read &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 40px;
  }
  .featured-grid {
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }
  .post-card {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: 16px;
    padding: 32px 28px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  .post-card:hover {
    border-color: var(--green);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px #18222812;
    opacity: 1;
  }
  .post-card.featured {
    background: var(--ink);
    color: var(--white);
    border-color: var(--ink);
  }
  .post-card.featured h3,
  .post-card.featured .post-card-cta {
    color: var(--white);
  }
  .post-card.featured p {
    color: rgba(255, 255, 255, 0.75);
  }
  .post-card.featured:hover {
    border-color: var(--orange);
  }
  .post-card-meta {
    font-family: Inter, sans-serif;
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.02em;
    margin-bottom: 14px;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .post-card.featured .post-card-meta {
    color: rgba(255, 255, 255, 0.55);
  }
  .post-card h3 {
    font-family: Inter, sans-serif;
    font-size: 22px;
    line-height: 1.2;
    margin: 0 0 14px;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .post-card p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
    margin: 0 0 22px;
    flex-grow: 1;
  }
  .post-card-cta {
    color: var(--orange);
    font-family: Inter, sans-serif;
    font-weight: 600;
    font-size: 14px;
    margin-top: auto;
  }
  @media (max-width: 900px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
