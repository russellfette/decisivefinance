---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('site', 'trapped-capital-recovery-checklist');
const { Content } = entry ? await entry.render() : { Content: null };
---

<BaseLayout
  title="The recovery checklist | Decisive Finance"
  description="Eight-category DIY scan to surface $22,500 to $30,000 of forward-reallocation potential in your company in a weekend. Free, no email required."
>
  <section class="post-hero">
    <div class="post-hero-inner">
      <span class="eyebrow" style="color: rgba(255,255,255,0.85); background: transparent; border-color: rgba(255,255,255,0.2);">Resource</span>
      <h1 class="post-title">The recovery checklist.</h1>
      <p class="post-lede">An eight-category DIY scan. Surface $22,500 to $30,000 of forward-reallocation potential in a weekend.</p>
    </div>
  </section>

  <section class="post-body-section">
    <div class="post-body checklist-body">
      {Content && <Content />}
    </div>
  </section>
</BaseLayout>

<style>
  .post-hero {
    background: var(--ink);
    color: var(--white);
    padding: 96px 32px 64px;
  }
  .post-hero-inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .post-title {
    font-family: Inter, sans-serif;
    font-size: clamp(34px, 5vw, 60px);
    color: var(--white);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 24px 0;
  }
  .post-lede {
    font-family: Inter, sans-serif;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
  }
  .post-body-section {
    padding: 72px 32px;
    background: var(--white);
  }
  .post-body {
    max-width: 760px;
    margin: 0 auto;
    font-size: 17px;
    line-height: 1.7;
  }
  .checklist-body :global(h1) {
    display: none;
  }
  .checklist-body :global(h2) {
    font-size: clamp(24px, 2.8vw, 30px);
    margin-top: 48px;
    margin-bottom: 16px;
    font-weight: 700;
  }
  .checklist-body :global(h3) {
    font-size: 22px;
    margin-top: 36px;
    margin-bottom: 12px;
    font-weight: 700;
  }
  .checklist-body :global(p) {
    margin-bottom: 1.1em;
  }
  .checklist-body :global(ul),
  .checklist-body :global(ol) {
    margin: 0 0 1.3em 1.6em;
  }
  .checklist-body :global(li) {
    margin-bottom: 0.5em;
  }
  .checklist-body :global(a) {
    color: var(--orange);
    border-bottom: 1px solid rgba(227, 99, 43, 0.3);
  }
  .checklist-body :global(strong) {
    color: var(--ink);
  }
  .checklist-body :global(hr) {
    border: none;
    border-top: 1px solid var(--hairline);
    margin: 40px 0;
  }
</style>
