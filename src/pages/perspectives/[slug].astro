---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const CALENDLY = 'https://calendly.com/russell-decisive/30min';

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function humanizeTag(s: string) {
  return s.replace(/-/g, ' ');
}

const wordCount = post.body.trim().split(/\s+/).filter(Boolean).length;
const readingTime = post.data.readingTime || Math.max(1, Math.round(wordCount / 220));

const toc = headings.filter((h) => h.depth === 2);

const allPosts = (await getCollection('blog'))
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const related: CollectionEntry<'blog'>[] = [];
if (post.data.pillar) {
  for (const p of allPosts) {
    if (p.data.pillar === post.data.pillar && related.length < 3) {
      related.push(p);
    }
  }
}
if (post.data.topicCluster) {
  for (const p of allPosts) {
    if (related.length >= 3) break;
    if (p.data.topicCluster === post.data.topicCluster && !related.find((r) => r.slug === p.slug)) {
      related.push(p);
    }
  }
}
for (const p of allPosts) {
  if (related.length >= 3) break;
  if (!related.find((r) => r.slug === p.slug)) related.push(p);
}

const ogImage = post.data.ogImage || '/og/default.png';
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  ogType="article"
>
  <article>
    <section class="post-hero">
      <div class="post-hero-inner">
        <a href="/perspectives" class="post-hero-back">&larr; All perspectives</a>
        <div class="post-hero-meta">
          <span>{fmtDate(post.data.pubDate)}</span>
          <span class="dot">&middot;</span>
          <span>By {post.data.author || 'Russell Fette'}</span>
          <span class="dot">&middot;</span>
          <span>{readingTime} min read</span>
        </div>
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-lede">{post.data.description}</p>
        {(post.data.topicCluster || post.data.postType) && (
          <div class="post-tags">
            {post.data.topicCluster && (
              <span class="post-tag">{humanizeTag(post.data.topicCluster)}</span>
            )}
            {post.data.postType && (
              <span class="post-tag post-tag-muted">{humanizeTag(post.data.postType)}</span>
            )}
          </div>
        )}
      </div>
    </section>

    <section class="post-body-section">
      <div class="post-body">
        {toc.length >= 3 && (
          <nav class="post-toc" aria-label="On this page">
            <span class="post-toc-eyebrow">On this page</span>
            <ol>
              {toc.map((h, i) => (
                <li>
                  <span class="post-toc-num">{String(i + 1).padStart(2, '0')}</span>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <p class="post-stats">{readingTime} min read &middot; {wordCount.toLocaleString()} words</p>

        <div class="post-prose">
          <Content />
        </div>

        <p class="post-author-note">
          <em>Russell Fette writes these pieces from inside the engagements. If something here mirrors what you are running, the 30-minute call is the next move.</em>
        </p>
      </div>
    </section>

    {related.length > 0 && (
      <section class="post-related">
        <div class="container">
          <span class="section-eyebrow">Keep reading</span>
          <h2 class="post-related-h2">More perspectives</h2>
          <div class="post-related-grid">
            {related.map((p) => (
              <a class="post-related-card" href={`/perspectives/${p.slug}/`}>
                <div class="post-related-meta">
                  <span>{fmtDate(p.data.pubDate)}</span>
                  {p.data.readingTime && (
                    <>
                      <span class="dot">&middot;</span>
                      <span>{p.data.readingTime} min read</span>
                    </>
                  )}
                </div>
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
                <span class="post-related-cta">Read &rarr;</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="close-section">
      <div class="container">
        <div class="container-narrow">
          <span class="section-eyebrow" style="color: var(--orange);">The 14-day Diagnostic</span>
          <h2>Read the guarantee, then book the call.</h2>
          <p class="lede" style="color: rgba(255,255,255,0.8);">
            30 minutes with Russ. No pitch. You leave with at least one named action.
          </p>
          <div class="hero-cta-row">
            <a href={CALENDLY} class="btn btn-primary">Book Diagnostic</a>
            <a href="/guarantee" class="btn btn-secondary">Read Guarantee</a>
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .post-hero { background: var(--ink); color: var(--white); padding: 96px 32px 64px; position: relative; overflow: hidden; }
  .post-hero::before { content: ''; position: absolute; top: -200px; right: -200px; width: 600px; height: 600px; background: radial-gradient(circle, rgba(227, 99, 43, 0.18) 0%, transparent 70%); pointer-events: none; }
  .post-hero::after { content: ''; position: absolute; bottom: -280px; left: -160px; width: 680px; height: 680px; background: radial-gradient(circle, rgba(33, 76, 82, 0.42) 0%, transparent 65%); pointer-events: none; }
  .post-hero-inner { max-width: 920px; margin: 0 auto; position: relative; z-index: 2; }
  .post-hero-back { display: inline-block; font-family: Inter, sans-serif; font-size: 14px; color: rgba(255, 255, 255, 0.65); text-decoration: none; margin-bottom: 36px; letter-spacing: 0.02em; transition: color 0.15s ease; }
  .post-hero-back:hover { color: var(--orange); opacity: 1; }
  .post-hero-meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-family: Inter, sans-serif; font-size: 14px; color: rgba(255, 255, 255, 0.65); margin-bottom: 22px; }
  .post-hero-meta .dot { opacity: 0.4; }
  .post-title { font-family: Inter, sans-serif; font-size: clamp(34px, 5vw, 60px); color: var(--white); font-weight: 800; line-height: 1.08; letter-spacing: -0.03em; margin: 0 0 24px; max-width: 920px; }
  .post-lede { font-family: Inter, sans-serif; font-size: clamp(18px, 1.8vw, 22px); color: rgba(255, 255, 255, 0.82); line-height: 1.5; margin: 0 0 24px; max-width: 760px; font-weight: 400; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .post-tag { display: inline-block; font-family: Inter, sans-serif; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; padding: 6px 12px; border-radius: 999px; background: rgba(227, 99, 43, 0.16); color: var(--orange); border: 1px solid rgba(227, 99, 43, 0.3); }
  .post-tag-muted { background: rgba(255, 255, 255, 0.06); color: rgba(255, 255, 255, 0.7); border-color: rgba(255, 255, 255, 0.14); }
  .post-body-section { padding: 72px 32px; background: var(--white); }
  .post-body { max-width: 760px; margin: 0 auto; color: var(--ink); }
  .post-toc { margin: 0 0 36px; padding: 24px 28px; background: var(--paper); border: 1px solid var(--hairline); border-radius: 12px; }
  .post-toc-eyebrow { display: block; font-family: Inter, sans-serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: var(--orange); margin-bottom: 14px; }
  .post-toc ol { list-style: none; margin: 0; padding: 0; counter-reset: toc; }
  .post-toc li { display: flex; gap: 12px; align-items: baseline; padding: 6px 0; }
  .post-toc-num { font-family: Inter, sans-serif; font-size: 12px; font-weight: 600; color: var(--muted); flex-shrink: 0; min-width: 22px; letter-spacing: 0.05em; }
  .post-toc a { color: var(--ink); text-decoration: none; font-size: 16px; line-height: 1.5; border-bottom: 1px solid transparent; transition: color 0.15s ease, border-color 0.15s ease; }
  .post-toc a:hover { color: var(--orange); border-bottom-color: rgba(227, 99, 43, 0.4); opacity: 1; }
  .post-stats { font-family: Inter, sans-serif; font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 32px; padding-bottom: 24px; border-bottom: 1px solid var(--hairline); }
  .post-prose { font-size: 18px; line-height: 1.7; color: var(--ink); }
  .post-prose :global(h2) { font-size: clamp(28px, 3.2vw, 36px); margin-top: 56px; margin-bottom: 20px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; scroll-margin-top: 80px; }
  .post-prose :global(h3) { font-size: clamp(22px, 2.4vw, 26px); margin-top: 40px; margin-bottom: 16px; font-weight: 700; letter-spacing: -0.02em; }
  .post-prose :global(h2:first-child), .post-prose :global(h3:first-child) { margin-top: 0; }
  .post-prose :global(p) { margin-bottom: 1.2em; }
  .post-prose :global(ul), .post-prose :global(ol) { margin: 0 0 1.4em 1.6em; }
  .post-prose :global(li) { margin-bottom: 0.6em; }
  .post-prose :global(strong) { color: var(--ink); font-weight: 700; }
  .post-prose :global(em) { color: var(--green); font-style: italic; }
  .post-prose :global(a) { color: var(--orange); border-bottom: 1px solid rgba(227, 99, 43, 0.3); }
  .post-prose :global(a:hover) { opacity: 1; border-bottom-color: var(--orange); }
  .post-prose :global(blockquote) { border-left: 3px solid var(--orange); padding: 6px 0 6px 24px; margin: 28px 0; color: var(--green); font-style: italic; font-size: 19px; }
  .post-prose :global(hr) { border: none; border-top: 1px solid var(--hairline); margin: 48px 0; }
  .post-prose :global(code) { background: var(--paper); padding: 2px 6px; border-radius: 4px; font-size: 0.9em; font-family: 'SF Mono', Monaco, Menlo, Consolas, monospace; }
  .post-author-note { margin: 56px 0 0; padding-top: 32px; border-top: 1px solid var(--hairline); font-size: 16px; line-height: 1.6; color: var(--muted); }
  .post-author-note em { color: var(--muted); font-style: italic; }
  .post-related { background: var(--paper); padding: 80px 32px; }
  .post-related-h2 { font-size: clamp(28px, 3.2vw, 38px); margin-bottom: 36px; max-width: 760px; }
  .post-related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .post-related-card { display: flex; flex-direction: column; background: var(--white); border: 1px solid var(--hairline); border-radius: 14px; padding: 28px 26px; color: var(--ink); text-decoration: none; transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease; }
  .post-related-card:hover { transform: translateY(-3px); border-color: var(--green); box-shadow: 0 12px 28px rgba(24, 34, 40, 0.08); opacity: 1; }
  .post-related-meta { display: flex; gap: 8px; font-family: Inter, sans-serif; font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 14px; }
  .post-related-meta .dot { opacity: 0.5; }
  .post-related-card h3 { font-size: 20px; line-height: 1.25; margin: 0 0 12px; font-weight: 700; letter-spacing: -0.015em; color: var(--ink); }
  .post-related-card p { font-size: 15px; line-height: 1.55; color: var(--muted); margin: 0 0 18px; flex-grow: 1; }
  .post-related-cta { font-family: Inter, sans-serif; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--orange); margin-top: auto; }
  @media (max-width: 900px) {
    .post-hero { padding: 72px 24px 48px; }
    .post-body-section { padding: 56px 24px; }
    .post-prose { font-size: 17px; }
    .post-toc { padding: 20px 22px; }
    .post-related { padding: 56px 24px; }
    .post-related-grid { grid-template-columns: 1fr; }
  }
</style>
