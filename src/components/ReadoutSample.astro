---
// Sample Day 14 readout. Anonymized composite of real client findings (Russ, 2026-10-22): the type and size
// of each finding is real; the company is a composite and the figures are rounded. No single client is identifiable.
import Icon from './Icon.astro';

const revenue = 14_000_000;
const profitBefore = 360_000;
const finds = [
  { icon: 'trap-mental-accounting', trap: 'Mental Accounting', opp: 'Three accounts priced below their cost to serve', amt: 54_000, effort: 'Low', move: 'Reprice two at renewal; release the third' },
  { icon: 'trap-status-quo', trap: 'Status Quo', opp: 'Freight absorbed on small orders for three years', amt: 41_000, effort: 'Low', move: 'A minimum order size or a freight line' },
  { icon: 'trap-certainty-illusion', trap: 'Certainty Illusion', opp: 'On-time delivery bought with unpriced overtime', amt: 23_000, effort: 'Medium', move: 'A rush fee; overtime approval above 4 hours' },
];
const lift = finds.reduce((s, f) => s + f.amt, 0);
const profitAfter = profitBefore + lift;
const pct = Math.round((lift / profitBefore) * 100);
const mBefore = ((profitBefore / revenue) * 100).toFixed(1);
const mAfter = ((profitAfter / revenue) * 100).toFixed(1);
const fee = 15_000;
const multiple = (lift / fee).toFixed(1);
const k = (n: number) => `$${Math.round(n / 1000)}K`;
const usd = (n: number) => `$${n.toLocaleString('en-US')}`;

// Before and after bars; the lift is stacked on top in three segments, one per finding
const W = 560, H = 270, base = 240, top = 34;
const scale = (base - top) / profitAfter;
const bw = 120, x1 = 40, x2 = 220;
const shades = ['rs-g1', 'rs-g2', 'rs-g3'];
let acc = profitBefore;
const segs = finds.map((f, i) => { const y = base - (acc + f.amt) * scale; const h = f.amt * scale; acc += f.amt; return { ...f, y, h, cls: shades[i] }; });
const yBefore = base - profitBefore * scale, yAfter = base - profitAfter * scale;
// label positions: centred on each segment, pushed apart so they never overlap
let prev = Infinity;
const labelY = segs.map((g) => { let y = g.y + g.h / 2 + 5; if (y > prev - 22) y = prev - 22; prev = y; return y; });

// Five-year strip
const years = [1, 2, 3, 4, 5].map((y) => ({ y, v: lift * y }));
---
<div class="rs">
  <button type="button" class="rs-open" aria-haspopup="dialog">
    <div class="rs-page rs-thumb" aria-hidden="true">
      <div class="rs-head"><span class="rs-brand">Decisive</span><span class="rs-tag">Day 14 Readout &middot; Sample</span></div>
      <p class="rs-co">A {`$${revenue / 1e6}M`} distributor</p>
      <div class="rs-thumb-stats">
        <div><span class="rs-big">+{pct}%</span><span class="rs-small">net profit</span></div>
        <div><span class="rs-big rs-ink">{k(lift)}</span><span class="rs-small">a year, every year</span></div>
      </div>
      <svg viewBox={`0 0 ${W} ${H}`} class="rs-wf">
        <line x1="0" x2={W} y1={base} y2={base} class="rs-axis" />
        <rect x={x1} y={yBefore} width={bw} height={profitBefore * scale} rx="3" class="rs-base" />
        <rect x={x2} y={yBefore} width={bw} height={profitBefore * scale} rx="3" class="rs-base" />
        {segs.map((g) => <rect x={x2} y={g.y} width={bw} height={g.h} class={g.cls} />)}
        <text x={x1 + bw / 2} y={yBefore - 10} text-anchor="middle" class="rs-val rs-val-lg">{k(profitBefore)}</text>
        <text x={x2 + bw / 2} y={yAfter - 10} text-anchor="middle" class="rs-val rs-val-lg">{k(profitAfter)}</text>
        <text x={x1 + bw / 2} y={base + 24} text-anchor="middle" class="rs-lab rs-lab-lg">Profit today</text>
        <text x={x2 + bw / 2} y={base + 24} text-anchor="middle" class="rs-lab rs-lab-lg">After the fixes</text>
        <text x={x2 + bw + 20} y={yAfter + 40} class="rs-val rs-val-lg rs-pct">+{pct}%</text>
              </svg>
      <div class="rs-thumb-icons">{finds.map((f) => <span><Icon name={f.icon} size={34} /><b>{k(f.amt)}</b></span>)}</div>
    </div>
    <span class="rs-cta">See the sample readout &rarr;</span>
  </button>

  <dialog class="rs-dialog" aria-labelledby="rs-title">
    <div class="rs-page rs-full">
      <div class="rs-head"><span class="rs-brand">Decisive</span><span class="rs-tag">Day 14 Readout &middot; Sample</span></div>
      <h3 id="rs-title" class="rs-title">A {`$${revenue / 1e6}M`} distributor: {usd(lift)} a year back, and a third more profit.</h3>
      <p class="rs-lede">In a business that keeps {mBefore} cents of every dollar, {usd(lift)} is not a rounding error. It is pure profit, and it lands every year the fixes hold.</p>

      <div class="rs-stats">
        <div class="rs-stat rs-accent"><span class="rs-sv">+{pct}%</span><span class="rs-sl">net profit, {mBefore}% to {mAfter}% of revenue</span></div>
        <div class="rs-stat"><span class="rs-sv">{usd(lift)}</span><span class="rs-sl">a year in owner-accepted value</span></div>
        <div class="rs-stat"><span class="rs-sv">{multiple}x</span><span class="rs-sl">the {usd(fee)} fee</span></div>
        <div class="rs-stat"><span class="rs-sv">{k(lift * 5)}</span><span class="rs-sl">over five years, before any growth</span></div>
      </div>

      <figure class="rs-fig">
        <figcaption class="rs-figcap">Where the profit comes from</figcaption>
        <svg viewBox={`0 0 ${W} ${H + 10}`} role="img" aria-labelledby="rs-wf-t">
          <title id="rs-wf-t">{`Net profit: ${usd(profitBefore)} today; after the fixes ${usd(profitAfter)}, made up of ${finds.map((f) => `${usd(f.amt)} from ${f.trap}`).join(', ')}.`}</title>
          <line x1="0" x2={W} y1={base} y2={base} class="rs-axis" />
          <rect x={x1} y={yBefore} width={bw} height={profitBefore * scale} rx="3" class="rs-base" />
          <rect x={x2} y={yBefore} width={bw} height={profitBefore * scale} rx="3" class="rs-base" />
          {segs.map((g) => <rect x={x2} y={g.y} width={bw} height={g.h} class={g.cls} />)}
          <line x1={x1 + bw} x2={x2} y1={yBefore} y2={yBefore} class="rs-dash" />
          <text x={x1 + bw / 2} y={yBefore - 10} text-anchor="middle" class="rs-val">{k(profitBefore)}</text>
          <text x={x2 + bw / 2} y={yAfter - 10} text-anchor="middle" class="rs-val">{k(profitAfter)} &middot; +{pct}%</text>
          <text x={x1 + bw / 2} y={base + 22} text-anchor="middle" class="rs-lab">Net profit today</text>
          <text x={x2 + bw / 2} y={base + 22} text-anchor="middle" class="rs-lab">After the three fixes</text>
          {segs.map((g, i) => <text x={x2 + bw + 14} y={labelY[i]} class="rs-lab"><tspan class="rs-val">+{k(g.amt)}</tspan> {g.trap}</text>)}
        </svg>
      </figure>

      <ol class="rs-finds">
        {finds.map((f, i) => (
          <li class="rs-find">
            <Icon name={f.icon} size={48} />
            <div>
              <span class="rs-trap">{f.trap} &middot; {f.effort} effort</span>
              <p class="rs-opp">{f.opp}</p>
              <p class="rs-move"><b>Move {i + 1}:</b> {f.move}.</p>
            </div>
            <span class="rs-amt">+{usd(f.amt)}<small>a year</small></span>
          </li>
        ))}
      </ol>

      <div class="rs-long">
        <div class="rs-long-text">
          <p class="rs-figcap">Why it compounds</p>
          <p>The fixes are pricing, terms and process, so they keep paying after we leave. Five years of the same three fixes is {usd(lift * 5)}, before any growth. And every dollar of it is earnings a buyer prices if you ever sell.</p>
        </div>
        <svg viewBox="0 -6 300 146" class="rs-years" role="img" aria-label={`Cumulative: ${years.map((y) => `year ${y.y} ${k(y.v)}`).join(', ')}`}>
          {years.map((y, i) => {
            const h = (y.v / (lift * 5)) * 90;
            return (<g><rect x={i * 60 + 10} y={110 - h} width="40" height={h} rx="3" class={i === 4 ? 'rs-gain' : 'rs-base'} /><text x={i * 60 + 30} y="130" text-anchor="middle" class="rs-lab">Yr {y.y}</text><text x={i * 60 + 30} y={104 - h} text-anchor="middle" class="rs-val">{k(y.v)}</text></g>);
          })}
        </svg>
      </div>

      <p class="rs-note">Anonymized composite of real client findings. The type and size of each finding come from Diagnostics we have run; the company is a composite and the figures are rounded. A real readout adds the evidence and a recovery plan for each finding.</p>
      <form method="dialog"><button class="btn btn-primary">Close</button></form>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.rs').forEach((el) => {
    const d = el.querySelector('dialog') as HTMLDialogElement | null;
    el.querySelector('.rs-open')?.addEventListener('click', () => d?.showModal());
    d?.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });
</script>

<style>
  .rs-open { all: unset; cursor: pointer; display: block; max-width: 520px; }
  .rs-open:focus-visible { outline: 3px solid var(--orange-ink); outline-offset: 6px; border-radius: 8px; }
  .rs-page { background: #fff; color: var(--ink); border-radius: 8px; font-family: Inter, sans-serif; }
  .rs-thumb { padding: 24px 26px 22px; box-shadow: 0 24px 60px rgba(24,34,40,.22), 0 2px 6px rgba(24,34,40,.12); transform: rotate(-2deg); transition: transform .25s ease; border: 1px solid var(--hairline); border-top: 6px solid var(--orange-brand); }
  .rs-open:hover .rs-thumb, .rs-open:focus-visible .rs-thumb { transform: rotate(0) translateY(-4px); }
  .rs-head { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--ink); padding-bottom: 8px; margin-bottom: 14px; }
  .rs-brand { font-weight: 800; letter-spacing: -.02em; font-size: 16px; }
  .rs-tag { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); }
  .rs-co { font-size: 14px; font-weight: 600; color: var(--muted); margin: 0 0 8px; }
  .rs-thumb-stats { display: flex; gap: 28px; margin-bottom: 8px; }
  .rs-thumb-stats div { display: flex; flex-direction: column; }
  .rs-big { font-size: 40px; font-weight: 800; letter-spacing: -.03em; line-height: 1; color: var(--orange); }
  .rs-big.rs-ink { color: var(--ink); }
  .rs-small { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-top: 6px; }
  .rs-wf { width: 100%; height: auto; display: block; margin: 6px 0 4px; }
  .rs-axis { stroke: var(--rule, #d9d4cb); stroke-width: 1.5; }
  .rs-base { fill: var(--teal, #4a6466); }
  .rs-gain { fill: var(--orange-brand); }
  .rs-g1 { fill: #e3632b; } .rs-g2 { fill: #ec8456; } .rs-g3 { fill: #f3a885; }
  .rs-dash { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 4 4; }
  .rs-wf .rs-val-lg { font-size: 30px; } .rs-wf .rs-pct { fill: var(--orange); font-size: 44px; } .rs-wf .rs-lab-lg { font-size: 24px; }
  .rs-total { fill: var(--ink); }
  .rs-thumb-icons { display: flex; justify-content: space-between; gap: 8px; border-top: 1px solid var(--hairline); padding-top: 10px; }
  .rs-thumb-icons span { display: flex; align-items: center; gap: 8px; font-size: 14px; }
  .rs-cta { display: inline-block; margin-top: 18px; font-weight: 600; font-size: 15px; color: var(--orange); }

  .rs-dialog { margin: auto; border: none; padding: 0; background: transparent; max-width: min(940px, calc(100vw - 32px)); width: 100%; max-height: calc(100vh - 32px); overflow-y: auto; }
  .rs-dialog::backdrop { background: rgba(24,34,40,.72); }
  .rs-full { padding: 34px 38px 28px; border-top: 8px solid var(--orange-brand); }
  .rs-title { font-size: clamp(22px, 2.6vw, 30px); font-weight: 800; letter-spacing: -.025em; line-height: 1.15; margin: 4px 0 10px; }
  .rs-lede { font-size: 17px; line-height: 1.5; color: var(--muted); margin: 0 0 22px; max-width: 720px; }
  .rs-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 26px; }
  .rs-stat { border-top: 4px solid var(--teal, #4a6466); background: var(--paper); border-radius: 0 0 10px 10px; padding: 14px 14px 12px; display: flex; flex-direction: column; gap: 4px; }
  .rs-stat.rs-accent { border-top-color: var(--orange-brand); }
  .rs-sv { font-size: 28px; font-weight: 800; letter-spacing: -.03em; color: var(--orange); line-height: 1.1; }
  .rs-sl { font-size: 13px; line-height: 1.35; color: var(--ink); }
  .rs-fig { margin: 0 0 18px; }
  .rs-fig svg { width: 100%; height: auto; display: block; }
  .rs-figcap { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
  .rs-val { font-size: 14px; font-weight: 700; fill: var(--ink); }
  .rs-lab { font-size: 12px; fill: var(--muted); }
  .rs-finds { list-style: none; margin: 0 0 22px; padding: 0; border-top: 1px solid var(--hairline); }
  .rs-find { display: grid; grid-template-columns: 48px 1fr auto; gap: 16px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--hairline); }
  .rs-trap { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--orange); }
  .rs-opp { font-size: 16px; font-weight: 600; margin: 2px 0 2px; }
  .rs-move { font-size: 14px; color: var(--muted); margin: 0; }
  .rs-amt { font-size: 20px; font-weight: 800; letter-spacing: -.02em; text-align: right; white-space: nowrap; }
  .rs-amt small { display: block; font-size: 12px; font-weight: 500; color: var(--muted); letter-spacing: 0; }
  .rs-long { display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px; align-items: center; background: var(--paper); border-radius: 12px; padding: 18px 20px; }
  .rs-long p { font-size: 15px; line-height: 1.5; margin: 0; }
  .rs-long .rs-figcap { margin-bottom: 6px; }
  .rs-years { width: 100%; height: auto; }
  .rs-note { font-size: 13px; color: var(--muted); margin: 18px 0 16px; }
  @media (max-width: 700px) {
    .rs-full { padding: 22px 16px; }
    .rs-stats { grid-template-columns: 1fr 1fr; }
    .rs-long { grid-template-columns: 1fr; }
    .rs-find { grid-template-columns: 40px 1fr; }
    .rs-amt { grid-column: 2; text-align: left; }
    .rs-thumb { padding: 18px 16px; }
    .rs-big { font-size: 32px; }
  }
  @media (prefers-reduced-motion: reduce) { .rs-thumb { transition: none; } }
</style>
