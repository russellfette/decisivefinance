---
interface Props {
  kind: 'stalled' | 'method' | 'field-guide' | 'ledger' | 'scale' | 'shield' | 'clock' | 'industry';
  size?: number;
}
const { kind, size = 24 } = Astro.props;
---

{kind === 'ledger' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="4" y="3" width="16" height="18" rx="2" />
    <path d="M8 8 L13 8" />
    <path d="M8 12 L13 12" />
    <path d="M8 16 L11 16" />
    <path d="M15.5 15.5 L17 17 L19.5 13.5" />
  </svg>
)}

{kind === 'scale' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3 L12 21" />
    <path d="M6 21 L18 21" />
    <path d="M5 7 L19 7" />
    <path d="M12 4.5 A1.5 1.5 0 1 0 12 4.51" />
    <path d="M5 7 L2.5 13 L7.5 13 Z" />
    <path d="M19 7 L16.5 13 L21.5 13 Z" />
  </svg>
)}

{kind === 'shield' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3 L20 6 V11 C20 16 16.5 19.5 12 21 C7.5 19.5 4 16 4 11 V6 Z" />
    <path d="M8.5 12 L11 14.5 L15.5 9.5" />
  </svg>
)}

{kind === 'clock' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="13" r="8" />
    <path d="M12 13 L12 8.5" />
    <path d="M12 13 L15 15" />
    <path d="M9 3 L15 3" />
  </svg>
)}

{kind === 'industry' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 21 L3 10 L9 13 L9 10 L15 13 L15 5 L21 5 L21 21 Z" />
    <path d="M6 21 L6 17" />
    <path d="M12 21 L12 17" />
    <path d="M18 21 L18 17" />
  </svg>
)}

{kind === 'stalled' && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M2 12 L7 12 L9 6 L11 18 L13 12 L22 12" />
  </svg>
)}

{kind === 'method' && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="5" cy="12" r="1.5" />
    <path d="M6.5 12 L18 5" />
    <path d="M6.5 12 L19 12" />
    <path d="M6.5 12 L18 19" />
    <path d="M15 5 L18 5 L18 8" />
    <path d="M16 12 L19 12" />
    <path d="M15 19 L18 19 L18 16" />
  </svg>
)}

{kind === 'field-guide' && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="9" />
    <path d="M12 4 L12 8" />
    <path d="M12 16 L12 20" />
    <path d="M4 12 L8 12" />
    <path d="M16 12 L20 12" />
    <path d="M9 9 L15 15" stroke-dasharray="2 2" />
    <path d="M15 9 L9 15" stroke-dasharray="2 2" />
  </svg>
)}
