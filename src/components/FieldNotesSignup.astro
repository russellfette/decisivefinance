---
// Monthly Field Notes signup. Posts straight to the Kit form "Newsletter signup" (id 9406616), no third-party script.
// Wording pending Russ's approval: OA inbox entry 18.
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
const KIT_FORM_ID = '9406616';
---
<section class={`fn-signup ${dark ? 'fn-signup-dark' : ''}`} aria-labelledby="fn-signup-h">
  <div class="fn-inner">
    <div class="fn-copy">
      <span class="fn-eyebrow">Field Notes</span>
      <h2 id="fn-signup-h" class="fn-h">The month's writing, in one email.</h2>
      <p class="fn-sub">Once a month: the new pieces on where the profit goes and what a buyer checks. Unsubscribe in one click.</p>
    </div>
    <form class="fn-form" action={`https://app.kit.com/forms/${KIT_FORM_ID}/subscriptions`} method="post">
      <label for="fn-email" class="fn-label">Work email</label>
      <div class="fn-row">
        <input id="fn-email" name="email_address" type="email" autocomplete="email" required class="fn-input" />
        <button type="submit" class="btn btn-primary fn-btn">Send me Field Notes</button>
      </div>
      <p class="fn-fine">We use your email only to send Field Notes. <a href="/privacy">Privacy policy</a>.</p>
    </form>
  </div>
</section>

<style>
  .fn-signup { background: var(--paper); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); padding: 64px 32px; }
  .fn-inner { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: end; }
  .fn-eyebrow { display: block; font-family: Inter, sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--orange); margin-bottom: 12px; }
  .fn-h { font-size: clamp(26px, 3vw, 36px); margin: 0 0 12px; max-width: none; }
  .fn-sub { font-size: 17px; line-height: 1.55; color: var(--muted); margin: 0; max-width: 560px; }
  .fn-label { display: block; font-family: Inter, sans-serif; font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 8px; }
  .fn-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .fn-input { flex: 1 1 220px; min-width: 0; font: inherit; font-size: 16px; padding: 12px 16px; border: 1.5px solid var(--ink); border-radius: 999px; background: var(--white); color: var(--ink); }
  .fn-input:focus-visible { outline: 3px solid var(--orange-ink); outline-offset: 2px; }
  .fn-btn { flex: 0 0 auto; }
  .fn-fine { font-size: 13px; color: var(--muted); margin: 10px 0 0; }
  .fn-fine a { color: var(--ink); text-decoration: underline; }
  .fn-signup-dark { background: var(--ink); border: none; --orange: var(--orange-on-dark); }
  .fn-signup-dark .fn-h, .fn-signup-dark .fn-label { color: var(--white); }
  .fn-signup-dark .fn-sub, .fn-signup-dark .fn-fine { color: rgba(255,255,255,0.78); }
  .fn-signup-dark .fn-fine a { color: var(--white); }
  @media (max-width: 860px) {
    .fn-signup { padding: 48px 16px; }
    .fn-inner { grid-template-columns: 1fr; gap: 24px; }
    .fn-btn { width: 100%; }
  }
</style>
