---
// Decisive icon set (17 marks, 64 px grid). Decorative: always paired with a visible label.
interface Props { name: string; size?: number; class?: string }
const { name, size = 48, class: cls = '' } = Astro.props;
const files = import.meta.glob('../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true });
const svg = files[`../assets/icons/${name}.svg`] as string | undefined;
if (!svg) throw new Error(`Icon not found: ${name}`);
---
<span class={`df-icon ${cls}`} style={`width:${size}px;height:${size}px`} set:html={svg} />
<style>
  .df-icon { display: inline-block; line-height: 0; flex-shrink: 0; }
  .df-icon :global(svg) { width: 100%; height: 100%; font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif; }
</style>
