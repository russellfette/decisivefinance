---
// The five numbers. Source: site-visuals-handoff-2026-10-17/charts/metrics-strip.svg. Figures are illustrative, from the chart build scripts.
import Icon from './Icon.astro';
const metrics = [
  { icon: 'metric-losing-revenue-share', name: 'Losing-revenue share', value: '22%', body: 'of revenue comes from customers who lose money', accent: true },
  { icon: 'metric-decision-drift', name: 'Decision drift', value: '$1.71M', body: 'a year on decisions nobody has re-made in 12 months' },
  { icon: 'metric-days-to-cash', name: 'Days to cash', value: '58', body: 'days from finished work to money in the bank' },
  { icon: 'metric-forecast-hit-rate', name: 'Forecast hit rate', value: '11 of 13', body: 'weeks cash landed within 5% of the forecast' },
  { icon: 'metric-believability-gap', name: 'Believability gap', value: '$0.75M', body: 'of EBITDA a buyer won’t believe', accent: true },
];
---
<div class="mstrip">
  <span class="section-eyebrow">The five numbers</span>
  <h2>Five numbers your books don&rsquo;t show you.</h2>
  <p class="lede">Four come out of the 14-day Find. The fifth proves the rhythm is running.</p>
  <ol class="mstrip-grid">
    {metrics.map((m, i) => (
      <li class={`mstrip-card ${m.accent ? 'mstrip-accent' : ''}`}>
        <Icon name={m.icon} size={56} />
        <span class="mstrip-num">{String(i + 1).padStart(2, '0')}</span>
        <span class="mstrip-name">{m.name}</span>
        <span class="mstrip-value">{m.value}</span>
        <span class="mstrip-body">{m.body}</span>
      </li>
    ))}
  </ol>
  <p class="mstrip-caption">Illustrative figures. Not client data.</p>
</div>
<style>
  .mstrip-grid { list-style: none; padding: 0; margin: 36px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
  @media (max-width: 1100px) { .mstrip-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .mstrip-grid { grid-template-columns: 1fr; } }
  .mstrip-card { background: var(--white); border-top: 4px solid var(--teal); border-radius: 0 0 14px 14px; padding: 26px 22px; display: flex; flex-direction: column; gap: 8px; }
  .mstrip-accent { border-top-color: var(--orange-brand); }
  .mstrip-num { margin-top: 14px; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; color: var(--muted); }
  .mstrip-name { font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink); }
  .mstrip-value { font-family: Inter, sans-serif; font-size: 40px; font-weight: 800; letter-spacing: -0.03em; color: var(--orange); line-height: 1.1; }
  .mstrip-body { font-size: 15px; line-height: 1.45; color: var(--ink); }
  .mstrip-caption { margin-top: 14px; font-size: 13px; color: var(--muted); text-align: right; }
</style>
