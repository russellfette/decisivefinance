---
// CTA block per DEC-1 item 7a. Headings and body are canon (X-Ray Worth Variant v1.5 head; Phrase Book 3h);
// button label approved dec_mwtsnrrx_96cc17eb; second link canon (Phrase Book 3i fit-call microcopy).
interface Props { variant?: 'deal' | 'operating' }
const { variant = 'deal' } = Astro.props;
const READ = 'https://read.decisive.finance';
const CALENDLY = 'https://calendly.com/russell-decisive/30min';
---
<div class="mt-cta">
  {variant === 'operating' ? (
    <>
      <h2 class="mt-cta-head">Send three reports.</h2>
      <p class="mt-cta-sub">In 48 hours, see where the profit is leaking, in dollars.</p>
    </>
  ) : (
    <h2 class="mt-cta-head">Send three reports. In 48 hours, see your company the way a buyer will.</h2>
  )}
  <p class="mt-cta-body">Send three reports as they are today. No cleanup. In 48 hours you get one page back: the two or three biggest places money is leaking, a dollar figure on each, and whether your numbers would hold up if a buyer looked today. Then Russell spends an hour with you confirming each figure.</p>
  <div class="mt-cta-row">
    <a class="btn btn-primary" href={READ}>Send three reports</a>
    <a class="mt-cta-second" href={CALENDLY}>30 min with Russ. Two questions, a number, and whether we&rsquo;re a fit.</a>
  </div>
</div>
