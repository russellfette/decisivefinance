---
const year = new Date().getFullYear();
const LINKEDIN = 'https://linkedin.com/in/russellfette';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" aria-label="Decisive Finance home">
        <img src="/brand/wordmark-dark.svg" alt="Decisive" class="footer-wordmark" width="160" height="46" />
      </a>
      <p class="muted">
        Based in the Pacific Northwest, working with post-Series A and Series B tech companies nationwide.
      </p>
    </div>

    <div class="footer-meta">
      <div class="footer-contact">
        <a href="mailto:contact@decisive.finance">contact@decisive.finance</a>
        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
      <ul class="footer-legal">
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-copy">
    © {year} Decisive Finance.
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.75);
    padding: 56px 32px 36px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 56px;
    align-items: start;
  }
  .footer-wordmark {
    display: block;
    height: 32px;
    width: auto;
    margin-bottom: 18px;
    opacity: 0.95;
  }
  .footer-brand .muted {
    color: rgba(255, 255, 255, 0.55);
    font-size: 14px;
    line-height: 1.5;
    max-width: 380px;
    margin: 0;
  }
  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-end;
  }
  .footer-contact {
    display: flex;
    gap: 18px;
    font-size: 14px;
  }
  .footer-contact a {
    color: rgba(255, 255, 255, 0.85);
  }
  .footer-contact a:hover {
    color: var(--orange);
    opacity: 1;
  }
  .footer-legal {
    display: flex;
    gap: 18px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 13px;
  }
  .footer-legal a {
    color: rgba(255, 255, 255, 0.55);
  }
  .footer-legal a:hover {
    color: var(--orange);
    opacity: 1;
  }
  .footer-copy {
    max-width: 1180px;
    margin: 36px auto 0;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
  }
  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .footer-meta {
      align-items: flex-start;
    }
  }
</style>
