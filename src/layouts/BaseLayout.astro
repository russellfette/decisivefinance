---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og/default.svg',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const siteUrl = 'https://decisive.finance';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = ogImage.startsWith('http') ? ogImage : siteUrl + ogImage;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Decisive Finance',
  url: siteUrl,
  logo: siteUrl + '/logo.png',
  image: siteUrl + '/og/default.png',
  description:
    'Decision-First Finance for stalled Series A/B tech. Diagnostics surface $22,500 to $30,000 of forward-reallocation potential in 14 days.',
  address: { '@type': 'PostalAddress', addressCountry: 'US' },
  email: 'contact@decisive.finance',
  areaServed: { '@type': 'Country', name: 'United States' },
  serviceType: [
    'Decision Diagnostic',
    '90-Day Decision Resolution',
    'Decision Partnership',
  ],
  priceRange: '$7,500 to $36,000',
  knowsAbout: [
    'Venture-backed SaaS financial strategy',
    'Decision-first finance',
    'Forward-reallocation potential',
    'Board-ready scenario forecasting',
    'Unit economics for stalled post-Series A companies',
    'Fractional CFO services',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content="Decisive Finance" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Decisive Finance" href="/blog/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

    <slot name="head" />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
